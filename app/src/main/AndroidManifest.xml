<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.kgmedia.fastfilm"
    tools:ignore="LockedOrientationActivity">

    <uses-permission
        android:name="android.permission.CALL_PHONE"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware"
        tools:node="remove" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!--    <uses-permission android:name="android.permission.RECORD_AUDIO" />-->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--    <uses-permission android:name="android.permission.GET_TASKS" /> &lt;!&ndash; 如果有视频相关的广告且使用textureView播放，请务必添加，否则黑屏 &ndash;&gt;-->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- // 在应用的AndroidManifest.xml添加如下标签  // 指定微信包名  兼容android11 -->
    <!-- -->
    <uses-permission android:name="android.permission.GET_INSTALLED_APPS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />


    <application
        android:name="com.kgmedia.fastfilm.App"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:replace="android:label,android:allowBackup">
        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" /> <!-- 适配全面屏手机 -->
        <meta-data
            android:name="android.max_aspect"
            android:value="2.4" />
        <meta-data
            android:name="android.notch_support"
            android:value="true" />
        <meta-data
            android:name="notch.config"
            android:value="portrait|landscape" />
        <!-- wxpay sdk begin -->
        <activity
            android:name=".wxapi.WXPayEntryActivity"
            android:exported="true"
            android:screenOrientation="behind"
            android:theme="@style/WXPayActivityThem">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="wx1c98457e17ef2524" />
            </intent-filter>
        </activity>
        <!-- wxpay sdk end -->
        <!-- openInstall -->
        <meta-data
            android:name="com.openinstall.APP_KEY"
            android:value="${OPENINSTALL_APP_KEY}" /> <!-- openInstall -->
        <!-- 友盟相关 -->
        <meta-data
            android:name="UMENG_APPKEY"
            android:value="${UMENG_APP_KEY}" />

        <activity
            android:name=".wxapi.WXEntryActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name=".douyinapi.DouYinEntryActivity"
            android:exported="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true"
            tools:replace="android:authorities">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths"
                tools:replace="android:resource" />
        </provider>
        <activity
            android:name="com.nhsd.crop.CropActivity"
            android:screenOrientation="portrait" />

        <service android:name="com.kgmedia.fastfilm.service.DownloadService" />

        <receiver
            android:name="androidx.media.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <activity
            android:name="com.kgmedia.fastfilm.feature.splash.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/SplashScreen"
            android:windowSoftInputMode="stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="um.${UMENG_APP_KEY}" />
                <data android:scheme="goldenfruit" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="growing.${GROWING_URL_SCHEME}" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.kgmedia.fastfilm.feature.PhotoPagerActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.PhotoPager" />
        <activity
            android:name="com.kgmedia.fastfilm.feature.web.SimpleBrowserActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.kgmedia.fastfilm.feature.BringForegroundActivity"
            android:screenOrientation="portrait" />

        <!--主页-->
        <activity
            android:name="com.kgmedia.fastfilm.feature.main.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateAlwaysHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="${OPENINSTALL_SCHEME}" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="com.openinstall.AD_TRACK"
            android:value="true" />
        <!--设置-->
        <activity
            android:name=".feature.settings.SettingsActivity"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <!--关于我们-->
        <activity
            android:name=".feature.settings.about.AboutUsActivity"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <!--建议-->
        <activity
            android:name=".feature.settings.feedback.FeedbackActivity"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <!--举报-->
        <activity
            android:name=".feature.settings.report.ReportActivity"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <!--注销-->
        <activity android:name=".feature.settings.logoff.LogoffActivity" />
        <!--申请注销-->
        <activity android:name=".feature.settings.logoff.ApplyLogOffActivity" />
        <!--个人资料-->
        <activity
            android:name=".feature.settings.personal.PersonalInformationActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <!--会员权益-->
        <activity
            android:name=".feature.payment.vip.MembershipBenefitsActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <!--绑定手机号-->
        <activity
            android:name=".feature.login.bind.BindPhoneActivity"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <!--手机号登录-->
        <activity
            android:name=".feature.login.flash.PhoneLoginDialogActivity"
            android:windowSoftInputMode="stateVisible" />
        <!--手机号登录-->
        <activity
            android:name=".feature.login.LoginDialog"
            android:screenOrientation="behind"
            android:windowSoftInputMode="stateAlwaysHidden" />
<!--          android:theme="@style/Theme.ActivityBottomDialogStyle"-->
        <!--积分充值-->
        <activity
            android:name=".feature.payment.points.PointsRechargeActivity"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <!--积分明细-->
        <activity
            android:name=".feature.payment.points.details.PointsDetailActivity"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <!--邀请明细-->
        <activity
            android:name=".feature.invitation.InvitationDetailsActivity"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <!--提现明细-->
        <activity
            android:name=".feature.wallet.details.WithdrawalDetailsActivity"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <!--创造收益-->
        <activity
            android:name=".feature.revenue.CreateRevenueActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <!--闪验-->
        <!-- *******************************授权页*********************************** -->
        <activity
            android:name="com.chuanglan.shanyan_sdk.view.ShanYanOneKeyActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:launchMode="singleTop"
            android:screenOrientation="behind"
            android:theme="@style/Theme.ActivityBottomDialogStyle"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <!-- *******************************协议页*********************************** -->
        <activity
            android:name="com.chuanglan.shanyan_sdk.view.CTCCPrivacyProtocolActivity"
            android:configChanges="keyboardHidden|orientation|screenSize"
            android:launchMode="singleTop"
            android:screenOrientation="behind"
            android:windowSoftInputMode="stateAlwaysHidden" />
        <!--闪验 end-->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true"
            tools:replace="android:authorities">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths"
                tools:replace="android:resource" />
        </provider> <!-- 友盟厂商推送相关内容 -->
        <activity
            android:name=".feature.push.MfrMessageActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="${applicationId}"
                    android:path="/thirdpush"
                    android:scheme="agoo" />
            </intent-filter>
        </activity>
        <!-- 为了使用 "通用跳转 SDK" 的能力，需要在您的 App 的 AndroidManifest.xml 中添加这一项 -->
        <!-- 并合理设置 android:scheme 的值 -->
        <activity
            android:name="com.alipay.sdk.app.AlipayResultActivity"
            android:exported="true"
            tools:node="merge">
            <intent-filter tools:node="replace">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="__kuaige__" />
            </intent-filter>
        </activity>
        <activity android:name=".feature.timbre.TimbreExtractionActivity" />
        <activity android:name=".feature.timbre.MyTimbresActivity" />
        <activity android:name=".feature.creator.generate.StoryEditorActivity" />
        <activity
            android:name=".feature.editor.ShortDramaEditorActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".feature.mine.PhoneShowActivity" />
        <activity
            android:name=".feature.wallet.withdraw.WithdrawActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".feature.message.systemnotice.SystemNoticeActivity" />
        <activity android:name=".feature.creator.CreationRootActivity" />
        <activity android:name=".feature.series.SeriesActivity" />
        <activity android:name=".feature.series.editinfo.EditInfoActivity" />
        <activity android:name=".feature.creator.continuewriting.ContinueWritingActivity" />
        <activity android:name=".feature.message.likes.SystemMessageLikesActivity" />
        <activity android:name=".feature.message.watching.SystemMessageWatchingActivity" />
        <activity
            android:name=".feature.creator.character.CharacterHistoryActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".feature.play.DramasPlayPagerActivity" android:screenOrientation="portrait" />
        <activity android:name=".feature.editor.info.DramaInfoEditActivity" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>
</manifest>