<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底部阴影层（很薄，仅向下延伸 3dp） -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#F9F9F9" />   <!-- 轻微半透明黑 -->
            <corners android:radius="16dp" />
        </shape>
    </item>

    <item
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#E6F7FF"
                android:startColor="#ffFFFF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>