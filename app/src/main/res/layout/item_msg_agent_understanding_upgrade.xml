<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_understanding_upgrade_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_msg_agent_left"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_bubble_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 对齐度气泡 + 文案 -->
        <FrameLayout
            android:id="@+id/fl_align_bubble"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.shiyuan.fastclaw.widget.progress.WaveProgressView
                android:id="@+id/wpv_align_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:wpv_progress="60"
                app:wpv_text="60%"
                app:wpv_textColor="@color/color_90_000000"
                app:wpv_textSize="14sp"
                app:wpv_waveAmplitude="8dp"
                app:wpv_waveBackgroundColor="#D9FBFE"
                app:wpv_waveColor="#54DAF0"
                app:wpv_waveCount="1" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ic_pr_bg" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_align_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:includeFontPadding="false"
            android:textColor="@color/color_90_000000"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            app:layout_constraintBottom_toTopOf="@id/tv_align_subtitle"
            app:layout_constraintEnd_toStartOf="@id/iv_arrow"
            app:layout_constraintStart_toEndOf="@id/fl_align_bubble"
            app:layout_constraintTop_toTopOf="@id/fl_align_bubble"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="理解升级！" />

        <TextView
            android:id="@+id/tv_align_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:includeFontPadding="false"
            android:textColor="@color/color_75_3c3c43"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@id/fl_align_bubble"
            app:layout_constraintEnd_toStartOf="@id/iv_arrow"
            app:layout_constraintStart_toStartOf="@id/tv_align_title"
            app:layout_constraintTop_toBottomOf="@id/tv_align_title"
            tools:text="对你的理解飙升，对齐度到达85%" />

        <ImageView
            android:id="@+id/iv_arrow"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/icon_agent_into2"
            app:layout_constraintBottom_toBottomOf="@id/fl_align_bubble"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/fl_align_bubble" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 内嵌白卡：理解明细（行数不固定） -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_understanding_detail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_f5f6fa_r12"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_bubble_layout">

        <TextView
            android:id="@+id/tv_detail_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/str_agent_understanding_section_title"
            android:textColor="@color/color_90_000000"
            android:textSize="14sp"
            android:paddingEnd="20dp"
            android:lines="1"
            android:ellipsize="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/tv_detail_edit"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/icon_agent_edit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_detail_title"
            app:layout_constraintBottom_toBottomOf="@+id/tv_detail_title"
            />

        <!-- 行列表：通过代码 addView + flow.referencedIds 绑定动态行 -->
        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/flow_detail_rows"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            app:flow_verticalGap="16dp"
            app:flow_verticalStyle="packed"
            app:flow_wrapMode="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_detail_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
