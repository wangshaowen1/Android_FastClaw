<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_understanding_upgrade_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_msg_agent_left"
    android:paddingHorizontal="16dp"
    android:paddingVertical="20dp">

    <!-- 顶部：理解升级标题 -->
    <ImageView
        android:id="@+id/iv_upgrade_check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_tick_green_filled"
        app:layout_constraintBottom_toBottomOf="@id/tv_upgrade_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_upgrade_title" />

    <TextView
        android:id="@+id/tv_upgrade_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/str_agent_understanding_upgrade_title"
        android:textColor="@color/color_90_000000"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_upgrade_check"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/v_upgrade_divider"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="16dp"
        android:background="@color/color_10_000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_upgrade_title" />

    <!-- 对齐度气泡 + 文案 -->
    <FrameLayout
        android:id="@+id/fl_align_bubble"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_upgrade_divider">

        <com.shiyuan.fastclaw.widget.progress.WaveProgressView
            android:id="@+id/wpv_align_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:wpv_progress="60"
            app:wpv_text="60%"
            app:wpv_textColor="@color/color_90_000000"
            app:wpv_textSize="14sp"
            app:wpv_waveAmplitude="8dp"
            app:wpv_waveBackgroundColor="#D9FBFE"
            app:wpv_waveColor="#54DAF0"
            app:wpv_waveCount="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/ic_pr_bg" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_align_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textColor="@color/color_90_000000"
        android:textSize="15sp"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/fl_align_bubble"
        app:layout_constraintTop_toTopOf="@id/fl_align_bubble"
        app:layout_constraintBottom_toTopOf="@id/tv_align_subtitle"
        tools:text="我与你对齐度达到85%！" />

    <TextView
        android:id="@+id/tv_align_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/str_agent_understanding_align_subtitle"
        android:textColor="@color/color_56_3c3c43"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/fl_align_bubble"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/tv_align_title"
        app:layout_constraintTop_toBottomOf="@id/tv_align_title" />

    <!-- 内嵌白卡：理解明细（行数不固定） -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_understanding_detail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_ffffff_r12"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fl_align_bubble">

        <TextView
            android:id="@+id/tv_detail_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/str_agent_understanding_section_title"
            android:textColor="@color/color_90_000000"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 行列表：通过代码 addView + flow.referencedIds 绑定动态行 -->
        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/flow_detail_rows"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            app:flow_verticalGap="12dp"
            app:flow_verticalStyle="packed"
            app:flow_wrapMode="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_detail_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 底部白色 banner -->
    <TextView
        android:id="@+id/tv_bottom_tip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_ffffff_r12"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        android:text="@string/str_agent_understanding_bottom_tip"
        android:textColor="@color/color_90_000000"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_understanding_detail" />

</androidx.constraintlayout.widget.ConstraintLayout>
