<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.shiyuan.fastclaw.feature.opportunity.ItemProcessedOpportunityVM" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingHorizontal="14dp"
        android:paddingVertical="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ffffff_r27">

        <TextView
            android:id="@+id/tv_opportunity_title"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_s"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@{item.data.jobTitle}"
            android:textColor="@color/color_90_000000"
            app:layout_constraintEnd_toStartOf="@id/fl_match_percent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="高后端工程师" />

        <TextView
            android:id="@+id/tv_opportunity_company"
            android:textSize="13sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@{item.data.companyName}"
            android:textColor="@color/color_85_3c3c43"
            app:layout_constraintEnd_toEndOf="@id/tv_opportunity_title"
            app:layout_constraintStart_toStartOf="@id/tv_opportunity_title"
            app:layout_constraintTop_toBottomOf="@id/tv_opportunity_title"
            tools:text="selleck上海新香微电子股份有" />

        <com.shiyuan.fastclaw.widget.progress.MatchPercentProgressView
            android:id="@+id/fl_match_percent"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="8.5dp"
            android:layout_marginEnd="8dp"
            app:progress="@{item.data.matchPercent}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_opportunity_requirements"
           android:textSize="12sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@{item.requirements}"
            android:textColor="@color/color_85_3c3c43"
            app:layout_constraintEnd_toStartOf="@id/tv_opportunity_salary"
            app:layout_constraintStart_toStartOf="@id/tv_opportunity_title"
            app:layout_constraintTop_toBottomOf="@id/tv_opportunity_company"
            tools:text="深圳·3年以上·本科" />

        <TextView
            android:id="@+id/tv_opportunity_salary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:includeFontPadding="false"
            android:text="@{item.data.salaryText}"
            android:textColor="@color/color_2f6bff"
            android:textSize="15sp"
            app:layout_constraintBaseline_toBaselineOf="@id/tv_opportunity_requirements"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_opportunity_requirements"
            tools:text="13-30K·15薪" />

        <View
            android:id="@+id/v_divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:background="@color/color_e9f0fe"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_opportunity_requirements" />

        <TextView
            android:textSize="12sp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@{item.actionTime}"
            android:textColor="@color/color_55_3c3c43"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/v_divider"
            tools:text="8月5日16:45你发起立即沟通" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
