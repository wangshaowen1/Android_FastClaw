<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kgmedia.fastfilm.feature.timbre.ItemSongMenuVm" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center"
        android:layout_marginBottom="12dp"
        singleClick="@{(v)->item.onItemClick.invoke(v)}"
        android:orientation="vertical"
        tools:ignore="UseCompoundDrawables">

        <ImageView
            imageResource="@{item.data.icon}"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_share_songs" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_height="wrap_content"
            android:textColor="@color/color_121212"
            android:textSize="12sp"
            android:text="@{item.data.title}"
            tools:text="分享歌曲" />
    </LinearLayout>
</layout>