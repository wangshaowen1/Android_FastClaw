<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_searching_jobs_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_msg_agent_left"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/tv_searching_jobs_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/str_agent_searching_jobs_title"
        android:textColor="@color/color_90_000000"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/v_searching_jobs_divider"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="16dp"
        android:background="@color/color_10_000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_searching_jobs_title" />

    <ImageView
        android:id="@+id/iv_searching_jobs_icon"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginTop="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_agent_searching_shrimp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_searching_jobs_divider" />

    <ImageView
        app:layout_constraintTop_toTopOf="@id/iv_searching_jobs_icon"
        app:layout_constraintStart_toStartOf="@id/iv_searching_jobs_icon"
        android:layout_marginTop="9dp"
        android:layout_marginStart="11dp"
        android:scaleType="fitXY"
        android:src="@drawable/ic_agent_searching_search"
        android:layout_width="40dp"
        android:layout_height="40dp"/>
    
    <TextView
        android:id="@+id/tv_searching_jobs_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/str_agent_searching_jobs_desc"
        android:textColor="@color/color_90_000000"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="@id/iv_searching_jobs_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_searching_jobs_icon"
        app:layout_constraintTop_toTopOf="@id/iv_searching_jobs_icon" />

</androidx.constraintlayout.widget.ConstraintLayout>