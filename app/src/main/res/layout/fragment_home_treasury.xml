<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.report.report.HomeReportViewModel" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_E9F0FE"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="106dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="158dp">

                <com.shiyuan.fastclaw.widget.StatusBarView
                    android:id="@+id/sbv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:layout_width="330dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="27dp"
                    android:layout_marginTop="53dp"
                    android:alpha="0.03"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text="treasure"
                    android:textAllCaps="true"
                    android:textColor="#3F60AF"
                    android:textSize="60sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="285dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="188dp"
                    android:layout_marginTop="121dp"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text="treasure"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="50sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="31dp"
                    android:layout_marginTop="61dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/img_home_treasury_star_small" />

                <ImageView
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_marginStart="192dp"
                    android:layout_marginTop="88dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/img_home_treasury_star_small" />

                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="90dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="65dp"
                    android:layout_marginEnd="31dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_home_treasury_hero" />

                <View
                    android:layout_width="136dp"
                    android:layout_height="13dp"
                    android:layout_marginStart="26dp"
                    android:layout_marginTop="113dp"
                    android:background="@drawable/bg_home_treasury_title_line" />

                <ImageView
                    android:layout_width="146dp"
                    android:layout_height="41dp"
                    android:layout_marginStart="23dp"
                    android:layout_marginTop="86dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_home_treasury_title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="23dp"
                    android:layout_marginTop="135dp"
                    android:includeFontPadding="false"
                    android:text="@string/home_treasury_slogan"
                    android:textColor="@color/color_96_000000"
                    android:textSize="12sp" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/card_company"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="match_parent"
                android:layout_height="154dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="@dimen/spacing_m"
                android:background="@drawable/bg_home_treasury_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_m"
                android:paddingVertical="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="53dp"
                        android:layout_height="53dp"
                        android:background="@drawable/bg_home_treasury_blue_icon">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="30dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_home_treasury_company" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/company_background_check"
                            android:textColor="@color/color_96_000000"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:lineSpacingExtra="1dp"
                            android:maxLines="2"
                            android:text="@string/home_treasury_company_desc"
                            android:textColor="@color/color_90_000000"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="@drawable/bg_home_treasury_divider_dash" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/home_treasury_daily_free"
                        android:textColor="@color/color_8C3C3C43"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/ll_company_action"
                        singleClick="@{layout.clickHandler::onClick}"
                        android:layout_width="102dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_home_treasury_blue_btn"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/home_treasury_use_now"
                            android:textColor="@color/color_2f6bff"
                            android:textSize="15sp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_home_treasury_arrow_blue" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/card_interview"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="match_parent"
                android:layout_height="154dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="@dimen/spacing_m"
                android:background="@drawable/bg_home_treasury_card"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_m"
                android:paddingVertical="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="53dp"
                        android:layout_height="53dp"
                        android:background="@drawable/bg_home_treasury_green_icon">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="31dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_home_treasury_interview" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/home_treasury_mock_interview"
                            android:textColor="@color/color_96_000000"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:lineSpacingExtra="1dp"
                            android:maxLines="2"
                            android:text="@string/home_treasury_mock_desc"
                            android:textColor="@color/color_90_000000"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="@drawable/bg_home_treasury_divider_dash" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="40"
                            android:textColor="@color/color_2f6bff"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_treasury_shrimp_chip"
                            android:textColor="@color/color_8C3C3C43"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_interview_action"
                        singleClick="@{layout.clickHandler::onClick}"
                        android:layout_width="102dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_home_treasury_green_btn"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="@string/home_treasury_use_now"
                            android:textColor="@color/color_1cc083"
                            android:textSize="15sp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_home_treasury_arrow_green" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:layout_marginStart="23dp"
                android:layout_marginTop="20dp">

                <View
                    android:layout_width="50dp"
                    android:layout_height="9dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/bg_home_treasury_title_line" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_treasury_more_tools"
                    android:textColor="@color/color_90_000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="93dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="11dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/ll_resume_check_tool"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_treasury_tool_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/home_treasury_no_reply"
                        android:textColor="@color/color_90_000000"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="105dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="37dp"
                            android:layout_height="36dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_home_treasury_resume_check" />

                        <LinearLayout
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/home_treasury_resume_check"
                                android:textColor="@color/color_90_000000"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/home_treasury_free"
                                android:textColor="@color/color_75_3c3c43"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="13dp"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:id="@+id/ll_salary_tool"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_treasury_tool_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_m">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/home_treasury_underestimated"
                        android:textColor="@color/color_90_000000"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="105dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="38dp"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_home_treasury_salary" />

                        <LinearLayout
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/home_treasury_salary_check"
                                android:textColor="@color/color_90_000000"
                                android:textSize="14sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="@string/home_treasury_free"
                                android:textColor="@color/color_75_3c3c43"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
