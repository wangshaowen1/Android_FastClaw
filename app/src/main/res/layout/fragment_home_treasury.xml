<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.report.report.HomeReportViewModel" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_E9F0FE"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="76dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="160dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_home_treasury_top_bg" />


                <ImageView
                    android:id="@+id/iv_xx"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_marginStart="31dp"
                    android:layout_marginTop="61dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/img_home_treasury_star_small" />


                <ImageView
                    android:id="@+id/iv_qz"
                    android:layout_width="146dp"
                    android:layout_height="41dp"
                    android:layout_below="@id/iv_xx"
                    android:layout_marginStart="23dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_home_treasury_title" />

                <ImageView
                    android:layout_width="136dp"
                    android:layout_height="13dp"
                    android:layout_alignBottom="@id/iv_qz"
                    android:layout_marginStart="26dp"
                    android:src="@drawable/img_home_treasury_bottom" />


                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_alignTop="@id/iv_bd"
                    android:layout_marginTop="34dp"
                    android:layout_marginRight="7dp"
                    android:layout_toLeftOf="@id/iv_bd"
                    android:importantForAccessibility="no"
                    android:src="@drawable/img_home_treasury_star_small" />


                <ImageView
                    android:id="@+id/iv_bd"
                    android:layout_width="110dp"
                    android:layout_height="90dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentBottom="true"
                    android:layout_marginEnd="31dp"
                    android:layout_marginBottom="3dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_home_treasury_hero" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/iv_qz"
                    android:layout_marginStart="23dp"
                    android:layout_marginTop="9dp"
                    android:includeFontPadding="false"
                    android:text="@string/home_treasury_slogan"
                    android:textColor="@color/color_96_000000"
                    android:textSize="12sp" />


            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_treasury_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
