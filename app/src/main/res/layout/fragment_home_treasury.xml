<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.report.report.HomeReportViewModel" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_E9F0FE"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="76dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="162dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="162dp"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:src="@drawable/img_home_treasury_top_bg" />

                <ImageView
                    android:layout_marginRight="31dp"
                    android:layout_marginLeft="18dp"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:layout_marginTop="63dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_home_treasury_top_bg2" />


                <ImageView
                    android:id="@+id/iv_qz"
                    android:layout_width="113dp"
                    android:layout_height="31dp"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="28dp"
                    android:layout_marginTop="82dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_home_treasury_title" />

                <ImageView
                    android:id="@+id/iv_bd"
                    android:layout_width="110dp"
                    android:layout_height="90dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="31dp"
                    android:layout_marginTop="65dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_home_treasury_hero" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="29dp"
                    android:layout_marginTop="119dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/home_treasury_slogan"
                    android:textColor="@color/color_96_000000"
                    android:textSize="12sp" />
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:layout_marginTop="-22dp"
                android:id="@+id/rv_treasury_cards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
