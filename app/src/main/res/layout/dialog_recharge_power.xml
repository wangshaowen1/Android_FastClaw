<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.recharge.MyBalanceViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_color2_tr20">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="算力充值"
            android:textAppearance="@style/Text16"
            android:textColor="?attr/textColor1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:onClick="@{(v)->layout.dismiss()}"
            android:paddingHorizontal="15dp"
            android:src="@drawable/icon_close"
            app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvTitle" />

        <com.kgmedia.fastfilm.widget.LoadStateViewHolder
            displayChild="@{layout.loadState}"
            hwRatio="@{layout.loadState == 3 ? 3f : 1f}"
            onRetry="@{layout::loadConfig}"
            setConstraintMaxHeightByWidth="@{true}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <include
                    android:id="@+id/banner"
                    banner="@{layout.workCourseBanner}"
                    layout="@layout/layout_common_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/tvPower"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/banner"
                    app:layout_goneMarginTop="0dp"
                    tools:text="算力余额 0">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="算力余额："
                        android:textAppearance="@style/Text14"
                        android:textColor="?attr/textColor2" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginHorizontal="4dp"
                        android:src="@drawable/icon_power" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{layout.balance}"
                        android:textAppearance="@style/Text14"
                        android:textColor="?attr/textColor2"
                        tools:text="0" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRechargeAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:adapter="@{layout.powerAdapter}"
                    android:overScrollMode="never"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="6dp"
                    android:scrollbars="none"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/tvPower"
                    app:spanCount="3"
                    tools:itemCount="6"
                    tools:listitem="@layout/item_recharge_power" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="18dp"
                    android:text="支付方式"
                    android:textAppearance="@style/Text14"
                    android:textColor="?attr/textColor2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rvRechargeAmount" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPayment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="33dp"
                    android:adapter="@{layout.paymentAdapter}"
                    android:overScrollMode="never"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="6dp"
                    android:scrollbars="none"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/rvRechargeAmount"
                    app:spanCount="2"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_recharge_payment_dialog" />

                <TextView
                    android:id="@+id/btnRecharge"
                    singleClick="@{(v)->layout.recharge()}"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/selector_common_button"
                    android:gravity="center"
                    android:text="立即充值"
                    android:textAppearance="@style/Text16"
                    android:textColor="@color/fixed_white_1"
                    app:layout_constraintDimensionRatio="345:44"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rvPayment"
                    app:layout_constraintWidth_percent="0.92" />

                <LinearLayout
                    android:id="@+id/llPolicy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/btnRecharge">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="购买即表示同意"
                        android:textAppearance="@style/Text12"
                        android:textColor="?attr/textColor3" />

                    <TextView
                        singleClick="@{(v)->layout.viewPaymentAgreement()}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingVertical="12dp"
                        android:text="《支付协议》"
                        android:textAppearance="@style/Text12"
                        android:textColor="?attr/textColor1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="和"
                        android:textAppearance="@style/Text12"
                        android:textColor="?attr/textColor1" />

                    <TextView
                        singleClick="@{(v)->layout.viewServicePurchaseInstructions()}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingVertical="12dp"
                        android:text="《服务购买须知》"
                        android:textAppearance="@style/Text12"
                        android:textColor="?attr/textColor1" />

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.kgmedia.fastfilm.widget.LoadStateViewHolder>
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>