<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kgmedia.fastfilm.feature.works.ItemMyWorkVM" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:onClick="@{(v)->item.onItemClick.invoke(v)}">

        <com.kgmedia.fastfilm.widget.roundedimageview.RoundedImageView
            android:id="@+id/ivCover"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="107:142"
            app:layout_constraintTop_toTopOf="parent"
            app:riv_corner_radius="@dimen/radius_m"
            tools:src="@drawable/ic_default_cover" />

        <com.kgmedia.fastfilm.widget.BorderConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:backgroundStartColor="@color/mask_opacity_60_dark"
            app:layout_constraintBottom_toBottomOf="@+id/ivCover"
            app:layout_constraintEnd_toEndOf="@+id/ivCover"
            app:layout_constraintStart_toStartOf="@+id/ivCover"
            app:layout_constraintTop_toTopOf="@+id/ivCover"
            app:roundCornerRadius="@dimen/radius_m">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableTop="@drawable/icon_ai"
                android:drawablePadding="12dp"
                android:gravity="center"
                android:text="视频生成中 60%"
                android:textAppearance="@style/Text12"
                android:textColor="@color/fixed_white_1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </com.kgmedia.fastfilm.widget.BorderConstraintLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_fixed_white_1_round"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:text="草稿"
            android:textAppearance="@style/Text10"
            android:textColor="@color/fixed_black_1"
            app:layout_constraintEnd_toEndOf="@+id/ivCover"
            app:layout_constraintTop_toTopOf="@+id/ivCover" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_margin="4dp"
            android:background="@drawable/gradient_left_ff6e25_right_ffe261_round"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:text="待合成"
            android:textAppearance="@style/Text10"
            android:textColor="@color/fixed_white_1"
            app:layout_constraintEnd_toEndOf="@+id/ivCover"
            app:layout_constraintTop_toTopOf="@+id/ivCover" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lines="1"
            android:text="玄幻：开局一条蛇开局一条蛇开局一条蛇开局一条蛇开局一条蛇开局一条蛇开局一条蛇"
            android:textAppearance="@style/Text12"
            android:textColor="?textColor2"
            app:layout_constraintEnd_toEndOf="@+id/ivCover"
            app:layout_constraintStart_toStartOf="@+id/ivCover"
            app:layout_constraintTop_toBottomOf="@+id/ivCover" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>