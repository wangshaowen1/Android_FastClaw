<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kgmedia.fastfilm.feature.works.ItemMyWorkVM" />

        <import type="android.view.View" />

        <import type="com.kgmedia.fastfilm.core.network.apis.entity.WorkInfo" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:onClick="@{(v)->item.onClick()}">

        <com.kgmedia.fastfilm.widget.roundedimageview.RoundedImageView
            android:id="@+id/ivCover"
            android:layout_width="match_parent"
            loadUri="@{item.data.workCoverUrl}"
            placeHolder="@{@drawable/ic_default_cover}"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="107:142"
            app:layout_constraintTop_toTopOf="parent"
            app:riv_corner_radius="@dimen/radius_m"
            android:src="@drawable/ic_default_cover"
            tools:src="@drawable/ic_default_cover" />

        <com.kgmedia.fastfilm.widget.BorderConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="@{item.workState==WorkInfo.COMPOSING_STATE?View.VISIBLE:View.GONE}"
            app:backgroundStartColor="@color/mask_opacity_60_dark"
            app:layout_constraintBottom_toBottomOf="@+id/ivCover"
            app:layout_constraintEnd_toEndOf="@+id/ivCover"
            app:layout_constraintStart_toStartOf="@+id/ivCover"
            app:layout_constraintTop_toTopOf="@+id/ivCover"
            app:roundCornerRadius="@dimen/radius_m">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableTop="@drawable/icon_ai"
                android:drawablePadding="12dp"
                android:gravity="center"
                android:text="视频生成中..."
                android:textAppearance="@style/Text12"
                android:textColor="@color/fixed_white_1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </com.kgmedia.fastfilm.widget.BorderConstraintLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_fixed_white_1_round"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:text="草稿"
            android:textAppearance="@style/Text10"
            android:textColor="@color/fixed_black_1"
            android:visibility="@{(item.workState==WorkInfo.DRAFT_STATE&amp;&amp;item.isView())?View.VISIBLE:View.GONE}"
            app:layout_constraintEnd_toEndOf="@+id/ivCover"
            app:layout_constraintTop_toTopOf="@+id/ivCover" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:layout_margin="4dp"
            android:background="@drawable/gradient_left_ff6e25_right_ffe261_round"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:text="待合成"
            android:textAppearance="@style/Text10"
            android:textColor="@color/fixed_white_1"
            android:visibility="@{(item.workState==WorkInfo.WAIT_STATE&amp;&amp;item.isView())?View.VISIBLE:View.GONE}"
            app:layout_constraintEnd_toEndOf="@+id/ivCover"
            app:layout_constraintTop_toTopOf="@+id/ivCover" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="6dp"
            android:visibility="@{(item.data.finishedEpisodeCnt>0)?View.VISIBLE:View.GONE}"
            android:text="@{`共`+item.data.finishedEpisodeCnt+`集`}"
            tools:text="共1集"
            android:textAppearance="@style/Text12"
            android:textColor="@{(item.workState==WorkInfo.COMPOSING_STATE&amp;&amp;item.isView())?@color/fixed_white_3:@color/fixed_white_1}"
            app:layout_constraintBottom_toBottomOf="@id/ivCover"
            app:layout_constraintEnd_toEndOf="@+id/ivCover"
            tools:textColor="@color/fixed_white_1" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lines="1"
            android:text="@{item.data.workTitle}"
            tools:text="玄幻：开局一条蛇开局一条蛇开局一条蛇开局一条蛇开局一条蛇开局一条蛇开局一条蛇"
            android:textAppearance="@style/Text12"
            android:textColor="?textColor2"
            app:layout_constraintEnd_toEndOf="@+id/ivCover"
            app:layout_constraintStart_toStartOf="@+id/ivCover"
            app:layout_constraintTop_toBottomOf="@+id/ivCover" />

        <ImageView
            android:layout_width="16dp"
            android:importantForAccessibility="no"
            android:src="@{item.isSelected()?@drawable/ic_my_work_selected:@drawable/ic_my_work_not_selected}"
            tools:src="@drawable/ic_my_work_selected"
            android:visibility="@{item.isView()?View.GONE:View.VISIBLE}"
            app:layout_constraintTop_toTopOf="@id/ivCover"
            app:layout_constraintEnd_toEndOf="@id/ivCover"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:layout_height="16dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>