<?xml version="1.0" encoding="utf-8"?>
<com.shiyuan.fastclaw.widget.shape.SuperLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="139dp"
    android:layout_height="126dp"
    android:gravity="center"
    android:orientation="vertical"
    app:background_normalColor="@color/color_60_000000"
    app:super_corner="20dp">

    <ImageView
        android:layout_width="53dp"
        android:layout_height="53dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_phone_new_login_loading" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="21dp"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:text="@string/login_new_logging_in"
        android:textColor="@color/white"
        android:textSize="14sp" />
</com.shiyuan.fastclaw.widget.shape.SuperLinearLayout>
