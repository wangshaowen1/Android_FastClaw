<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.shiyuan.fastclaw.feature.mine.ItemInterviewReportVM" />
    </data>

    <LinearLayout
        singleClick="@{() -> item.onItemClick()}"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_white_rectangle_corner_r12"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:padding="16dp"
        tools:layout_marginHorizontal="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="48dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{item.reportName}"
                android:textColor="@color/color_1a1a1a"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="【公司背调】生成失败" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@{item.failReason}"
                android:textColor="@color/color_F74C30"
                android:textSize="11sp"
                tools:text="报告生成失败，本次不消耗虾条" />
        </LinearLayout>

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:importantForAccessibility="no"
            android:scaleType="centerInside"
            android:src="@drawable/ic_report_failed" />
    </LinearLayout>
</layout>
