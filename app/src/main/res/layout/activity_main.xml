<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.main.MainViewModel" />

        <import type="android.view.View" />

        <import type="com.shiyuan.fastclaw.common.ext.FormatUtils" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:id="@+id/fragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


        <com.shiyuan.fastclaw.widget.MultRadioGroup
            android:background="@color/white"
            android:id="@+id/mrg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:paddingVertical="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="24dp">

                <View
                    android:onClick="@{layout.clickHandler::onClick}"
                    android:id="@+id/tabHome"
                    android:layout_width="90dp"
                    android:layout_height="40dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <View
                    android:onClick="@{layout.clickHandler::onClick}"
                    android:id="@+id/tabTreasury"
                    android:layout_width="90dp"
                    android:layout_height="40dp"
                    app:layout_constraintStart_toEndOf="@id/tabHome"
                    app:layout_constraintEnd_toStartOf="@id/tabMine"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <View
                    android:onClick="@{layout.clickHandler::onClick}"
                    android:id="@+id/tabMine"
                    android:layout_width="90dp"
                    android:layout_height="40dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <com.shiyuan.fastclaw.widget.FixedAnimatedRadioButton
                    android:id="@+id/rbHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:button="@null"
                    android:drawableTop="@drawable/cb_main_tab_home"
                    android:drawablePadding="2dp"
                    android:gravity="center"
                    android:text="@string/tab_claw"
                    android:textColor="@color/cb_main_tab_txt"
                    android:textSize="10sp"
                    app:layout_constraintBottom_toBottomOf="@id/tabHome"
                    app:layout_constraintEnd_toEndOf="@id/tabHome"
                    app:layout_constraintStart_toStartOf="@id/tabHome"
                    app:layout_constraintTop_toTopOf="@id/tabHome"
                    tools:checked="true" />

                <com.shiyuan.fastclaw.widget.FixedAnimatedRadioButton
                    android:id="@+id/rbTreasury"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:button="@null"
                    android:drawableTop="@drawable/cb_main_tab_folder"
                    android:drawablePadding="2dp"
                    android:gravity="center"
                    android:text="@string/tab_treasury"
                    android:textColor="@color/cb_main_tab_txt"
                    android:textSize="10sp"
                    app:layout_constraintBottom_toBottomOf="@id/tabTreasury"
                    app:layout_constraintEnd_toEndOf="@id/tabTreasury"
                    app:layout_constraintStart_toStartOf="@id/tabTreasury"
                    app:layout_constraintTop_toTopOf="@id/tabTreasury"
                    tools:checked="false" />

                <com.shiyuan.fastclaw.widget.FixedAnimatedRadioButton
                    android:id="@+id/rbMine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:button="@null"
                    android:drawableTop="@drawable/cb_main_tab_mine"
                    android:drawablePadding="2dp"
                    android:gravity="center"
                    android:text="@string/tab_mine"
                    android:textColor="@color/cb_main_tab_txt"
                    android:textSize="10sp"
                    app:layout_constraintBottom_toBottomOf="@id/tabMine"
                    app:layout_constraintEnd_toEndOf="@id/tabMine"
                    app:layout_constraintStart_toStartOf="@id/tabMine"
                    app:layout_constraintTop_toTopOf="@id/tabMine"
                    tools:checked="false" />


            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.shiyuan.fastclaw.widget.MultRadioGroup>


        <com.shiyuan.fastclaw.widget.VoiceRecordingView
            android:id="@+id/layout_voice_recording"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
