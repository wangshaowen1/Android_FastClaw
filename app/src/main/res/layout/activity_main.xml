<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.main.MainViewModel" />

        <import type="android.view.View" />

        <import type="com.kgmedia.fastfilm.common.ext.FormatUtils" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/fragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.kgmedia.fastfilm.widget.MultRadioGroup
            android:id="@+id/mrg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_color2_tr20"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.kgmedia.fastfilm.widget.FixedAnimatedRadioButton
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:button="@null"
                android:drawableTop="@drawable/cb_main_tab_home"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:onClick="@{layout.clickHandler::onClick}"
                android:paddingTop="12dp"
                android:paddingBottom="10dp"
                android:text="创作"
                android:textColor="@color/cb_main_tab_txt"
                android:textSize="10sp"
                tools:checked="true" />

            <com.kgmedia.fastfilm.widget.FixedAnimatedRadioButton
                android:id="@+id/tabWorks"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:button="@null"
                android:drawableTop="@drawable/cb_main_tab_folder"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:onClick="@{layout.clickHandler::onClick}"
                android:paddingTop="12dp"
                android:paddingBottom="10dp"
                android:text="作品"
                android:textColor="@color/cb_main_tab_txt"
                android:textSize="10sp"
                tools:checked="false" />

            <com.kgmedia.fastfilm.widget.FixedAnimatedRadioButton
                android:id="@+id/tabMine"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:button="@null"
                android:drawableTop="@drawable/cb_main_tab_mine"
                android:drawablePadding="4dp"
                android:gravity="center"
                android:onClick="@{layout.clickHandler::onClick}"
                android:paddingTop="12dp"
                android:paddingBottom="10dp"
                android:text="我的"
                android:textColor="@color/cb_main_tab_txt"
                android:textSize="10sp"
                tools:checked="false" />

        </com.kgmedia.fastfilm.widget.MultRadioGroup>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>