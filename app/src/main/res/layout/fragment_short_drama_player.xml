<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.play.ShortDramaPlayerViewModel" />

        <import type="com.kgmedia.fastfilm.common.ext.StringUtils" />

        <import type="com.kgmedia.fastfilm.common.ext.TextViewExtKt" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_121212">

        <eightbitlab.com.blurview.BlurTarget
            android:id="@+id/target"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="H,9:16"
            app:layout_constraintTop_toTopOf="parent">

            <com.kgmedia.fastfilm.widget.TransitionViewFlipper
                android:id="@+id/imagesFlipper"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:onClick="@{()->layout.togglePlayback()}"
                android:clickable="@{!layout.isLocked()}"
                app:microAnimDirection="top"
                app:microAnimDistance="0.3"
                app:microAnimDuration="4000"
                app:microAnimEnabled="true"
                app:microAnimInitialScale="1.2"
                app:microAnimScale="1" />
        </eightbitlab.com.blurview.BlurTarget>

        <View
            android:id="@+id/imagesArea"
            setDimensionRatio="@{layout.dramaDetail.videoRatioValue}"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="@+id/target"
            app:layout_constraintEnd_toEndOf="@+id/target"
            app:layout_constraintStart_toStartOf="@+id/target"
            app:layout_constraintTop_toTopOf="@+id/target"
            tools:layout_constraintDimensionRatio="16:9" />

        <TextView
            marginTopDp="@{layout.dramaDetail.videoRatio==1?94:12}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:shadowColor="@color/color_40_000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="3.0"
            android:text="AI生成"
            android:textColor="@color/color_50_ffffff"
            android:textSize="12dp"
            app:layout_constraintEnd_toEndOf="@+id/imagesArea"
            app:layout_constraintTop_toTopOf="@+id/imagesArea"
            tools:layout_marginTop="12dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/gradient_top_00_000000_bottom_80_000000"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="W,248:375" />

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/blurView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="@{layout.isLocked?View.VISIBLE:View.GONE}" />

        <com.kgmedia.fastfilm.widget.ExpandableTextView
            android:id="@+id/plot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="15dp"
            android:layout_marginBottom="12dp"
            android:lineSpacingExtra="@dimen/lineSpacingExtraShort"
            android:minWidth="48dp"
            android:visibility="@{layout.seeking?View.GONE:View.VISIBLE}"
            app:animationDuration="200"
            app:collapseIcon="@drawable/ic_player_collapse_more"
            app:collapseMaxLines="2"
            app:expandIcon="@drawable/ic_player_expand_more"
            app:layout_constraintBottom_toTopOf="@id/seriesLayout"
            app:layout_constraintEnd_toStartOf="@id/share"
            app:layout_constraintStart_toStartOf="parent"
            app:text="@{`第`+StringUtils.orEmpty(layout.dramaDetail.workNo)+`章｜`+StringUtils.orEmpty(layout.shortIntro)}"
            app:textColor="@color/white"
            app:textSize="14sp"
            tools:text="第3章｜重生了，我重生了，哈哈哈哈哈哈，这一次，我将改变一切，失去的绝对会一点一点的拿回来。   " />

        <TextView
            android:id="@+id/title"
            style="@style/Text.Medium"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="18dp"
            android:layout_marginBottom="6dp"
            android:singleLine="true"
            android:text="@{layout.shortName}"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:visibility="@{layout.seeking?View.GONE:View.VISIBLE}"
            app:layout_constraintBottom_toTopOf="@id/plot"
            app:layout_constraintEnd_toStartOf="@id/share"
            app:layout_constraintStart_toStartOf="@id/plot"
            tools:text="穿成恶毒女配后，我反向攻略女主" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="66dp"
            app:layout_constraintBottom_toBottomOf="@+id/target"
            app:layout_constraintEnd_toEndOf="@+id/target"
            app:layout_constraintStart_toStartOf="@+id/target"
            app:layout_constraintTop_toTopOf="@+id/target"
            app:layout_constraintVertical_bias="0.75">

            <com.kgmedia.fastfilm.widget.MarqueeTextView
                android:id="@+id/tvSubtitle"
                changeText="@{layout.subtitles}"
                duration="@{layout.currentSegmentAudioDuration}"
                startMarquee="@{layout.playing}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingHorizontal="16dp"
                android:shadowColor="@color/color_40_000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="3.0"
                android:textColor="?colorPrimary"
                android:textSize="15dp"
                tools:text="手心忽然长出纠缠的曲线" />

        </FrameLayout>


<!--            setVisible="@{!layout.seeking &amp;&amp; layout.dramaDetail.interaction.profitPointNum>0}"-->
        <TextView
            android:id="@+id/playCount"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@drawable/shape_bg_play_count"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3.5dp"
            android:text="@{`累计播放`+StringUtils.orEmpty(layout.dramaDetail.interaction.playNumStr)}"
            android:textColor="#FF8839"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@id/title"
            app:layout_constraintStart_toStartOf="@id/title"
            tools:text="累计播放5487" />

<!--            setVisible="@{!layout.seeking &amp;&amp; layout.dramaDetail.interaction.profitPointNum>0}"-->
        <TextView
            android:id="@+id/playbackRevenue"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/shape_bg_playback_revenue"
            android:drawableEnd="@drawable/ic_playback_revenue"
            android:drawablePadding="1dp"
            android:gravity="center"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3.5dp"
            android:text="@{`累计收益`+StringUtils.orEmpty(layout.dramaDetail.interaction.profitPointNum)}"
            android:textColor="#FFEB39"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/playCount"
            app:layout_constraintStart_toEndOf="@id/playCount"
            app:layout_constraintTop_toTopOf="@id/playCount"
            tools:text="累计收益 233" />

        <ImageView
            android:id="@+id/btnPlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_player_play"
            android:visibility="@{(layout.isLocked||(layout.isPreparingToPlay||layout.isPlaying))?View.GONE:View.VISIBLE}"
            app:layout_constraintBottom_toBottomOf="parent"
            android:onClick="@{()->layout.togglePlayback()}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.452879581"
            tools:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:drawableTop="@drawable/ic_short_locked"
            android:drawablePadding="10dp"
            android:text="解锁后可看"
            android:textColor="@color/color_50_ffffff"
            android:visibility="@{layout.isLocked?View.VISIBLE:View.GONE}"
            app:layout_constraintBottom_toTopOf="@id/author"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/lockLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="19dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_white_rectangle_corner_r12"
            android:visibility="@{layout.isLocked?View.VISIBLE:View.GONE}"
            app:layout_constraintBottom_toTopOf="@id/seriesLayout"
            app:layout_constraintEnd_toStartOf="@id/author"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="gone">

            <com.kgmedia.fastfilm.widget.CropShapeImageView
                android:id="@+id/cover"
                loadThumbnailUri="@{layout.dramasSeries.seriesCoverUrl}"
                android:layout_width="72dp"
                android:layout_height="96dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/roundStyle_r8" />

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="12dp"
                android:ellipsize="end"
                android:lineSpacingExtra="@dimen/lineSpacingExtraShort"
                android:maxLines="2"
                android:text="@{layout.dramasSeries.seriesName}"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/cover"
                app:layout_constraintTop_toTopOf="@id/cover"
                app:layout_constraintVertical_chainStyle="spread_inside"
                tools:text="蓝色的天空蓝色的天空蓝色的天空蓝色..." />

            <TextView
                android:id="@+id/seriesInfo"
                style="@style/Text.Medium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="6dp"
                android:text="@{`共`+StringUtils.orEmpty(layout.dramasSeries.totalWorkNum)+`章｜`+StringUtils.orEmpty(layout.dramasSeries.playNumStr)+`播放`}"
                android:textColor="@color/color_50_121212"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/shortStatus"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/tv_name"
                tools:text="512.1万" />

            <TextView
                android:id="@+id/shortStatus"
                setSpanText="@{`当前为第`+StringUtils.orEmpty(layout.dramaDetail.workNo)+`章｜`+StringUtils.orEmpty(layout.dramaDetail.unlockInfo.unlockPrice)+`积分`}"
                spanColor="@{@color/color_ff6b2e}"
                spanText="@{StringUtils.orEmpty(layout.dramaDetail.unlockInfo.unlockPrice)+`积分`}"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:textColor="@color/color_70_121212"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/cover"
                app:layout_constraintEnd_toEndOf="@id/tv_name"
                app:layout_constraintStart_toStartOf="@id/tv_name"
                tools:text="当前为第102章｜500积分" />

            <Button
                android:id="@+id/unlock"
                style="@style/Button.Bold"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="12dp"
                android:text="立即解锁"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cover" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/share"
            style="@style/Text.Common"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:drawableTop="@drawable/ic_short_share"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:minWidth="48dp"
            android:text="@string/share"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:visibility="@{layout.seeking?View.GONE:View.VISIBLE}"
            app:layout_constraintBottom_toTopOf="@id/seriesLayout"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.kgmedia.fastfilm.widget.CropShapeImageView
            android:id="@+id/author"
            loadThumbnailUri="@{layout.dramaDetail.artist.avatarUrl}"
            placeHolder="@{@drawable/ic_default_avatar}"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginBottom="24dp"
            android:foreground="@drawable/oval_stroke_ffffff_1dp"
            android:visibility="@{layout.seeking?View.GONE:View.VISIBLE}"
            app:layout_constraintBottom_toTopOf="@id/follow"
            app:layout_constraintEnd_toEndOf="@id/follow"
            app:layout_constraintStart_toStartOf="@id/follow"
            app:shapeAppearanceOverlay="@style/roundStyle_circle"
            tools:src="@drawable/ic_default_avatar" />

        <TextView
            android:id="@+id/follow"
            style="@style/Text.Common"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="16dp"
            android:drawableTop="@{layout.isFollowed?@drawable/ic_short_followed:@drawable/ic_short_follow}"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:minWidth="48dp"
            android:text="@{`0`.equals(layout.followNumStr)?`追更`:layout.followNumStr}"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:visibility="@{layout.seeking?View.GONE:View.VISIBLE}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintBottom_toTopOf="@id/likes"
            app:layout_constraintEnd_toEndOf="parent"
            tools:drawableTop="@drawable/ic_short_follow"
            tools:text="追更" />

        <TextView
            android:id="@+id/likes"
            style="@style/Text.Common"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="16dp"
            android:drawableTop="@{layout.isLiked()?@drawable/ic_short_liked:@drawable/ic_short_like}"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:minWidth="48dp"
            android:text="@{`0`.equals(layout.likeNumStr)?`喜欢`:layout.likeNumStr}"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:visibility="@{layout.seeking?View.GONE:View.VISIBLE}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintBottom_toTopOf="@id/share"
            app:layout_constraintEnd_toEndOf="parent"
            tools:drawableTop="@drawable/ic_short_like"
            tools:text="1688" />

        <com.kgmedia.fastfilm.widget.PlayerSeekbar
            android:id="@+id/seekbar"
            currentPosition="@{layout.currentPosition}"
            duration="@{layout.duration}"
            onSeekListener="@{layout.onSeekListener}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:minHeight="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/seriesLayout"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/bg_20_ffffff_r8"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="9dp"
            android:visibility="@{layout.seeking||layout.workModel?View.GONE:View.VISIBLE}"
            app:layout_constraintBottom_toTopOf="@id/bottomView">

            <TextView
                style="@style/Text.Common"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:text="章节"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Text.Common"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="·"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Text.Common"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@{`更新至`+layout.totalWorkNum+`章`}"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="更新至18章" />

            <TextView
                style="@style/Text.Common"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="·"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Text.Common"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@{StringUtils.orEmpty(layout.dramasSeries.seriesName)}"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="穿成恶毒女配后，我反向攻略" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:src="@drawable/ic_episode_expand" />
        </LinearLayout>

        <androidx.legacy.widget.Space
            android:id="@+id/bottomView"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:layout_constraintBottom_toBottomOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>