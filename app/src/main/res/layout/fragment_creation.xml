<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.creator.CreationViewModel" />

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />
    </data>

    <LinearLayout
        android:id="@+id/inputLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.kgmedia.fastfilm.widget.CounterInputLayout
            android:id="@+id/inputView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@null"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="top|start"
            app:hint="@{layout.hint}"
            app:inputCounterBottomMargin="4dp"
            app:inputCounterGravity="right"
            app:inputCounterRightMargin="0dp"
            app:inputCounterTextColor="@color/color_40_121212"
            app:inputCounterTextSize="12sp"
            app:inputCounterVisible="false"
            app:inputHorizontalPadding="16dp"
            app:inputTextColor="@color/textColorPrimary"
            app:inputTextColorHint="@color/color_30_121212"
            app:inputTextSize="15sp"
            app:inputVerticalPadding="12dp"
            app:maxLength="@{layout.maxInputLength}" />

        <com.kgmedia.fastfilm.widget.TagLayout
            android:id="@+id/lyricPrompts"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="14dp"
            android:visibility="@{layout.inspirationModel()?View.VISIBLE:View.GONE}"
            app:cacheMode="none"
            app:horizontalSpace="12dp"
            app:maxLines="2"
            app:tagBackground="@drawable/selector_prompts"
            app:tagSelectMode="single"
            app:tagTextColor="@color/color_121127"
            app:tagTextHorizontalPadding="12dp"
            app:tagTextMaxLine="1"
            app:tagTextSize="14sp"
            app:tagTextVerticalPadding="6dp"
            app:verticalSpace="12dp" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginHorizontal="16dp">

            <TextView
                android:id="@+id/btnOptimize"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_10_48b3ff_3e6bff_r50"
                android:drawableStart="@drawable/ic_optimize36"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="帮我优化"
                android:textColor="@color/color_619dff"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="@{layout.input.length()>0?View.VISIBLE:View.GONE}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/btnRandomPrompt"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:background="@drawable/gradient_10_left_ff4b00_right_ffa029_r50"
                android:drawableStart="@drawable/ic_star36"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="随机灵感"
                android:textColor="@color/color_ff4b00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="@{layout.input.length()==0?View.VISIBLE:View.GONE}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{layout.input.length()+`/`+layout.maxInputLength}"
                android:textColor="@color/color_40_121212"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="0/5000" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:visibility="@{layout.inspirationModel()?View.VISIBLE:View.GONE}">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="灵感示例"
                android:textColor="@color/textColorPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <View style="@style/SpaceAutoFit" />

            <TextView
                android:id="@+id/randomInspirations"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/ic_random_black48"
                android:includeFontPadding="false"
                android:padding="4dp"
                android:src="@drawable/ic_random_prompt"
                android:textColor="@color/color_121127"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnNext"
            style="@style/Button.Bold"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="20dp"
            android:text="开始创作" />
    </LinearLayout>
</layout>