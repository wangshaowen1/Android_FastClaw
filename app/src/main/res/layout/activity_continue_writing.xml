<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.creator.continuewriting.ContinueWritingViewModel" />

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_model_toolbar"
            app:toolbar="@{layout.mToolbarVM}" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:text="前情提要："
            android:textColor="@color/textColorPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="18dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_avatar"
                loadHQThumbnailUri="@{layout.info.dramasCoverUrl}"
                android:layout_width="60dp"
                android:layout_height="80dp"
                android:scaleType="centerCrop"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearance="@style/roundStyle_r6" />

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{`第`+layout.info.workNo+`章 | `+layout.info.dramasName}"
                android:textColor="@color/textColorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/tv_desc"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toEndOf="@id/iv_avatar"
                app:layout_constraintTop_toTopOf="@id/iv_avatar"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="第1章｜穿成恶毒女配后，我反向攻略女主..." />

            <TextView
                android:id="@+id/tv_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="4"
                android:text="@{layout.info.scriptIntro}"
                android:textColor="@color/color_50_121212"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="@id/iv_avatar"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/tv_name"
                app:layout_constraintTop_toBottomOf="@id/tv_name"
                tools:text="上学的时候黄元元是那种特别讨厌的同学，尤其是在接老师下茬这一点。他坐在我右边，阳光茬这一点。他坐在我右边，阳光茬这一点。他坐在我右边，阳光茬这一点。他坐在我右边..." />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/inputLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_ffffff_tr16"
            android:orientation="vertical">

            <com.kgmedia.fastfilm.widget.EdgeTransparentView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="4dp"
                android:layout_weight="1"
                app:edge_position="bottom"
                app:edge_width="30dp">

                <com.kgmedia.fastfilm.widget.CounterInputLayout
                    android:id="@+id/inputView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:focusable="true"
                    setEnabled="@{!layout.isSSEStreaming}"
                    android:focusableInTouchMode="true"
                    android:gravity="top|start"
                    app:inputCounterBottomMargin="4dp"
                    app:inputCounterGravity="right"
                    app:inputCounterRightMargin="0dp"
                    app:inputCounterTextColor="@color/color_40_121212"
                    app:inputCounterTextSize="12sp"
                    app:inputCounterVisible="false"
                    app:inputHint="输入你想要续写的故事想法，也可以让AI帮你丰富内容哦~"
                    app:inputHorizontalPadding="16dp"
                    app:inputTextColor="@color/textColorPrimary"
                    app:inputTextColorHint="@color/color_30_121212"
                    app:inputTextSize="15sp"
                    app:inputVerticalPadding="12dp"
                    app:maxLength="@{layout.maxInputLength}" />
            </com.kgmedia.fastfilm.widget.EdgeTransparentView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginHorizontal="16dp">

                <TextView
                    android:id="@+id/btnOptimize"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/gradient_10_48b3ff_3e6bff_r50"
                    android:drawableStart="@drawable/ic_optimize36"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="帮我续写"
                    android:textColor="@color/color_619dff"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <androidx.legacy.widget.Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{layout.input.length()+`/`+layout.maxInputLength}"
                    android:textColor="@color/color_40_121212"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnVip"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/gradient_10_left_ff4b00_right_ffa029_r50"
                    android:drawableStart="@drawable/ic_vip54"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="提高字数限制"
                    android:textColor="@color/color_ff7300"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="@{!layout.isVip?View.VISIBLE:View.GONE}" />
            </LinearLayout>

            <Button
                android:id="@+id/btnNext"
                style="@style/Button.Bold"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="32dp"
                android:layout_marginTop="32dp"
                android:alpha="@{!layout.isSSEStreaming&amp;&amp;layout.input.length()>layout.minInputLength?1f:0.5f}"
                android:text="下一步" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp"
                android:text="续写故事，将保持之前的风格与画幅，确保作品风格一致。"
                android:textColor="@color/color_50_121212"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</layout>