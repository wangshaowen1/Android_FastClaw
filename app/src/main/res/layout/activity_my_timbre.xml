<?xml version="1.0" encoding="utf-8"?><!--选择话题-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.timbre.MyTimbresViewModel" />

        <import type="android.view.View" />

        <import type="com.kgmedia.fastfilm.common.utils.Utils" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_model_toolbar"
            app:layout_constraintTop_toTopOf="parent"
            app:toolbar="@{layout.mToolbarVM}" />

        <com.shizhefei.view.coolrefreshview.CoolRefreshView
            android:id="@+id/refreshLayout"
            onRefresh="@{()->layout.refresh()}"
            refreshing="@{layout.isRefreshing}"
            setPullHeader="@{Utils.getPullHeader()}"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adapter="@{layout.adapterHelper.adapter}"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:overScrollMode="never"
                android:scrollbars="none"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_my_timbre" />

        </com.shizhefei.view.coolrefreshview.CoolRefreshView>

        <View
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:background="@drawable/gradient_top_00_f5f5f5_bottom_f5f5f5"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/btnTimbreClone"
            style="@style/Button.Bold"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginHorizontal="33dp"
            android:layout_marginBottom="27dp"
            android:gravity="center"
            android:text="新建音色"
            android:textColor="@color/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
