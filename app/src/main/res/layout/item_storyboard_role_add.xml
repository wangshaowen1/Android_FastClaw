<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="item"
            type="com.kgmedia.fastfilm.feature.editor.regenerate.ItemStoryboardRoleVM" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp">

        <View
            android:id="@+id/btnAddRole"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_f5f5f5_r8"
            app:layout_constraintDimensionRatio="84:112"
            app:layout_constraintStart_toStartOf="parent"
            app:riv_corner_radius="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableTop="@drawable/ic_add_gray48"
            android:drawablePadding="3dp"
            android:text="新增角色"
            android:textColor="@color/color_50_121212"
            android:textSize="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/btnAddRole"
            app:layout_constraintEnd_toEndOf="@+id/btnAddRole"
            app:layout_constraintStart_toStartOf="@+id/btnAddRole"
            app:layout_constraintTop_toTopOf="@+id/btnAddRole" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>