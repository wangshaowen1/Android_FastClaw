<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.mine.MineViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_F5F8FC"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_model_toolbar"
            app:toolbar="@{layout.mToolbarVM}" />

      <androidx.core.widget.NestedScrollView
          android:layout_width="match_parent"
          android:layout_height="wrap_content">

          <LinearLayout
             android:padding="16dp"
              android:orientation="vertical"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              tools:ignore="UselessLeaf">

              <RelativeLayout
                  android:padding="16dp"
                  android:background="@drawable/bg_ffffff_r12"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content">

                  <TextView
                      android:layout_centerVertical="true"
                      android:id="@+id/tv_name"
                      android:text="@string/mine_sticks"
                      android:textColor="@color/color_1a1a1a"
                      android:textSize="14sp"
                      android:textStyle="bold"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content">
                  </TextView>

                  <TextView
                      android:id="@+id/tv_points"
                      android:text="@{layout.userPoints}"
                      android:textColor="@color/color_1a1a1a"
                      android:textSize="32sp"
                      android:textStyle="bold"
                      android:layout_alignParentEnd="true"
                      android:layout_centerVertical="true"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content">
                  </TextView>



              </RelativeLayout>

              <RelativeLayout
                  android:layout_marginTop="12dp"
                  android:background="@drawable/bg_ffffff_r12"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content">

                  <androidx.recyclerview.widget.RecyclerView
                      android:id="@+id/recyclerView"
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content" />


              </RelativeLayout>


          </LinearLayout>


      </androidx.core.widget.NestedScrollView>




    </LinearLayout>

</layout>
