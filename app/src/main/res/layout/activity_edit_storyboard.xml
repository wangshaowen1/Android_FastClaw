<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.editor.EditStoryboardViewModel" />

        <import type="android.text.TextUtils" />

        <import type="com.kgmedia.fastfilm.common.ext.TextViewExtKt" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.kgmedia.fastfilm.widget.StatusBarView
                android:id="@+id/statusBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/action_bar_size"
                android:gravity="center"
                android:text="重绘分镜"
                android:textAppearance="@style/Text16"
                android:textColor="?attr/textColor1"
                app:layout_constraintTop_toBottomOf="@+id/statusBar" />

            <androidx.constraintlayout.widget.Placeholder
                android:id="@+id/previewArea"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                app:layout_constraintDimensionRatio="375:356"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/storyboardPlayer"
                player="@{layout.storyboardPlayer}"
                setDimensionRatio="@{layout.workRatio}"
                setVisible="@{layout.videoGenerated(layout.videoGenStatus)}"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:onClick="@{(v)->layout.play()}"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="@+id/previewArea"
                app:layout_constraintEnd_toEndOf="@+id/previewArea"
                app:layout_constraintStart_toStartOf="@+id/previewArea"
                app:layout_constraintTop_toTopOf="@+id/previewArea"
                app:use_controller="false"
                tools:layout_constraintDimensionRatio="9:16"
                tools:visibility="invisible" />

            <ImageView
                setVisible="@{layout.videoGenerated(layout.videoGenStatus)}"
                android:layout_width="32dp"
                android:layout_height="16dp"
                android:layout_margin="8dp"
                android:src="@drawable/icon_ai_label"
                app:layout_constraintStart_toStartOf="@+id/storyboardPlayer"
                app:layout_constraintTop_toTopOf="@+id/storyboardPlayer"
                tools:text="AI生成" />

            <ImageView
                setVisible="@{layout.videoGenerated(layout.videoGenStatus) &amp;&amp; !layout.playing}"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_short_drama_editor_play"
                app:layout_constraintBottom_toBottomOf="@+id/previewArea"
                app:layout_constraintEnd_toEndOf="@+id/previewArea"
                app:layout_constraintStart_toStartOf="@+id/previewArea"
                app:layout_constraintTop_toTopOf="@+id/previewArea" />

            <LinearLayout
                setDimensionRatio="@{layout.workRatio}"
                setVisible="@{!layout.videoGenerated(layout.videoGenStatus)}"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="?attr/fillColor1"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@+id/previewArea"
                app:layout_constraintEnd_toEndOf="@+id/previewArea"
                app:layout_constraintStart_toStartOf="@+id/previewArea"
                app:layout_constraintTop_toTopOf="@+id/previewArea"
                tools:layout_constraintDimensionRatio="9:16">

                <ImageView
                    setVisible="@{layout.videoGenerating(layout.videoGenStatus)}"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginBottom="12dp"
                    android:src="@drawable/icon_ai" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{layout.videoGenStatusText(layout.videoGenStatus)}"
                    android:textAppearance="@style/Text12"
                    android:textColor="@color/fixed_white_1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="图片生成排队中" />

                <TextView
                    android:id="@+id/btnRetry"
                    setVisible="@{layout.videoGenerateFailed(layout.videoGenStatus)}"
                    singleClick="@{(v) -> layout.retryGenerateVideo(false)}"
                    android:layout_width="88dp"
                    android:layout_height="28dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_theme1_r50"
                    android:gravity="center"
                    android:text="点击重试"
                    android:textAppearance="@style/Text12"
                    android:textColor="@color/fixed_white_1"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvStoryboardStatus"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStoryboardTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="24dp"
                android:text="分镜设计"
                android:textAppearance="@style/Text14"
                android:textColor="?attr/textColor2"
                android:textStyle="bold"
                app:layout_constraintDimensionRatio="345:130"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/previewArea" />

            <com.kgmedia.fastfilm.widget.roundedimageview.RoundedImageView
                android:id="@+id/ivCover"
                loadHQThumbnailUri="@{layout.storyboard.imageUrl}"
                setVisible="@{layout.imageGenerated(layout.imageGenStatus)}"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:scaleType="centerCrop"
                android:src="?attr/fillColor1"
                app:layout_constraintDimensionRatio="108:152"
                app:layout_constraintStart_toStartOf="@+id/tvStoryboardTitle"
                app:layout_constraintTop_toBottomOf="@+id/tvStoryboardTitle"
                app:layout_constraintWidth_percent="0.288"
                app:riv_border_color="?attr/borderColor2"
                app:riv_border_width="1dp"
                app:riv_corner_radius="8dp" />

            <ImageView
                setVisible="@{layout.imageGenerated(layout.imageGenStatus)}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:src="@drawable/icon_ai_label"
                app:layout_constraintStart_toStartOf="@+id/ivCover"
                app:layout_constraintTop_toTopOf="@+id/ivCover" />

            <ImageView
                android:id="@+id/btnPreview"
                setVisible="@{layout.imageGenerated(layout.imageGenStatus)}"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:src="@drawable/icon_magnify"
                app:layout_constraintBottom_toBottomOf="@+id/ivCover"
                app:layout_constraintEnd_toEndOf="@+id/ivCover" />

            <com.kgmedia.fastfilm.widget.GradientBorderView
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:borderStartColor="?attr/borderColor2"
                app:borderWidth="1dp"
                app:layout_constraintBottom_toBottomOf="@+id/ivCover"
                app:layout_constraintEnd_toEndOf="@+id/ivCover"
                app:layout_constraintStart_toStartOf="@+id/ivCover"
                app:layout_constraintTop_toTopOf="@+id/ivCover"
                app:roundCornerRadius="8dp" />

            <EditText
                android:id="@+id/tvStoryboardDesc"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/fill_color1_r8"
                android:ellipsize="end"
                android:gravity="top"
                android:lineSpacingExtra="@dimen/lineSpacingExtraShort"
                android:padding="12dp"
                android:text="@={layout.storyboardDesc}"
                android:textAppearance="@style/Text13"
                android:textColor="?attr/textColor2"
                app:layout_constraintDimensionRatio="229:130"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ivCover"
                app:layout_constraintTop_toTopOf="@+id/ivCover"
                tools:text="史莱克七怪之首，沉稳冷静。他留着一头深蓝色长发，目光深篷，拥有极强的战斗天赋和统筹全局的智慧。战斗时使用蓝银草魂灵与外附魂骨八蛛矛。" />

            <FrameLayout
                android:id="@+id/btnRegenerateImage"
                singleClick="@{() -> layout.reGenerateImage()}"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/fill_color1_r4"
                app:layout_constraintDimensionRatio="229:32"
                app:layout_constraintEnd_toEndOf="@+id/tvStoryboardDesc"
                app:layout_constraintStart_toStartOf="@+id/tvStoryboardDesc"
                app:layout_constraintTop_toBottomOf="@+id/tvStoryboardDesc">

                <com.kgmedia.fastfilm.widget.GradientTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="重新生成"
                    android:textColor="@android:color/white"
                    app:endColor="#8F83FF"
                    app:startColor="#68BFF9" />
            </FrameLayout>

            <TextView
                android:id="@+id/btnRegenerate"
                singleClick="@{() -> layout.reGenerateVideo()}"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="15dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/selector_common_button"
                android:gravity="center"
                android:text="重绘分镜"
                android:textAppearance="@style/Text16"
                android:textColor="@color/fixed_white_1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="345:44" />

            <TextView
                android:id="@+id/btnSave"
                singleClick="@{() -> layout.save(false)}"
                android:layout_width="70dp"
                android:layout_height="30dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/btn_text1_r50"
                android:gravity="center"
                android:text="保存"
                android:textAppearance="@style/Text14"
                android:textColor="?attr/bgColor1"
                app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
                app:layout_constraintEnd_toEndOf="@+id/tvTitle"
                app:layout_constraintTop_toTopOf="@+id/tvTitle" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.kgmedia.fastfilm.widget.StatusBarView
                android:id="@+id/statusBar1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/btnBack"
                singleClick="@{(v)->layout.back()}"
                android:layout_width="48dp"
                android:layout_height="@dimen/action_bar_size"
                android:paddingVertical="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_back_left"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/statusBar1" />
        </LinearLayout>

    </FrameLayout>
</layout>