<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.creator.character.CharactersViewModel" />

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <include
                    layout="@layout/layout_story_board_header"
                    app:step="@{`2`}" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_white_rectangle_top_corner_r16"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="16dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            style="@style/Text.Common"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:text="@{`识别到`+layout.characterCount+`个角色`}"
                            android:textSize="14sp"
                            tools:text="识别到4个角色" />

                        <Button
                            android:id="@+id/btnAddRole"
                            style="@style/Button.Bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            singleClick="@{layout.clickHandler::onClick}"
                            android:layout_gravity="end|center_vertical"
                            android:drawableStart="@drawable/ic_add_tran30"
                            android:drawablePadding="4dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="新增"
                            android:textSize="12sp" />
                    </FrameLayout>

                    <com.kgmedia.fastfilm.widget.LoadStateViewHolder
                        android:id="@+id/loadStateViewHolder"
                        setLoadState="@{layout.showHelp}"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:adapter="@{layout.MAdapterVm.MAdapter}"
                            android:nestedScrollingEnabled="false" />
                    </com.kgmedia.fastfilm.widget.LoadStateViewHolder>

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <Button
            android:id="@+id/generating"
            style="@style/Button.Bold"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginHorizontal="34dp"
            android:layout_marginBottom="22dp"
            android:background="@{layout.generationSuccess?@drawable/btn_common_dark_normal:@drawable/btn_common_dark_disable}"
            android:text="生成画面" />
    </FrameLayout>

</layout>