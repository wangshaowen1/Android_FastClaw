<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:background="@color/black">

        <!-- ============ 欢迎气泡 ============ -->
        <!-- 气泡底:小虾从顶部探出 26dp,故顶部下移 26dp,底边对齐毛玻璃卡底边 -->
        <View
            android:id="@+id/v_welcome_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_msg_agent_left"
            app:layout_constraintBottom_toBottomOf="@id/card_services"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_shrimp"
            android:layout_width="152dp"
            android:layout_height="152dp"
            android:src="@drawable/img_home_shrimp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_shrimp_tip1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="50dp"
            android:fontFamily="@font/alimama_shu_hei_ti_bold"
            android:text="@string/home_welcome_greeting"
            android:textColor="@color/color_90_000000"
            android:textSize="20sp"
            app:layout_constraintEnd_toStartOf="@id/iv_shrimp"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="你好，我是小虾" />

        <TextView
            android:id="@+id/tv_shrimp_tip2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/home_welcome_intro"
            android:textColor="@color/color_76_3c3c43"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="@id/tv_shrimp_tip1"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@id/tv_shrimp_tip1"
            app:layout_constraintTop_toBottomOf="@id/tv_shrimp_tip1"
            tools:text="你的职业经纪人，我能帮你：" />

        <!-- 毛玻璃服务卡:垂直摆放 3 个白色胶囊 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/card_services"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_home_welcome_glass"
            android:paddingHorizontal="16dp"
            android:paddingVertical="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_shrimp_tip2">

            <!-- 行1:24小时找工作 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/pill_find_job"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ffffff_r100"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/iv_find_job"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_service_find_job"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/home_service_find_job_title"
                    android:textColor="@color/color_90_000000"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_find_job"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_service_find_job_desc"
                    android:textColor="@color/color_56_3c3c43"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 行2:面试辅导 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/pill_interview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ffffff_r100"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/pill_find_job">

                <ImageView
                    android:id="@+id/iv_interview"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_service_interview"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/home_service_interview_title"
                    android:textColor="@color/color_90_000000"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_interview"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_service_interview_desc"
                    android:textColor="@color/color_56_3c3c43"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 行3:简历优化 -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/pill_resume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ffffff_r100"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/pill_interview">

                <ImageView
                    android:id="@+id/iv_resume"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_service_resume"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/home_service_resume_title"
                    android:textColor="@color/color_90_000000"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@id/iv_resume"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_service_resume_desc"
                    android:textColor="@color/color_56_3c3c43"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>