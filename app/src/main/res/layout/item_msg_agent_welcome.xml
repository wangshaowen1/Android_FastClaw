<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:background="@color/black">

        <com.shiyuan.fastclaw.widget.shape.SuperConstraintLayout
            android:id="@+id/cl_company_background_outer"
            android:layout_width="match_parent"
            android:layout_height="155dp"
            android:layout_marginTop="56dp"
            app:background_normalColor="#F9FAFE"
            app:border_color="@color/color_ffffff"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:super_corner="20dp"
            app:view_border_width="1dp" />

        <ImageView
            android:id="@+id/iv_shrimp"
            android:layout_width="162dp"
            android:layout_height="126dp"
            android:layout_marginTop="30dp"
            android:src="@drawable/img_home_shrimp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_shrimp_tip1"
            android:layout_width="139dp"
            android:layout_height="22dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="27dp"
            android:src="@drawable/ic_home_hello"
            app:layout_constraintEnd_toStartOf="@id/iv_shrimp"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/cl_company_background_outer"
            tools:text="你好，我是小虾" />

        <TextView
            android:id="@+id/tv_shrimp_tip2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/str_agent_welcome_subtitle"
            android:textColor="@color/color_76_3c3c43"
            android:textSize="14sp"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="@id/iv_shrimp_tip1"
            app:layout_constraintTop_toBottomOf="@id/iv_shrimp_tip1"
            tools:text="你的AI求职经纪人" />

        <!-- 毛玻璃服务卡:垂直摆放 3 个白色胶囊 -->
        <com.shiyuan.fastclaw.widget.shape.SuperConstraintLayout
            android:id="@+id/card_services"
            android:layout_width="0dp"
            android:layout_height="65dp"
            app:background_colorOrientation="top_bottom"
            app:background_endColor="#FFFFFF"
            app:background_startColor="#EEF5FE"
            app:border_color="@color/color_ffffff"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:super_corner="20dp"
            app:view_border_width="1dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/str_agent_welcome_service_desc"
                android:textColor="@color/color_76_3c3c43"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="我能帮你查公司、定制押题、提升面试通过率" />

        </com.shiyuan.fastclaw.widget.shape.SuperConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
