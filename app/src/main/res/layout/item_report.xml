<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="item"
            type="com.shiyuan.fastclaw.feature.report.ItemReportVM" />
    </data>

    <RelativeLayout
        singleClick="@{()->item.onItemClick()}"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_white_rectangle_corner_r12"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        tools:layout_marginHorizontal="16dp">

        <LinearLayout
            android:visibility="@{item.isInProgress() ? View.VISIBLE : View.GONE}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv"
                app:autoRotate="@{item.isInProgress()}"
                android:layout_gravity="center_vertical"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_spin_circles">

            </ImageView>

            <LinearLayout
                android:layout_marginLeft="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{item.reportName}"
                    android:textColor="@color/color_1a1a1a"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="面试作战报告" />

                <ProgressBar
                    android:layout_marginTop="8dp"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="180dp"
                    android:layout_height="5dp"
                    android:max="100"
                    tools:progress="30"
                    android:progress="@{item.progress}"
                    android:progressDrawable="@drawable/progress_generating" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@{item.estimateMessage}"
                    android:textColor="@color/color_999999"
                    android:textSize="11sp"
                    tools:text="预计还需2分钟，请耐心等待" />

            </LinearLayout>


        </LinearLayout>


        <LinearLayout
            android:visibility="@{item.isOther() ? View.VISIBLE : View.GONE}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <com.shiyuan.fastclaw.widget.progress.CircleProgressView
                android:layout_gravity="center_vertical"
                android:id="@+id/circleProgress"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cpv_strokeWidth="5dp"
                app:cpv_progressColor="@{item.progressBgC}"
                app:cpv_backgroundColor="@{item.progressBg}"
                app:cpv_text="@{item.totalScore.toString()}"
                app:cpv_progress="@{item.totalScore}"
                app:cpv_textColor="@color/color_1a1a1a"
                app:cpv_textSize="16sp"
                />

            <LinearLayout
                android:layout_weight="1"
                android:layout_marginLeft="12dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tv_title"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tv_tag"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@{item.reportNameCompanyName}"
                        android:textColor="@color/color_1a1a1a"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="面试作战报告面试作战" />


                    <TextView
                        app:layout_constrainedWidth="true"
                        app:layout_constraintStart_toEndOf="@id/tv_title"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:id="@+id/tv_tag"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="8dp"
                        android:paddingVertical="3dp"
                        android:paddingHorizontal="6dp"
                        app:backgroundRes="@{item.textBg}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{item.tex}"
                        android:textColor="@{item.textC}"
                        android:textSize="10sp"
                        tools:text="新手小白" />
                </androidx.constraintlayout.widget.ConstraintLayout>



                <TextView
                    android:visibility="@{item.isJobTitleStd ? View.GONE : View.VISIBLE}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@{item.jobTitleStd}"
                    android:textColor="@color/color_999999"
                    android:textSize="11sp"
                    tools:text="目标岗位：AI产品经理" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@{item.stTime}"
                    android:textColor="@color/color_999999"
                    android:textSize="11sp"
                    tools:text="上传简历于 2026.05.07" />

            </LinearLayout>


            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right" />


        </LinearLayout>


        <LinearLayout
            android:visibility="@{item.isFailed() ? View.VISIBLE : View.GONE}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_failed"
                android:layout_gravity="center_vertical"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_up_failed">

            </ImageView>

            <LinearLayout
                android:layout_weight="1"
                android:layout_marginLeft="12dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{item.reportName}"
                    android:textColor="@color/color_1a1a1a"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="面试作战报告" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@{item.estimateMessage}"
                    android:textColor="@color/color_999999"
                    android:textSize="11sp"
                    tools:text="预计还需2分钟，请耐心等待" />

            </LinearLayout>

            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right" />

        </LinearLayout>

        <!--!&#45;&#45; 左侧分数圆圈/加载图标 &ndash;&gt;
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp">

            &lt;!&ndash; 生成中状态: 加载图标 &ndash;&gt;
                <View
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@color/color_04_000000"
                    android:visibility="@{item.isGenerating ? View.VISIBLE : View.GONE}" />

            &lt;!&ndash; 已完成状态: 分数圆圈 &ndash;&gt;
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_score_circle"
                android:visibility="@{item.isCompleted ? View.VISIBLE : View.GONE}">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@{item.scoreText}"
                    android:textColor="@color/color_1a1a1a"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="88" />
            </FrameLayout>
        </FrameLayout>

        &lt;!&ndash; 中间内容区域 &ndash;&gt;
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            &lt;!&ndash; 第一行: 标题 + 标签 &ndash;&gt;
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{item.titleText}"
                    android:textColor="@color/color_1a1a1a"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="面试作战报告" />

                &lt;!&ndash; 标签 &ndash;&gt;
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_tag_green"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:text="@{item.tagText}"
                    android:textColor="@color/func_success_dark"
                    android:textSize="10sp"
                    android:visibility="@{item.tagVisible ? View.VISIBLE : View.GONE}"
                    tools:text="天作之合" />
            </LinearLayout>

            &lt;!&ndash; 第二行: 公司名 + 岗位 &ndash;&gt;
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@{item.companyNameText}"
                android:textColor="@color/color_1a1a1a"
                android:textSize="13sp"
                android:visibility="@{item.isCompleted ? View.VISIBLE : View.GONE}"
                tools:text="深圳快歌智能有限公司" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@{item.positionText}"
                android:textColor="@color/color_666666"
                android:textSize="13sp"
                android:visibility="@{item.isCompleted ? View.VISIBLE : View.GONE}"
                tools:text="目标岗位：AI产品经理" />

            &lt;!&ndash; 生成中: 进度条 &ndash;&gt;
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:visibility="@{item.isGenerating ? View.VISIBLE : View.GONE}">

                <ProgressBar
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="180dp"
                    android:layout_height="5dp"
                    android:max="100"
                    android:progress="30"
                    android:progressDrawable="@drawable/progress_generating" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@{item.progressText}"
                    android:textColor="@color/color_999999"
                    android:textSize="11sp"
                    tools:text="预计还需2分钟，请耐心等待" />
            </LinearLayout>

            &lt;!&ndash; 已完成: 日期 &ndash;&gt;
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@{item.dateText}"
                android:textColor="@color/color_999999"
                android:textSize="11sp"
                android:visibility="@{item.isCompleted ? View.VISIBLE : View.GONE}"
                tools:text="上传简历于 2026.05.07" />
        </LinearLayout>

        &lt;!&ndash; 右侧箭头 &ndash;&gt;
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:importantForAccessibility="no"
            android:src="@drawable/arrow_right_gray36" />-->
    </RelativeLayout>
</layout>
