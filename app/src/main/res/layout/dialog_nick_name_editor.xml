<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.settings.personal.PersonalInformationViewModel" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_white_rectangle_top_corner_r24"
        android:gravity="center_horizontal"
        android:orientation="vertical">


        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="修改昵称"
            android:textColor="@color/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/inputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_f5f5f5_r12"
            app:layout_constraintTop_toBottomOf="@id/tv_title">

            <com.kgmedia.fastfilm.widget.RestrictedEditText
                android:id="@+id/etNickname"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:gravity="center_vertical"
                android:hint="@string/enter_your_nickname"
                android:inputType="text"
                style="@style/Text.Bold"
                android:maxLength="10"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:paddingVertical="17dp"
                android:text="@={layout.editNickname}"
                android:textColor="@color/textColorPrimary"
                android:textColorHint="@color/textColorSecondary"
                android:textCursorDrawable="@drawable/color_cursor"
                android:textSize="16sp"
                app:layout_constraintEnd_toStartOf="@id/iv_close"
                app:layout_constraintStart_toStartOf="parent" />

            <ImageView
                android:id="@+id/iv_close"
                singleClick="@{layout::clearNickname}"
                android:layout_width="58dp"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:importantForAccessibility="no"
                android:paddingVertical="16dp"
                android:src="@drawable/ic_clear_input"
                android:visibility="@{layout.editNickname.empty?View.GONE:View.VISIBLE}"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            app:layout_constraintTop_toBottomOf="@id/inputLayout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="36dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="44dp">

            <Button
                android:id="@+id/tv_cancel"
                android:onClick="@{layout.clickHandler::onClick}"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/btn_common_cancel"
                android:gravity="center"
                android:text="@string/cancel"
                style="@style/Button.Bold"
                android:textColor="@color/textColorPrimary"
                app:layout_constraintBottom_toBottomOf="@id/siv_back"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/siv_back"
                tools:enabled="true" />

            <Button
                android:id="@+id/tv_confirm"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                style="@style/Button.Bold"
                android:enabled="@{!layout.editNickname.empty}"
                android:gravity="center"
                android:text="@string/confirm"
                app:layout_constraintBottom_toBottomOf="@id/siv_back"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/siv_back"
                tools:enabled="true" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>