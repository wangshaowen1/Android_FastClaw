<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kgmedia.fastfilm.feature.editor.regenerate.ItemStoryboardRoleVM" />
    </data>

    <com.kgmedia.fastfilm.widget.BorderConstraintLayout
        showBorder="@{item.selected}"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="15dp"
        android:onClick="@{(v)->item.select()}"
        app:borderEndColor="@color/color_ffa029"
        app:borderStartColor="@color/color_ff4332"
        app:borderWidth="2dp"
        app:roundCornerRadius="10dp">

        <com.kgmedia.fastfilm.widget.roundedimageview.RoundedImageView
            android:id="@+id/ivAvatar"
            loadThumbnailUri="@{item.data.roleImageUrl}"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="104:138"
            app:layout_constraintTop_toTopOf="parent"
            app:riv_corner_radius="10dp"
            tools:src="@color/color_20_000000" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_50_000000_br10"
            android:gravity="center"
            android:text="@{item.data.roleName}"
            android:textColor="@android:color/white"
            android:textSize="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/ivAvatar"
            app:layout_constraintStart_toStartOf="@+id/ivAvatar"
            tools:text="张小凡" />
    </com.kgmedia.fastfilm.widget.BorderConstraintLayout>

</layout>