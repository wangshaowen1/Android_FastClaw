<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:layout_height="337dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="337dp">

        <View
            android:id="@+id/bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_flash_new_login_panel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="46dp"
            android:layout_height="54dp"
            android:importantForAccessibility="no"
            android:paddingStart="6dp"
            android:paddingTop="11dp"
            android:paddingEnd="14dp"
            android:paddingBottom="17dp"
            android:scaleType="center"
            android:src="@drawable/ic_flash_new_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/iv_login_mobile_phone_number"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="133dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/flash_new_other_phone_login"
            android:textColor="@color/color_96_000000"
            android:textSize="13sp"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="其他手机号登录 &gt;" />

        <ImageView
            android:id="@+id/iv_login_wx"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="245dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_phone_new_login_wechat"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
