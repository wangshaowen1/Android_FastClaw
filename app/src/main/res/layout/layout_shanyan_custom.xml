<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    tools:layout_height="337dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="337dp">

        <View
            android:id="@+id/bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_flash_new_login_panel"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="46dp"
            android:layout_height="54dp"
            android:importantForAccessibility="no"
            android:paddingStart="6dp"
            android:paddingTop="11dp"
            android:paddingEnd="14dp"
            android:paddingBottom="17dp"
            android:scaleType="center"
            android:src="@drawable/ic_flash_new_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/iv_login_mobile_phone_number"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="133dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/flash_new_other_phone_login"
            android:textColor="@color/color_96_000000"
            android:textSize="13sp"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="其他手机号登录 &gt;" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutPolicy"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="185dp"
            android:layout_marginEnd="23dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivPolicyCheck"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/icon_checkbox_unchecked"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvPolicyText" />

            <TextView
                android:id="@+id/tvPolicyText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/color_90_000000"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ivPolicyCheck"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="已阅读并同意《快龙虾用户协议》、《隐私政策》以及《中国移动认证服务条款》" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/iv_login_wx"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="245dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_phone_new_login_wechat"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
