<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kgmedia.fastfilm.feature.mine.drafts.ItemShortDramaInfoWorksVm" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        singleClick="@{(v)->item.onItemClick()}"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_white_rectangle_corner_r12"
        android:padding="10dp"
        tools:layout_marginBottom="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/siv_picture"
            loadThumbnailUri="@{item.data.dramasCoverUrl}"
            placeHolder="@{@drawable/ic_default_cover}"
            android:layout_width="60dp"
            android:layout_height="80dp"
            android:background="@drawable/ic_default_cover"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/roundStyle_r4" />

        <View
            setVisible="@{item.data.workStatus==3}"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_60_000000_r4"
            app:layout_constraintBottom_toBottomOf="@id/siv_picture"
            app:layout_constraintEnd_toEndOf="@id/siv_picture"
            app:layout_constraintStart_toStartOf="@id/siv_picture"
            app:layout_constraintTop_toTopOf="@id/siv_picture" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:src="@{item.data.workStatus==2?@drawable/ic_short_drama_generate_failed:@drawable/ic_short_drama_part_generate_failed}"
            android:visibility="@{item.isFailed(item.data.workStatus)?View.VISIBLE:View.GONE}"
            app:layout_constraintBottom_toBottomOf="@id/siv_picture"
            app:layout_constraintEnd_toEndOf="@id/siv_picture"
            app:layout_constraintStart_toStartOf="@id/siv_picture"
            app:layout_constraintTop_toTopOf="@id/siv_picture"
            tools:src="@drawable/ic_short_drama_part_generate_failed" />


        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@{item.title}"
            android:textColor="@color/color_121212"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/generationStatus"
            app:layout_constraintEnd_toStartOf="@id/complete"
            app:layout_constraintStart_toEndOf="@id/siv_picture"
            app:layout_constraintTop_toTopOf="@id/siv_picture"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="小滋滋的日常" />


        <TextView
            android:id="@+id/tv_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp"
            android:text="@{item.time}"
            android:textColor="@color/color_50_121212"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="@id/siv_picture"
            app:layout_constraintEnd_toStartOf="@id/complete"
            app:layout_constraintStart_toEndOf="@id/siv_picture"
            app:layout_constraintTop_toBottomOf="@id/generationStatus"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="2025.09.12 制作" />

        <TextView
            android:id="@+id/generationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="@{item.statusText()}"
            android:textColor="#737373"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@id/tv_time"
            app:layout_constraintStart_toStartOf="@id/tv_title"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="画面生成失败" />

        <Button
            android:id="@+id/complete"
            style="@style/Button.Bold"
            singleClick="@{(it)->item.complete()}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@{item.isSuccess(item.data.workStatus)?@drawable/selector_common_button:@drawable/btn_common_stroke}"
            android:paddingHorizontal="21dp"
            android:paddingVertical="6dp"
            android:text="@{item.isSuccess(item.data.workStatus)?`去发布`:`去完成`}"
            android:textColor="@{item.isSuccess(item.data.workStatus)?@color/white:@color/color_ff4b00}"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="去发布" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>