<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.download.DownloadingViewModel" />

        <import type="android.view.View" />
    </data>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_80_121212_r12"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingVertical="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{layout.statusHolder.downloadProgress+`%`}"
            android:textColor="@android:color/white"
            android:textSize="12dp"
            tools:text="32%" />

        <TextView
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/dialog_downloading_in_progress"
            android:textColor="@android:color/white"
            android:textSize="12dp" />

        <TextView
            singleClick="@{(v)->layout.statusHolder.cancelDownload()}"
            android:layout_width="72dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_20_ffffff_r50"
            android:gravity="center"
            android:text="@string/cancel"
            android:textColor="@android:color/white"
            android:textSize="14dp" />
    </LinearLayout>

</layout>