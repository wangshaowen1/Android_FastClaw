<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.editor.ShortDramaEditorViewModel" />

        <import type="android.text.TextUtils" />

        <import type="com.kgmedia.fastfilm.common.ext.TextViewExtKt" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.kgmedia.fastfilm.widget.LoadStateViewHolder
            displayChild="@{layout.loadState}"
            onRetry="@{()->layout.getStoryboardInfo(false)}"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.kgmedia.fastfilm.widget.StatusBarView
                    android:id="@+id/statusBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.Placeholder
                    android:id="@+id/previewArea"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintDimensionRatio="9:16"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/image"
                    loadUri="@{layout.currentSegment.data.image?layout.currentSegment.data.shotSegmentImageUrl:null}"
                    setDimensionRatio="@{layout.shortDrama.videoRatioValue}"
                    setVisible="@{layout.currentSegment.data.generated &amp;&amp; layout.currentSegment.data.image}"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:onClick="@{(v)->layout.play()}"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="@+id/previewArea"
                    app:layout_constraintEnd_toEndOf="@+id/previewArea"
                    app:layout_constraintStart_toStartOf="@+id/previewArea"
                    app:layout_constraintTop_toTopOf="@+id/previewArea"
                    tools:layout_constraintDimensionRatio="16:9" />

                <TextView
                    marginTopDp="@{layout.shortDrama.videoRatio==1?94:12}"
                    setVisible="@{layout.currentSegment.data.generated &amp;&amp; layout.currentSegment.data.image}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:shadowColor="@color/color_40_000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="3.0"
                    android:text="AI生成"
                    android:textColor="@color/color_50_ffffff"
                    android:textSize="12dp"
                    app:layout_constraintEnd_toEndOf="@+id/image"
                    app:layout_constraintTop_toTopOf="@+id/image"
                    tools:layout_marginTop="12dp" />

                <ImageView
                    setVisible="@{!layout.playing}"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_short_drama_editor_play"
                    app:layout_constraintBottom_toBottomOf="@+id/previewArea"
                    app:layout_constraintEnd_toEndOf="@+id/previewArea"
                    app:layout_constraintStart_toStartOf="@+id/previewArea"
                    app:layout_constraintTop_toTopOf="@+id/previewArea" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    setDimensionRatio="@{layout.shortDrama.videoRatioValue}"
                    setVisible="@{layout.currentSegment.data != null &amp;&amp; !layout.currentSegment.data.generated}"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@color/color_10_ffffff"
                    android:gravity="center"
                    android:onClick="@{(v)->layout.play()}"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@+id/previewArea"
                    app:layout_constraintEnd_toEndOf="@+id/previewArea"
                    app:layout_constraintStart_toStartOf="@+id/previewArea"
                    app:layout_constraintTop_toTopOf="@+id/previewArea"
                    tools:layout_constraintDimensionRatio="16:9">

                    <TextView
                        android:id="@+id/tvStoryboardStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{layout.currentSegment.genStatusBig(layout.currentSegment.data.genStatus)}"
                        android:textColor="?colorPrimary"
                        android:textSize="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="图片生成排队中" />

                    <TextView
                        setVisible="@{layout.currentSegment.data.generating}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="退出后会继续生成"
                        android:textColor="?colorAccent"
                        android:textSize="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvStoryboardStatus" />

                    <TextView
                        android:id="@+id/btnRetry"
                        setVisible="@{layout.currentSegment.data.failed}"
                        singleClick="@{() -> layout.retryGenerate()}"
                        android:layout_width="90dp"
                        android:layout_height="32dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/btn_common_dark_normal"
                        android:gravity="center"
                        android:text="点击重试"
                        android:textColor="?colorPrimary"
                        android:textSize="12dp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvStoryboardStatus"
                        tools:visibility="visible" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:background="@drawable/gradient_top_00_000000_bottom_80_000000"
                    app:layout_constraintBottom_toTopOf="@+id/bottom"
                    app:layout_constraintDimensionRatio="375:200" />

                <androidx.constraintlayout.widget.Placeholder
                    android:id="@+id/bottom"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="375:72" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/previewArea"
                    app:layout_constraintEnd_toEndOf="@+id/previewArea"
                    app:layout_constraintStart_toStartOf="@+id/previewArea"
                    app:layout_constraintTop_toTopOf="@+id/previewArea"
                    app:layout_constraintVertical_bias="0.75">

                    <com.kgmedia.fastfilm.widget.MarqueeTextView
                        android:id="@+id/tvSubtitle"
                        changeText="@{TextViewExtKt.parseRoleTagsModernPlain(layout.currentSegmentSubtitle.subtitleContent)}"
                        duration="@{layout.currentSegmentAudioDuration}"
                        startMarquee="@{layout.playing}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:paddingHorizontal="16dp"
                        android:shadowColor="@color/color_40_000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="3.0"
                        android:textColor="?colorPrimary"
                        android:textSize="20dp"
                        tools:text="手心忽然长出纠缠的曲线" />

                </FrameLayout>

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:text="视频时长约为"
                    android:textColor="?colorPrimary"
                    android:textSize="12dp"
                    app:layout_constraintBottom_toTopOf="@+id/rvStoryboard"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@{layout.durationText}"
                    android:textColor="@color/color_ff4b00"
                    android:textSize="12dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tvDuration"
                    app:layout_constraintStart_toEndOf="@+id/tvDuration"
                    tools:text="01:30(18个分镜)" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStoryboard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="10dp"
                    android:adapter="@{layout.adapter}"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:overScrollMode="never"
                    android:paddingStart="12dp"
                    android:paddingEnd="2dp"
                    android:scrollbars="none"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintBottom_toTopOf="@+id/bottom"
                    app:layout_constraintDimensionRatio="375:58"
                    tools:listitem="@layout/item_short_drama_editor_segment" />

                <View
                    android:id="@+id/btnDubbing"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@+id/bottom"
                    app:layout_constraintEnd_toEndOf="@+id/ivDubbing"
                    app:layout_constraintStart_toStartOf="@+id/ivDubbing"
                    app:layout_constraintTop_toTopOf="@+id/bottom"
                    app:layout_constraintWidth_percent="0.14" />

                <ImageView
                    android:id="@+id/ivDubbing"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_dubbing"
                    app:layout_constraintBottom_toBottomOf="@+id/bottom"
                    app:layout_constraintDimensionRatio="1"
                    app:layout_constraintEnd_toEndOf="@+id/bottom"
                    app:layout_constraintHorizontal_bias="0.174"
                    app:layout_constraintStart_toStartOf="@+id/bottom"
                    app:layout_constraintTop_toTopOf="@+id/bottom"
                    app:layout_constraintVertical_bias="0.25"
                    app:layout_constraintWidth_percent="0.064" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="字幕配音"
                    android:textColor="?colorAccent"
                    android:textSize="10dp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@+id/ivDubbing"
                    app:layout_constraintStart_toStartOf="@+id/ivDubbing"
                    app:layout_constraintTop_toBottomOf="@+id/ivDubbing" />

                <TextView
                    setVisible="@{layout.dubbing}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_dubbing"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:text="配音中..."
                    android:textColor="?colorPrimary"
                    android:textSize="8dp"
                    android:translationX="-5dp"
                    app:layout_constraintBottom_toTopOf="@+id/ivDubbing"
                    app:layout_constraintStart_toEndOf="@+id/ivDubbing" />

                <View
                    android:id="@+id/btnRegenerate"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@+id/bottom"
                    app:layout_constraintEnd_toEndOf="@+id/ivRegenerate"
                    app:layout_constraintStart_toStartOf="@+id/ivRegenerate"
                    app:layout_constraintTop_toTopOf="@+id/bottom"
                    app:layout_constraintWidth_percent="0.14" />

                <ImageView
                    android:id="@+id/ivRegenerate"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_segment_regenerate"
                    app:layout_constraintBottom_toBottomOf="@+id/bottom"
                    app:layout_constraintDimensionRatio="1"
                    app:layout_constraintEnd_toEndOf="@+id/bottom"
                    app:layout_constraintStart_toStartOf="@+id/bottom"
                    app:layout_constraintTop_toTopOf="@+id/bottom"
                    app:layout_constraintVertical_bias="0.25"
                    app:layout_constraintWidth_percent="0.064" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="重绘分镜"
                    android:textColor="?colorAccent"
                    android:textSize="10dp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@+id/ivRegenerate"
                    app:layout_constraintStart_toStartOf="@+id/ivRegenerate"
                    app:layout_constraintTop_toBottomOf="@+id/ivRegenerate" />

                <View
                    android:id="@+id/btnHistory"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@+id/bottom"
                    app:layout_constraintEnd_toEndOf="@+id/ivHistory"
                    app:layout_constraintStart_toStartOf="@+id/ivHistory"
                    app:layout_constraintTop_toTopOf="@+id/bottom"
                    app:layout_constraintWidth_percent="0.14" />

                <ImageView
                    android:id="@+id/ivHistory"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:src="@drawable/ic_segment_history"
                    app:layout_constraintBottom_toBottomOf="@+id/bottom"
                    app:layout_constraintDimensionRatio="1"
                    app:layout_constraintEnd_toEndOf="@+id/bottom"
                    app:layout_constraintHorizontal_bias="0.826"
                    app:layout_constraintStart_toStartOf="@+id/bottom"
                    app:layout_constraintTop_toTopOf="@+id/bottom"
                    app:layout_constraintVertical_bias="0.25"
                    app:layout_constraintWidth_percent="0.064" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="历史分镜"
                    android:textColor="?colorAccent"
                    android:textSize="10dp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@+id/ivHistory"
                    app:layout_constraintStart_toStartOf="@+id/ivHistory"
                    app:layout_constraintTop_toBottomOf="@+id/ivHistory" />

                <TextView
                    android:id="@+id/btnGenerate"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="16dp"
                    android:background="@{layout.nextStepEnabled?@drawable/btn_common_dark_normal:@drawable/btn_common_dark_disable}"
                    android:gravity="center"
                    android:paddingHorizontal="8dp"
                    android:text="合成视频"
                    android:textColor="@{layout.nextStepEnabled?@android:color/white:@color/color_30_ffffff}"
                    android:textSize="14dp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/statusBar"
                    tools:background="@drawable/btn_common_dark_disable"
                    tools:textColor="@color/color_30_ffffff" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.kgmedia.fastfilm.widget.LoadStateViewHolder>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.kgmedia.fastfilm.widget.StatusBarView
                android:id="@+id/statusBar1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/btnBack"
                singleClick="@{(v)->layout.back()}"
                android:layout_width="56dp"
                android:layout_height="@dimen/action_bar_size"
                android:paddingVertical="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_back"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/statusBar1" />
        </LinearLayout>

    </FrameLayout>
</layout>