<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.editor.ShortDramaEditorViewModel" />

        <import type="android.text.TextUtils" />

        <import type="com.kgmedia.fastfilm.common.ext.TextViewExtKt" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.kgmedia.fastfilm.widget.LoadStateViewHolder
            displayChild="@{layout.loadState}"
            onRetry="@{()->layout.getStoryboardInfo(false)}"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.kgmedia.fastfilm.widget.StatusBarView
                    android:id="@+id/statusBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/action_bar_size"
                    android:gravity="center"
                    android:text="代码纪元：觉醒指令"
                    android:textAppearance="@style/Text16"
                    android:textColor="?attr/textColor1"
                    app:layout_constraintTop_toBottomOf="@+id/statusBar" />

                <androidx.constraintlayout.widget.Placeholder
                    android:id="@+id/previewArea"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="20dp"
                    app:layout_constraintBottom_toTopOf="@+id/rvStoryboard"
                    app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

                <ImageView
                    android:id="@+id/image"
                    loadUri="@{layout.currentSegment.data.image?layout.currentSegment.data.shotSegmentImageUrl:null}"
                    setDimensionRatio="@{layout.shortDrama.videoRatioValue}"
                    setVisible="@{layout.currentSegment.data.generated &amp;&amp; layout.currentSegment.data.image}"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:onClick="@{(v)->layout.play()}"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="@+id/previewArea"
                    app:layout_constraintEnd_toEndOf="@+id/previewArea"
                    app:layout_constraintStart_toStartOf="@+id/previewArea"
                    app:layout_constraintTop_toTopOf="@+id/previewArea"
                    tools:layout_constraintDimensionRatio="16:9" />

                <ImageView
                    setVisible="@{layout.currentSegment.data.generated &amp;&amp; layout.currentSegment.data.image}"
                    android:layout_width="32dp"
                    android:layout_height="16dp"
                    android:layout_margin="8dp"
                    android:src="@drawable/icon_ai_label"
                    app:layout_constraintStart_toStartOf="@+id/image"
                    app:layout_constraintTop_toTopOf="@+id/image"
                    tools:text="AI生成" />

                <ImageView
                    setVisible="@{!layout.playing}"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_short_drama_editor_play"
                    app:layout_constraintBottom_toBottomOf="@+id/previewArea"
                    app:layout_constraintEnd_toEndOf="@+id/previewArea"
                    app:layout_constraintStart_toStartOf="@+id/previewArea"
                    app:layout_constraintTop_toTopOf="@+id/previewArea" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    setDimensionRatio="@{layout.shortDrama.videoRatioValue}"
                    setVisible="@{layout.currentSegment.data != null &amp;&amp; !layout.currentSegment.data.generated}"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@color/color_10_ffffff"
                    android:gravity="center"
                    android:onClick="@{(v)->layout.play()}"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@+id/previewArea"
                    app:layout_constraintEnd_toEndOf="@+id/previewArea"
                    app:layout_constraintStart_toStartOf="@+id/previewArea"
                    app:layout_constraintTop_toTopOf="@+id/previewArea"
                    tools:layout_constraintDimensionRatio="16:9">

                    <TextView
                        android:id="@+id/tvStoryboardStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{layout.currentSegment.genStatusBig(layout.currentSegment.data.genStatus)}"
                        android:textColor="?colorPrimary"
                        android:textSize="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="图片生成排队中" />

                    <TextView
                        setVisible="@{layout.currentSegment.data.generating}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="退出后会继续生成"
                        android:textColor="?colorAccent"
                        android:textSize="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvStoryboardStatus" />

                    <TextView
                        android:id="@+id/btnRetry"
                        setVisible="@{layout.currentSegment.data.failed}"
                        singleClick="@{() -> layout.retryGenerate()}"
                        android:layout_width="90dp"
                        android:layout_height="32dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/btn_common_dark_normal"
                        android:gravity="center"
                        android:text="点击重试"
                        android:textColor="?colorPrimary"
                        android:textSize="12dp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvStoryboardStatus"
                        tools:visibility="visible" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:background="?attr/fillColor1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/previewArea" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStoryboard"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="16dp"
                    android:adapter="@{layout.adapter}"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:overScrollMode="never"
                    android:paddingStart="12dp"
                    android:paddingEnd="2dp"
                    android:scrollbars="none"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintBottom_toTopOf="@+id/tvStoryboardDescTitle"
                    app:layout_constraintDimensionRatio="375:82"
                    tools:listitem="@layout/item_short_drama_editor_segment" />

                <TextView
                    android:id="@+id/tvStoryboardDescTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="分镜描述"
                    android:textAppearance="@style/Text14"
                    android:textColor="?attr/textColor1"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@+id/tvStoryboardDesc"
                    app:layout_constraintDimensionRatio="345:130"
                    app:layout_constraintStart_toStartOf="@+id/tvStoryboardDesc" />

                <TextView
                    android:id="@+id/tvStoryboardDesc"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginHorizontal="15dp"
                    android:background="@drawable/fill_color2_r8"
                    android:lineSpacingExtra="@dimen/lineSpacingExtraShort"
                    android:padding="12dp"
                    android:text="白天，史莱克学院后山茂密的森林，阳光穿透层层叠叠的树叶，在铺满落叶的空地上洒下斑驳光影。唐三与小舞相对而立，清风吹过。唐三微微领首，脚下升起数圈魂环，地面开始震动。唐三..."
                    android:textAppearance="@style/Text12"
                    android:textColor="?attr/textColor2"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toTopOf="@+id/btnRegenerate"
                    app:layout_constraintDimensionRatio="345:130" />

                <TextView
                    android:id="@+id/btnRegenerate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:drawableTop="@drawable/icon_ai_image"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:paddingVertical="16dp"
                    android:text="重绘分镜"
                    android:textAppearance="@style/Text12"
                    android:textColor="?attr/textColor3"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnDownload"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/btnDownload"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:drawableTop="@drawable/icon_download"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:paddingVertical="16dp"
                    android:text="下载视频"
                    android:textAppearance="@style/Text12"
                    android:textColor="?attr/textColor3"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnDelete"
                    app:layout_constraintStart_toEndOf="@+id/btnRegenerate" />

                <TextView
                    android:id="@+id/btnDelete"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:drawableTop="@drawable/icon_delete"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:paddingVertical="16dp"
                    android:text="删除分镜"
                    android:textAppearance="@style/Text12"
                    android:textColor="?attr/textColor3"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/btnDownload" />

                <TextView
                    android:id="@+id/btnGenerate"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="13dp"
                    android:background="@drawable/selector_common_button"
                    android:drawableStart="@drawable/icon_synthesis"
                    android:drawablePadding="4dp"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="合成"
                    android:textAppearance="@style/Text14"
                    android:textColor="?attr/textColor1"
                    app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
                    app:layout_constraintEnd_toEndOf="@+id/tvTitle"
                    app:layout_constraintTop_toTopOf="@+id/tvTitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.kgmedia.fastfilm.widget.LoadStateViewHolder>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.kgmedia.fastfilm.widget.StatusBarView
                android:id="@+id/statusBar1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/btnBack"
                singleClick="@{(v)->layout.back()}"
                android:layout_width="48dp"
                android:layout_height="@dimen/action_bar_size"
                android:paddingVertical="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_back_left"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/statusBar1" />
        </LinearLayout>

    </FrameLayout>
</layout>