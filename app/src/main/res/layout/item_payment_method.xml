<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.shiyuan.fastclaw.feature.payment.ItemPaymentMethodVm" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        singleClick="@{(v)->item.onItemClick.invoke(v)}"
        android:orientation="horizontal"
        tools:layout_marginBottom="10dp"
        android:padding="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@{item.data.icon}"
            tools:src="@drawable/ic_pm_alipay" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@{item.data.name}"
            tools:text="支付宝"
            android:textStyle="bold"
            android:textColor="@color/color_21213b"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/iv_selected_state"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@{item.select?@drawable/ic_choose_checked_energy_packet:@drawable/icon_choose_normal_dark}"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_choose_checked_energy_packet" />
    </LinearLayout>
</layout>
