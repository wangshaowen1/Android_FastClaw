<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.report.genner.GenerateReportViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_F5F8FC"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_model_toolbar"
            app:toolbar="@{layout.mToolbarVM2}" />


        <LinearLayout
            android:layout_marginTop="130dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            
            <ImageView
                android:id="@+id/iv"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_circle_progress"
                android:layout_width="60dp"
                android:layout_height="60dp">
            </ImageView>

            <TextView
                android:layout_marginTop="28dp"
                android:textStyle="bold"
                android:textColor="@color/color_1a1a1a"
                android:textSize="18sp"
                android:layout_gravity="center_horizontal"
                android:text="@string/report_analysis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>

            <TextView
                android:layout_marginTop="8dp"
                android:textStyle="bold"
                android:textColor="@color/color_999999"
                android:textSize="12sp"
                android:layout_gravity="center_horizontal"
                android:text="@string/report_analysis_r"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
            </TextView>


            <TextView
                android:layout_marginTop="50dp"
                android:id="@+id/tv_true"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="78dp"
                android:layout_marginRight="78dp"
                android:background="@drawable/bg_0099ff_r100"
                android:gravity="center"
                android:text="@string/check_later"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />


        </LinearLayout>


    </LinearLayout>

</layout>
