<?xml version="1.0" encoding="utf-8"?><!--选择话题-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.timbre.CreateCloneTimbreViewModel" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_f5f5f5_tr16"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="27dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="新建克隆音色"
            android:textColor="@color/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="15dp"
            android:onClick="@{()->layout.dismiss()}"
            android:padding="3dp"
            android:src="@drawable/ic_dialog_close_black"
            app:layout_constraintBottom_toBottomOf="@id/title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/title" />

        <TextView
            android:id="@+id/tvSubtitle1"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:text="试听当前录音片段"
            android:textColor="@color/textColorPrimary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_05_121212_r50"
            android:gravity="center"
            android:minWidth="64dp"
            android:minHeight="24dp"
            android:onClick="@{()->layout.playRecordAudio()}"
            app:layout_constraintBottom_toBottomOf="@id/tvSubtitle1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvSubtitle1">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@{layout.playing?@drawable/ic_play_state_pause48:@drawable/ic_play_state48}"
                tools:src="@drawable/ic_play_state48" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:gravity="center_vertical"
                android:text="@{layout.playTime}"
                android:textColor="@color/textColorPrimary"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="01:00" />
        </LinearLayout>

        <Button
            android:id="@+id/btnConfirm"
            style="@style/Button.Bold"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="38dp"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:text="确认克隆"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle1" />

        <TextView
            android:id="@+id/cost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="38dp"
            android:background="@drawable/bg_cost"
            android:paddingHorizontal="5dp"
            android:paddingVertical="3.5dp"
            android:textColor="@color/color_80_a64a00"
            android:textSize="9sp"
            android:textStyle="bold"
            android:visibility="@{layout.costData==null?View.GONE:View.VISIBLE}"
            android:text="@{layout.costData.formatCost}"
            app:layout_constraintBottom_toBottomOf="@id/btnConfirm"
            app:layout_constraintEnd_toEndOf="@id/btnConfirm"
            tools:text="免费次数：10" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="录制音色的时间越长，克隆得越像哦~"
            android:textColor="@color/color_50_121212"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnConfirm" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
