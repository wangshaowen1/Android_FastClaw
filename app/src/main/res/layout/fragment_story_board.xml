<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.creator.generate.StoryBoardViewModel" />

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />
    </data>

    <ViewAnimator
        displayChild="@{layout.displayChild}"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <include
                layout="@layout/layout_story_board_header"
                app:step="@{`1`}" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:text="故事章节："
                android:textColor="@color/textColorPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/nsv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="150dp"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/tvSSEContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:hint="正在为你加载故事章节，请稍候..."
                    android:text="@{layout.MSSEContent}"
                    android:textColor="@color/textColorPrimary"
                    android:textColorHint="@color/color_50_121212"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <include
                layout="@layout/layout_story_board_header"
                app:step="@{`1`}" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="160dp"
                android:drawableTop="@drawable/ic_loading_fail"
                android:drawablePadding="5dp"
                android:gravity="center"
                android:text="故事章节生成失败，请重新生成"
                android:textColor="@color/color_30_121212"
                android:textSize="14sp" />

            <androidx.legacy.widget.Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnDramaInfoRegenerate"
                style="@style/Button.Bold"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginHorizontal="34dp"
                android:layout_marginBottom="22dp"
                android:text="重新生成" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <include
                        layout="@layout/layout_story_board_header"
                        app:step="@{`1`}" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:text="故事章节："
                        android:textColor="@color/textColorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.kgmedia.fastfilm.widget.expandtextview.ExpandableTextView
                        android:id="@+id/expandTextView"
                        expandContent="@{layout.MContent}"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/color_70_121212"
                        android:textSize="14sp"
                        app:collapseLines="2"
                        app:expandDrawable="@drawable/ic_edit_gray48"
                        app:expandTipLabel=""
                        app:expandable="false"
                        app:tipPosition="align_right" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="16dp"
                        android:text="故事角色："
                        android:textColor="@color/textColorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.kgmedia.fastfilm.widget.TagLayout
                        android:id="@+id/tagLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="8dp"
                        app:cacheMode="none"
                        app:horizontalSpace="12dp"
                        app:tagBackground="@drawable/bg_05_121212_r6"
                        app:tagSelectMode="none"
                        app:tagTextColor="@color/textColorPrimary"
                        app:tagTextHorizontalPadding="12dp"
                        app:tagTextMaxLine="1"
                        app:tagTextSize="12sp"
                        app:tagTextVerticalPadding="3dp"
                        app:verticalSpace="12dp" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_ffffff_top_r16">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingBottom="50dp"
                            android:visibility="@{layout.loadingStoryboardState==0?View.VISIBLE:View.GONE}">

                            <com.airbnb.lottie.LottieAnimationView
                                android:layout_width="84dp"
                                android:layout_height="84dp"
                                android:layout_gravity="center_horizontal"
                                app:lottie_autoPlay="true"
                                app:lottie_loop="true"
                                app:lottie_rawRes="@raw/lottie_queue_loading"
                                app:lottie_repeatMode="restart" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:id="@+id/tvLoadingStateText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="20dp"
                                    android:gravity="center"
                                    android:text="分镜加载中..."
                                    android:textColor="@color/textColorPrimary"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvLoadingProgress"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="20dp"
                                    android:gravity="center"
                                    android:text="@{layout.loadingProgress+`%`}"
                                    android:textColor="@color/color_ff3f3f"
                                    android:textSize="14sp"
                                    android:textStyle="bold"
                                    tools:text="23%" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="9dp"
                                android:gravity="center"
                                android:text="正在生成，请勿离开当前页面"
                                android:textColor="@color/color_30_121212"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:drawableTop="@drawable/ic_loading_fail"
                            android:drawablePadding="5dp"
                            android:gravity="center"
                            android:text="分镜生成失败，请重新生成"
                            android:textColor="@color/color_30_121212"
                            android:textSize="14sp"
                            android:visibility="@{layout.loadingStoryboardState==-1?View.VISIBLE:View.GONE}" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:visibility="@{layout.loadingStoryboardState==1?View.VISIBLE:View.GONE}">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:padding="16dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@{layout.totalStoryBoardCount+``}"
                                    android:textColor="@color/color_ff4b00"
                                    android:textSize="12sp"
                                    tools:text="19" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="个分镜"
                                    android:textColor="@color/textColorPrimary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recyclerView"
                                setLinearLayoutManager="@{true}"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:adapter="@{layout.adapter}"
                                tools:itemCount="0"
                                tools:listitem="@layout/item_storyboard_info" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="92dp"
                    android:background="@drawable/gradient_00_ffffff" />

                <Button
                    android:id="@+id/btnGenerate"
                    style="@style/Button.Bold"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="34dp"
                    android:alpha="@{layout.loadingStoryboardState==0||(!layout.inputAllComplete&amp;&amp;layout.loadingStoryboardState!=-1)?0.5f:1f}"
                    android:text="@{layout.loadingStoryboardState==-1?`重新生成`:`确认生成`}" />
            </FrameLayout>
        </FrameLayout>

    </ViewAnimator>
</layout>