<?xml version="1.0" encoding="utf-8"?><!--选择话题-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.timbre.GenerateWaitingViewModel" />

        <import type="android.view.View" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_f5f5f5_tr24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="88dp"
            android:layout_marginBottom="92dp"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_loading_color" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/pb"
                    android:layout_width="78dp"
                    android:layout_height="78dp"
                    android:indeterminate="true"
                    app:indicatorColor="#2ee4e4"
                    app:indicatorInset="0dp"
                    app:indicatorSize="78dp"
                    app:trackColor="@android:color/transparent"
                    app:trackThickness="3dp" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="正在生成绘本中"
                android:textColor="@color/textColorPrimary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="52dp"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="预计需要 1-3 分钟，您可以先去别处逛逛，绘本完成后会自动出现在「我的」-「草稿箱」里"
                android:textColor="@color/color_50_121212"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_margin="9dp"
            android:padding="7dp"
            android:src="@drawable/ic_dialog_close_black" />
    </FrameLayout>
</layout>
