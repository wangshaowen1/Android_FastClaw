<?xml version="1.0" encoding="utf-8"?>
<com.shiyuan.fastclaw.widget.BorderConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ffffff_r12"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingBottom="28dp"
    tools:layout_width="296dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/terms_and_privacy"
        android:textAppearance="@style/Text16"
        android:textColor="@color/color_1a1a1a"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="30dp"
        android:layout_marginTop="10dp"
        android:textAppearance="@style/Text14"
        android:textColor="@color/color_1a1a1a"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"
        tools:text="欢迎使用快龙虾！
在使用本产品或服务前，请您认证阅读并理解本应用的《用户协议》和《隐私政策》的全部条款，以了解我们的服务内容和我们在收集和使用您相关个人信息时的处理规则。我们严格按照用户协议和隐私政策为您提供服务，保护您的个人信息。
“不同意”，您将无法使用我们的产品和服务。" />

    <TextView
        android:id="@+id/tvReject"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_40343443_r100"
        android:gravity="center"
        android:text="@string/disagree"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintDimensionRatio="3:1"
        app:layout_constraintEnd_toStartOf="@+id/tvAgree"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvContent" />

    <TextView
        android:id="@+id/tvAgree"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="30dp"
        android:background="@drawable/bg_0099ff_r100"
        android:gravity="center"
        android:text="@string/agree"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintDimensionRatio="3:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tvReject"
        app:layout_constraintTop_toBottomOf="@id/tvReject"
        app:layout_constraintTop_toTopOf="@+id/tvReject" />

</com.shiyuan.fastclaw.widget.BorderConstraintLayout>
