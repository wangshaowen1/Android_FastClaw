<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

    </data>
    <!-- ============ 上传气泡 ============ -->
    <com.shiyuan.fastclaw.widget.shape.SuperConstraintLayout
        android:background="@drawable/bg_msg_agent_left"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        app:background_normalColor="#FFFFFF"
        app:super_corner="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_upload_title"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/agent_resume_no_conversation_tip"
            android:textColor="@color/color_90_000000"
            android:textSize="15sp" />

        <!-- 上传按钮:沿用 id btn_upload_resume,图标+文案水平居中(packed 链) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btn_upload_resume"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_upload_resume_btn"
            android:paddingVertical="13dp"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_upload_title">

            <ImageView
                android:id="@+id/iv_upload_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_upload_resume"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tv_upload_btn"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tv_upload_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/home_upload_resume_btn"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_upload_icon"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_not_resume"
            app:layout_constraintTop_toBottomOf="@id/btn_upload_resume"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_width="wrap_content"
            android:paddingTop="12dp"
            android:visibility="gone"
            android:layout_height="wrap_content"
            android:text="@string/home_upload_resume_not"
            android:textColor="@color/color_75_3c3c43"
            android:textStyle="bold"
            android:textSize="13sp" />

    </com.shiyuan.fastclaw.widget.shape.SuperConstraintLayout>
</layout>
