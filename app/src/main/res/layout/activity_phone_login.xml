<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.login.phone.PhoneLoginViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/login_bg"
        android:orientation="vertical">

        <com.shiyuan.fastclaw.widget.StatusBarView
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/spacing_xl">

                <ImageView
                    android:id="@+id/iv_logo"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="@dimen/spacing_xl"
                    android:importantForAccessibility="no"
                    android:src="@mipmap/img_phone_login_logo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:fontFamily="@font/alimama_shu_hei_ti_bold"
                    android:text="@string/login_page_title"
                    android:textColor="@color/color_1a1919"
                    android:textSize="20sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iv_logo" />

                <LinearLayout
                    android:id="@+id/ll_phone"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="48dp"
                    android:background="@drawable/bg_login_input_phone"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/tv_title">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="24dp"
                        android:paddingEnd="@dimen/spacing_s"
                        android:text="@string/mobile_phone_prefix"
                        android:textColor="@color/login_input_hint"
                        android:textSize="16sp" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="@color/login_input_divider" />

                    <EditText
                        android:id="@+id/et_phone"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/login_phone_hint"
                        android:inputType="phone"
                        android:maxLength="11"
                        android:paddingHorizontal="@dimen/spacing_m"
                        android:text="@={layout.mobile}"
                        android:textColor="@color/color_1a1919"
                        android:textColorHint="@color/login_input_hint"
                        android:textCursorDrawable="@drawable/edittext_cursor"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_code"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/ll_phone">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_login_input_code"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/et_verify_code"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:hint="@string/login_code_hint"
                            android:inputType="number"
                            android:maxLength="4"
                            android:paddingHorizontal="@dimen/spacing_m"
                            android:text="@={layout.code}"
                            android:textColor="@color/color_1a1919"
                            android:textColorHint="@color/login_input_hint"
                            android:textCursorDrawable="@drawable/edittext_cursor"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnSend"
                        android:layout_width="109dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_login_code_btn"
                        android:enabled="@{layout.sendCodeEnable}"
                        android:gravity="center"
                        android:paddingHorizontal="@dimen/spacing_m"
                        android:text="@{layout.sendCodeText}"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/bt_verification_code_login"
                    android:layout_width="match_parent"
                    android:layout_height="47dp"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/bg_login_btn"
                    android:gravity="center"
                    android:text="@string/login_btn_text"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    app:layout_constraintTop_toBottomOf="@id/ll_code" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/ll_agreement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/spacing_xl"
            android:paddingBottom="@dimen/spacing_xl">

            <ImageView
                android:id="@+id/ivCheck"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@{layout.checkedPolicy?@drawable/icon_checkbox_checked:@drawable/icon_checkbox_unchecked}" />

            <TextView
                android:id="@+id/tv_agreement"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/login_agreement_text"
                android:textSize="11sp"
                tools:text="我已阅读并同意《快龙虾用户协议》和《隐私政策》" />
        </LinearLayout>
    </LinearLayout>
</layout>
