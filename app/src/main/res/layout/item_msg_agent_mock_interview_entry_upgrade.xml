<?xml version="1.0" encoding="utf-8"?>
<com.shiyuan.fastclaw.widget.shape.SuperConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_mock_interview_entry_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="13dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="21dp"
    app:background_normalColor="@color/color_70_ffffff"
    app:super_corner="16dp">

    <ImageView
        android:id="@+id/iv_title_icon"
        android:layout_width="28dp"
        android:layout_height="23dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_mock_interview_entry_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_mock_interview_header"
        android:layout_width="0dp"
        android:layout_height="23dp"
        android:layout_marginStart="10dp"
        android:gravity="center_vertical"
        android:text="@string/str_agent_mock_interview_upgrade_title"
        android:textColor="@color/color_90_000000"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/iv_title_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_title_icon"
        app:layout_constraintTop_toTopOf="@id/iv_title_icon" />

    <View
        android:id="@+id/v_divider"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginTop="8dp"
        android:background="@color/color_10_000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_title_icon" />

    <TextView
        android:id="@+id/tv_mock_interview_desc"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginStart="3dp"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:text="@string/str_agent_mock_interview_upgrade_desc"
        android:textColor="@color/color_90_000000"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_divider" />

    <com.shiyuan.fastclaw.widget.shape.SuperLinearLayout
        android:id="@+id/btn_action"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:background_normalColor="@color/color_2f6bff"
        app:super_corner="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_mock_interview_desc">

        <TextView
            android:id="@+id/tv_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/str_agent_mock_interview_upgrade_action"
            android:textColor="@color/color_ffffff"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_cost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginStart="3dp"
            android:text="@string/str_agent_mock_interview_action_cost"
            android:textColor="@color/color_ffffff"
            android:textSize="13sp" />
    </com.shiyuan.fastclaw.widget.shape.SuperLinearLayout>

    <TextView
        android:id="@+id/tv_skip"
        android:layout_width="0dp"
        android:layout_height="21dp"
        android:layout_marginStart="3dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/str_agent_mock_interview_skip"
        android:textColor="@color/color_75_3c3c43"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layout_action" />
</com.shiyuan.fastclaw.widget.shape.SuperConstraintLayout>
