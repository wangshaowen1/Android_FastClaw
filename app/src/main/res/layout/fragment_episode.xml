<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.mine.episode.EpisodeViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tv_listed"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@{layout.isLaunch?@drawable/bg_fef2e4_r6:@drawable/bg_ebebeb_r6}"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/listed"
                android:textColor="@{layout.isLaunch?@color/color_f57912:@color/color_979797}"
                android:textSize="12sp"
                tools:background="@drawable/bg_fef2e4_r6"
                tools:textColor="@color/color_f57912" />

            <TextView
                android:id="@+id/tv_not_listed"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="14dp"
                android:background="@{layout.isLaunch?@drawable/bg_ebebeb_r6:@drawable/bg_fef2e4_r6}"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/not_listed"
                android:textColor="@{layout.isLaunch?@color/color_979797:@color/color_f57912}"
                android:textSize="12sp"
                tools:background="@drawable/bg_ebebeb_r6"
                tools:textColor="@color/color_979797" />
        </LinearLayout>


        <androidx.viewpager.widget.ViewPager
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none" />
    </LinearLayout>
</layout>