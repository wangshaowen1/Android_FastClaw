<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.blankj.utilcode.util.ScreenUtils" />

        <import type="com.shiyuan.fastclaw.feature.message.data.ChatMessageDirection" />

        <variable
            name="item"
            type="com.shiyuan.fastclaw.feature.message.data.TextChatItem" />
    </data>

    <TextView
        android:id="@+id/tvContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@{item.direction == ChatMessageDirection.OUTGOING ? @drawable/bg_msg_user_right : @drawable/bg_msg_agent_left}"
        android:includeFontPadding="@{item.direction == ChatMessageDirection.OUTGOING}"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:text="@{item.content}"
        android:textColor="@{item.direction == ChatMessageDirection.OUTGOING ? @color/color_ffffff : @color/color_242424}"
        android:textSize="15sp"
        app:setMaxWidth="@{ScreenUtils.getScreenWidth() * 73 / 100}"
        tools:background="@drawable/bg_msg_agent_left"
        tools:text="你好。"
        tools:textColor="@color/color_242424" />
</layout>
