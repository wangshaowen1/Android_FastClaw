<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.settings.report.ReportDialogViewModel" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_color2_tr20"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_l">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m">

            <TextView
                android:id="@+id/title"
                style="@style/Text16"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="举报"
                android:textColor="?attr/textColor1" />

            <ImageView
                android:id="@+id/close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:importantForAccessibility="no"
                android:onClick="@{()->layout.dismiss()}"
                android:padding="3dp"
                android:src="@drawable/icon_close" />
        </FrameLayout>

        <TextView
            style="@style/Text14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="举报描述"
            android:textColor="?attr/textColor1" />

        <com.kgmedia.fastfilm.widget.XEditText
            android:id="@+id/xet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="120dp"
            android:background="@drawable/bg_06_ffffff_r8"
            android:hint="请描述具体原因，我们回尽快处理"
            android:gravity="top"
            android:maxLength="500"
            android:padding="@dimen/spacing_m"
            android:layout_marginTop="@dimen/spacing_xl"
            android:textColor="?attr/textColor2"
            android:textColorHint="?attr/textColor4"
            style="@style/Text14"/>

        <TextView
            style="@style/Text14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="联系方式"
            android:textColor="?attr/textColor1" />

        <com.kgmedia.fastfilm.widget.XEditText
            android:id="@+id/contact_person"
            style="@style/Text14"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="@dimen/spacing_m"
            android:background="@drawable/bg_06_ffffff_r8"
            android:hint="微信/QQ/电话/邮箱"
            android:maxLength="50"
            android:paddingHorizontal="@dimen/spacing_m"
            android:textColor="?attr/textColor2"
            android:textColorHint="?attr/textColor4" />

        <Button
            android:id="@+id/commit"
            style="@style/Text16"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:alpha="0.5"
            android:layout_marginBottom="34dp"
            android:layout_gravity="bottom"
            android:layout_marginTop="34dp"
            android:background="@drawable/gradient_left_73b0f8_right_7567f0_r100"
            android:text="提交" />
    </LinearLayout>
</layout>