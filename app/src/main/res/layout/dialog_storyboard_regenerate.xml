<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.editor.regenerate.StoryboardRegenerateViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ffffff_tr24"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="重绘分镜"
            android:textColor="@color/color_1a1a1a"
            android:textSize="16dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:text="画面描述"
            android:textColor="@color/color_121212"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

        <EditText
            android:id="@+id/etDesc"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_f5f5f5_r8"
            android:gravity="top"
            android:hint="请输入画面描述..."
            android:lineSpacingExtra="@dimen/lineSpacingExtra"
            android:maxLength="2000"
            android:paddingHorizontal="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="38dp"
            android:text="@={layout.content}"
            android:textColor="@color/color_121212"
            android:textColorHint="@color/color_50_121212"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintDimensionRatio="343:158"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDesc"
            tools:text="这里是描述，秒速五厘米总是挥之不去，我的世界什么时候秒速五厘米总是挥之不去" />

        <View
            singleClick="@{() -> layout.optimize()}"
            android:layout_width="0dp"
            android:layout_height="38dp"
            app:layout_constraintBottom_toBottomOf="@+id/btnOptimize"
            app:layout_constraintEnd_toEndOf="@+id/btnOptimize"
            app:layout_constraintStart_toStartOf="@+id/btnOptimize"
            app:layout_constraintTop_toTopOf="@+id/btnOptimize" />

        <TextView
            android:id="@+id/btnOptimize"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginStart="10dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/gradient_left_10_3e6bff_right_48b3ff_round"
            android:drawableStart="@drawable/ic_optimize36"
            android:drawablePadding="4dp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="重新优化"
            android:textColor="@color/color_619dff"
            android:textSize="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/etDesc"
            app:layout_constraintStart_toStartOf="@+id/etDesc" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:text="@{layout.content.length()+`/2000`}"
            android:textColor="@color/color_50_121212"
            android:textSize="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/btnOptimize"
            app:layout_constraintEnd_toEndOf="@id/etDesc"
            app:layout_constraintTop_toTopOf="@+id/btnOptimize"
            tools:text="36/2000" />

        <TextView
            android:id="@+id/tvRoles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="当前分镜角色"
            android:textColor="@color/color_121212"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/etDesc" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRoles"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:adapter="@{layout.adapter}"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:paddingStart="16dp"
            android:paddingEnd="6dp"
            android:scrollbars="none"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintDimensionRatio="375:112"
            app:layout_constraintTop_toBottomOf="@+id/tvRoles"
            tools:listitem="@layout/item_storyboard_role" />

        <View
            android:id="@+id/bottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/gradient_top_00_ffffff_bottom_ffffff"
            app:layout_constraintDimensionRatio="375:92"
            app:layout_constraintTop_toBottomOf="@+id/rvRoles" />

        <TextView
            setEnabled="@{layout.content.length()>0}"
            singleClick="@{() -> layout.regenerate()}"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/selector_common_button"
            android:gravity="center"
            android:text="确认"
            android:textColor="@color/sel_common_button_txt"
            android:textSize="16dp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/bottom"
            app:layout_constraintDimensionRatio="317:48"
            app:layout_constraintEnd_toEndOf="@+id/bottom"
            app:layout_constraintStart_toStartOf="@+id/bottom"
            app:layout_constraintTop_toTopOf="@+id/bottom"
            app:layout_constraintWidth_percent="0.85" />

        <ImageView
            singleClick="@{() -> layout.dismiss()}"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:padding="16dp"
            android:src="@drawable/ic_light_dialog_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>