<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kgmedia.fastfilm.feature.message.ItemMessageVM" />

        <import type="com.kgmedia.fastfilm.common.ext.FormatUtils" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        singleClick="@{(v)->item.onClick()}"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/icon"
            setImage="@{item.icon}"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginVertical="14dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.128"
            tools:src="@drawable/ic_message_watching" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@{item.title}"
            android:textColor="@color/color_90_121212"
            android:textSize="16dp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/content"
            app:layout_constraintStart_toEndOf="@+id/icon"
            app:layout_constraintTop_toTopOf="@+id/icon"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="追更" />

        <TextView
            android:id="@+id/content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:ellipsize="end"
            android:lines="1"
            android:text="@{item.data.message}"
            android:textColor="@color/color_50_121212"
            android:textSize="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/icon"
            app:layout_constraintEnd_toStartOf="@+id/count"
            app:layout_constraintStart_toStartOf="@+id/title"
            app:layout_constraintTop_toBottomOf="@+id/title"
            tools:text="李大哥 追了你的小说" />

        <TextView
            android:id="@+id/time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="@{item.createTime()}"
            android:textColor="@color/color_50_121212"
            android:textSize="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/title"
            tools:text="03-23 12:32" />

        <TextView
            android:id="@+id/count"
            setVisible="@{item.data.unreadNum>0}"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:background="@drawable/bg_ff363f_r50"
            android:gravity="center"
            android:minWidth="16dp"
            android:paddingHorizontal="3dp"
            android:text="@{FormatUtils.formatMessageNum(item.data.unreadNum)}"
            android:textColor="@color/white"
            android:textSize="12dp"
            app:layout_constraintBottom_toBottomOf="@+id/content"
            app:layout_constraintEnd_toEndOf="@id/time"
            app:layout_constraintTop_toTopOf="@+id/content"
            tools:text="99" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>