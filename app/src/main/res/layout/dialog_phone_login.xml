<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.login.flash.PhoneLoginViewModel" />

        <import type="android.view.View" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            marginBottomPx="@{layout.inputOffset}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ffffff_tr24">

            <ImageView
                android:id="@+id/iv_title"
                android:layout_width="wrap_content"
                android:layout_height="33dp"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:src="@{layout.isBind?@drawable/ic_bind_title:@drawable/ic_log_in_title}"
                app:layout_constraintBottom_toBottomOf="@id/btnClose"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/btnClose"
                tools:src="@drawable/ic_log_in_title" />

            <TextView
                android:id="@+id/tv_binding_prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/binding_prompt"
                android:textColor="@color/color_50_121212"
                android:textSize="12sp"
                android:visibility="@{layout.isBind?View.VISIBLE:View.GONE}"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_title"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/llPhone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="25dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_f5f5f5_r50"
                android:gravity="center_vertical"
                app:layout_constraintTop_toBottomOf="@+id/tv_binding_prompt">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:text="@string/mobile_phone_prefix"
                    android:textColor="@color/color_121212"
                    android:textSize="16sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:background="@color/color_10_21213b" />

                <EditText
                    android:id="@+id/et_phone"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/please_enter_your_phone_number"
                    android:inputType="phone"
                    android:maxLength="11"
                    android:paddingHorizontal="16dp"
                    android:text="@={layout.mobile}"
                    android:textColor="@color/color_121212"
                    android:textColorHint="@color/color_30_121212"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llCode"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_f5f5f5_r50"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="@+id/llPhone"
                app:layout_constraintStart_toStartOf="@+id/llPhone"
                app:layout_constraintTop_toBottomOf="@+id/llPhone">

                <EditText
                    android:id="@+id/et_verify_code"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/please_enter_the_verification_code"
                    android:inputType="number"
                    android:maxLength="4"
                    android:paddingHorizontal="16dp"
                    android:text="@={layout.code}"
                    android:textColor="@color/color_121212"
                    android:textColorHint="@color/color_30_121212"
                    android:textSize="14sp" />


                <TextView
                    android:id="@+id/btnSend"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:enabled="@{layout.sendCodeEnable}"
                    android:gravity="center"
                    android:padding="12dp"
                    android:text="@{layout.sendCodeText}"
                    android:textColor="@{layout.sendCodeEnable?@color/color_121212:@color/color_40_121212}"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="获取验证码"
                    tools:textColor="@color/color_121212" />
            </LinearLayout>

            <Button
                android:id="@+id/btnLogin"
                style="@style/Button.Bold"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginVertical="25dp"
                android:text="@{layout.isBind()?@string/bind_now:@string/log_in_now}"
                app:layout_constraintEnd_toEndOf="@+id/llPhone"
                app:layout_constraintStart_toStartOf="@+id/llPhone"
                app:layout_constraintTop_toBottomOf="@+id/llCode"
                tools:text="@string/log_in_now" />

            <LinearLayout
                android:id="@+id/btnPolicy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:onClick="@{layout.clickHandler::onClick}"
                android:visibility="@{layout.isBind()?View.GONE:View.VISIBLE}"
                app:layout_constraintBottom_toTopOf="@id/nav_bar_view"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnLogin">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@{layout.checkedPolicy?@drawable/ic_choose_checked:@drawable/ic_choose_normal_dark}"
                    tools:src="@drawable/ic_choose_normal_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="我已阅读并同意"
                    android:textColor="@color/color_30_000000"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnPrivacyPolicy"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="@string/tvPrivateService"
                    android:textColor="@color/color_292929"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="和"
                    android:textColor="@color/color_30_000000"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnUserPolicy"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="@string/tvUserService"
                    android:textColor="@color/color_292929"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.kgmedia.fastfilm.widget.NavBarView
                android:id="@+id/nav_bar_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnPolicy"
                app:layout_goneMarginTop="40dp" />

            <ImageView
                android:id="@+id/btnClose"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_login_dialog_close"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.kgmedia.fastfilm.widget.ToastView
                android:id="@+id/toast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0"
                android:background="@drawable/bg_toast"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:minHeight="40dp"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="10dp"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:alpha="1"
                tools:text="toast" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</layout>