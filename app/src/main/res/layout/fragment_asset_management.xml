<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.hit.HitViewModel" />
    </data>


    <com.kgmedia.fastfilm.widget.LoadStateViewHolder
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <RadioGroup
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:paddingHorizontal="3dp">

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:button="@null"
                        android:checked="true"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="角色"
                        android:textAppearance="@style/Text14"
                        android:textColor="@color/sel_text2_text3" />

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:button="@null"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="场景"
                        android:textAppearance="@style/Text14"
                        android:textColor="@color/sel_text2_text3" />

                    <RadioButton
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:button="@null"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="道具"
                        android:textAppearance="@style/Text14"
                        android:textColor="@color/sel_text2_text3" />

                </RadioGroup>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="15dp"
                    android:background="@drawable/fill_color1_r8"
                    android:drawableStart="@drawable/icon_ai_special_14"
                    android:drawablePadding="4dp"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="一键生成"
                    android:textAppearance="@style/Text14"
                    android:textColor="?attr/funcColorSpecial" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:overScrollMode="never"
                android:scrollbars="none"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_asset_management" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginHorizontal="15dp"
                    android:background="@drawable/selector_common_button"
                    android:gravity="center"
                    android:text="下一步"
                    android:textAppearance="@style/Text16"
                    android:textColor="@color/fixed_white_1"
                    app:layout_constraintDimensionRatio="345:44"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </com.kgmedia.fastfilm.widget.LoadStateViewHolder>
</layout>