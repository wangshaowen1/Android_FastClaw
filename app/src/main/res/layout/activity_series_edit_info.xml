<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.series.editinfo.EditInfoViewModel" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_model_toolbar"
            toolbar="@{layout.toolbar}" />

        <com.kgmedia.fastfilm.widget.LoadStateViewHolder
            displayChild="@{layout.loadState}"
            onRetry="@{layout::getSeriesInfo}"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="60dp">

                    <com.kgmedia.fastfilm.widget.roundedimageview.RoundedImageView
                        android:id="@+id/ivCover"
                        loadThumbnailUri="@{layout.cover.previewUrl}"
                        placeHolder="@{@drawable/ic_default_cover}"
                        singleClick="@{layout.clickHandler::onClick}"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginTop="36dp"
                        android:scaleType="centerCrop"
                        app:layout_constraintDimensionRatio="3:4"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.3387"
                        app:riv_corner_radius="12dp"
                        tools:src="@drawable/ic_default_cover" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_50_000000_r8"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:text="@{layout.cover!=null ? `重新上传` : `上传封面`}"
                        android:textColor="@android:color/white"
                        android:textSize="10dp"
                        app:layout_constraintBottom_toBottomOf="@+id/ivCover"
                        app:layout_constraintEnd_toEndOf="@+id/ivCover"
                        app:layout_constraintStart_toStartOf="@+id/ivCover"
                        tools:text="重新上传" />

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="24dp"
                        android:text="故事标题"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="14dp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/ivCover" />

                    <EditText
                        android:id="@+id/etTitle"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_ffffff_r12"
                        android:gravity="top"
                        android:hint="请输入标题..."
                        android:lineSpacingExtra="@dimen/lineSpacingExtraShort"
                        android:maxLength="50"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="32dp"
                        android:text="@={layout.title}"
                        android:textColor="@color/textColorPrimary"
                        android:textColorHint="@color/textColorSecondary"
                        android:textSize="14dp"
                        app:layout_constraintDimensionRatio="343:80"
                        app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@{layout.title.length()+`/50`}"
                        android:textColor="@color/color_50_121212"
                        android:textSize="10dp"
                        app:layout_constraintBottom_toBottomOf="@+id/etTitle"
                        app:layout_constraintEnd_toEndOf="@+id/etTitle"
                        tools:text="0/50" />

                    <TextView
                        android:id="@+id/tvDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="故事简介"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="14dp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@+id/tvTitle"
                        app:layout_constraintTop_toBottomOf="@+id/etTitle" />

                    <EditText
                        android:id="@+id/etDesc"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_ffffff_r12"
                        android:gravity="top"
                        android:hint="请输入简介..."
                        android:lineSpacingExtra="@dimen/lineSpacingExtraShort"
                        android:maxLength="300"
                        android:paddingHorizontal="12dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="32dp"
                        android:text="@={layout.description}"
                        android:textColor="@color/textColorPrimary"
                        android:textColorHint="@color/textColorSecondary"
                        android:textSize="14dp"
                        app:layout_constraintDimensionRatio="343:280"
                        app:layout_constraintTop_toBottomOf="@+id/tvDesc" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="@{layout.description.length()+`/300`}"
                        android:textColor="@color/color_50_121212"
                        android:textSize="10dp"
                        app:layout_constraintBottom_toBottomOf="@+id/etDesc"
                        app:layout_constraintEnd_toEndOf="@+id/etDesc"
                        tools:text="0/300" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </ScrollView>

        </com.kgmedia.fastfilm.widget.LoadStateViewHolder>

        <Space
            layoutHeight="@{layout.keyboardHeight}"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

    </LinearLayout>

</layout>