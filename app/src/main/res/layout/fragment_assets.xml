<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.works.assetmanager.AssetsChildViewModel" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.scwang.smart.refresh.layout.SmartRefreshLayout
            android:id="@+id/srl"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/action_bar_size"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:overScrollMode="never"
            app:srlAccentColor="@color/white"
            app:srlEnablePreviewInEditMode="true"
            app:srlPrimaryColor="@color/transparent">

            <com.kgmedia.fastfilm.widget.LoadStateViewHolder
                android:id="@+id/lsv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:noData="@string/empty_creation_history">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="6dp"
                    android:scrollbars="none"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="3"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_asset_role" />
            </com.kgmedia.fastfilm.widget.LoadStateViewHolder>
        </com.scwang.smart.refresh.layout.SmartRefreshLayout>
    </FrameLayout>
</layout>