<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kgmedia.fastfilm.feature.payment.points.ItemFirstTimeRechargeVM" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="5dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_trans_stroke_eeeeee_1px_r8"
        android:onClick="@{(v)->item.onItemClick.invoke(v)}">

        <com.kgmedia.fastfilm.widget.GradientBorderView
            setVisible="@{item.selected}"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:backgroundEndColor="@color/color_10_ffa029"
            app:backgroundStartColor="@color/color_10_ff4332"
            app:borderEndColor="@color/color_ffa029"
            app:borderStartColor="@color/color_ff4332"
            app:borderWidth="1dp"
            app:layout_constraintDimensionRatio="108:48"
            app:layout_constraintTop_toTopOf="parent"
            app:roundCornerRadius="8dp"
            tools:visibility="invisible" />

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableEnd="@drawable/ic_point_54"
            android:drawablePadding="2dp"
            android:text="@{item.data.pointNum+``}"
            android:textColor="@color/textColorPrimary"
            android:textSize="14dp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/tvAmount"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="880" />

        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@{item.pointAmount}"
            android:textColor="@color/color_50_121212"
            android:textSize="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCount"
            tools:text="¥88"
            tools:textColor="@color/textColorPrimary" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>