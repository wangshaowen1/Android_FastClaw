<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kgmedia.fastfilm.feature.timbre.ItemMyTimbreVM" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        singleClick="@{(it)->item.onItemClick.invoke(it)}"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_ffffff_r12"
        android:onLongClick="@{(it)->item.onLongClick.invoke()}">

        <com.kgmedia.fastfilm.widget.CropShapeImageView
            android:id="@+id/cover"
            loadHQThumbnailUri="@{item.data.timbreAvatarUrl}"
            placeHolder="@{@drawable/ic_default_avatar_big}"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="12dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/roundStyle_circle"
            tools:src="@drawable/ic_default_avatar_big" />

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_50_000000_r50"
            android:visibility="@{item.playing?View.VISIBLE:View.GONE}"
            app:layout_constraintStart_toStartOf="@id/cover"
            app:layout_constraintTop_toTopOf="@id/cover">

            <com.airbnb.lottie.LottieAnimationView
                setLottieAnimationViewAnimations="@{item.playing}"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:visibility="@{item.playing?View.VISIBLE:View.GONE}"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/lottie_middle_play_ump"
                app:lottie_repeatMode="restart" />
        </FrameLayout>

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:lines="1"
            android:text="@{item.name}"
            android:textStyle="bold"
            android:textColor="@color/textColorPrimary"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@id/tip"
            app:layout_constraintStart_toEndOf="@id/cover"
            app:layout_constraintTop_toTopOf="@id/cover"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="你说的是什么" />

        <TextView
            android:id="@+id/tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@{item.data.generateTitleDesc}"
            tools:text="请稍等1-2分钟..."
            android:textColor="@color/textColorPrimary"
            android:textSize="10sp"
            android:visibility="@{item.data.generating||item.data.generateFail?View.VISIBLE:View.GONE}"
            app:layout_constraintBottom_toBottomOf="@id/cover"
            app:layout_constraintStart_toStartOf="@id/name"
            app:layout_constraintTop_toBottomOf="@id/name" />

        <com.kgmedia.fastfilm.widget.BorderConstraintLayout
            android:id="@+id/btnOptimize"
            singleClick="@{(v)->item.timbreGenerate()}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:visibility="@{item.data.isTopTimbreForGenerate()? View.VISIBLE : View.GONE}"
            app:backgroundEndColor="#3335FF86"
            app:backgroundStartColor="#332CDCFF"
            app:borderEndColor="#35FF86"
            app:borderStartColor="#2CDCFF"
            app:borderWidth="1dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:roundCornerRadius="50dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="去完善"
                android:textColor="@color/textColorPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

        </com.kgmedia.fastfilm.widget.BorderConstraintLayout>

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:onClick="@{(it)->item.onPlayClick.invoke()}"
            android:padding="4dp"
            android:src="@{item.playing? @drawable/ic_timbre_pause:@drawable/ic_timbre_play}"
            android:visibility="@{item.data.available()? View.VISIBLE : View.GONE}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_timbre_play" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>