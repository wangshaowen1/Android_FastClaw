<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.works.assetmanager.AssetDetailViewModel" />

        <import type="android.view.View"/>
        <import type="android.text.TextUtils"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:windowBackground">

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_model_toolbar"
            app:layout_constraintTop_toTopOf="parent"
            app:toolbar="@{layout.mToolbarVM}" />

        <ImageView
            android:id="@+id/ivImage"
            loadUri="@{layout.image}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toTopOf="@id/tvStoryboardDescTitle"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <View
            android:id="@+id/ivLoading"
            android:visibility="@{layout.status!=2?View.VISIBLE:View.GONE}"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="?attr/fillColor1"
            app:layout_constraintBottom_toTopOf="@id/tvStoryboardDescTitle"
            app:layout_constraintDimensionRatio="375:210"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <TextView
            android:visibility="@{TextUtils.isEmpty(layout.image)?View.GONE:View.VISIBLE}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/spacing_l"
            style="@style/TextAppearance.AIChip"
            app:layout_constraintStart_toStartOf="@id/ivImage"
            app:layout_constraintTop_toTopOf="@id/ivImage" />

        <com.kgmedia.fastfilm.widget.AutoRotateLayout
            autoRotate="@{layout.generating}"
            setVisible="@{layout.generating}"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/icon_loading1"
            app:duration="2000"
            app:layout_constraintBottom_toBottomOf="@+id/ivImage"
            app:layout_constraintEnd_toEndOf="@+id/ivImage"
            app:layout_constraintStart_toStartOf="@+id/ivImage"
            app:layout_constraintTop_toTopOf="@+id/ivImage" />

        <TextView
            setVisible="@{layout.regenerateFail}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableTop="@drawable/icon_image_fail"
            android:drawablePadding="@dimen/spacing_m"
            android:text="@string/generation_failed"
            android:textColor="?attr/textColor1"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/ivImage"
            app:layout_constraintEnd_toEndOf="@+id/ivImage"
            app:layout_constraintStart_toStartOf="@+id/ivImage"
            app:layout_constraintTop_toTopOf="@+id/ivImage" />

        <TextView
            android:id="@+id/tvStoryboardDescTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="@{layout.subTitle}"
            android:textAppearance="@style/Text14"
            android:textColor="?attr/textColor1"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/desc"
            app:layout_constraintStart_toStartOf="@+id/desc"
            tools:text="@string/storyboard_desc" />

        <TextView
            android:id="@+id/desc"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginBottom="85dp"
            android:background="@drawable/fill_color1_r8"
            android:lineSpacingExtra="@dimen/lineSpacingExtraShort"
            android:maxLength="200"
            android:paddingHorizontal="@dimen/spacing_m"
            android:paddingTop="@dimen/spacing_m"
            android:paddingBottom="40dp"
            android:scrollbars="vertical"
            android:text="@{layout.prompt}"
            android:textAppearance="@style/Text14"
            android:textColor="?attr/textColor2"
            app:layout_constraintBottom_toTopOf="@+id/btnRegenerate"
            app:layout_constraintDimensionRatio="345:178"
            tools:text="白天，史莱克学院后山茂密的森林，阳光穿透层层叠叠的树叶，在铺满落叶的空地上洒下斑驳光影。唐三与小舞相对而立，清风吹过。唐三微微领首，脚下升起数圈魂环，地面开始震动。唐三...白天，史莱克学院后山茂密的森林，阳光穿透层层叠叠的树叶，在铺满落叶的空地上洒下斑驳光影。唐三与小舞相对而立，清风吹过。唐三微微领首，脚下升起数圈魂环，地面开始震动。唐三...白天，史莱克学院后山茂密的森林，阳光穿透层层叠叠的树叶，在铺满落叶的空地上洒下斑驳光影。唐三与小舞相对而立，清风吹过。唐三微微领首，脚下升起数圈魂环，地面开始震动。唐三..." />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_m"
            android:layout_marginBottom="@dimen/spacing_l"
            android:text="@{layout.prompt.length()+`/`+layout.maxLength}"
            android:textAppearance="@style/Text12"
            android:textColor="?attr/textColor4"
            app:layout_constraintBottom_toBottomOf="@id/desc"
            app:layout_constraintEnd_toEndOf="@id/desc"
            tools:text="118/200" />

        <Button
            android:id="@+id/btnRegenerate"
            style="@style/Button.Bold"
            setEnabled="@{!layout.generating}"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginBottom="34dp"
            android:text="@{layout.buttonText(layout.generating,layout.regenerateFail,layout.cost)}"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="图片生成中..." />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>