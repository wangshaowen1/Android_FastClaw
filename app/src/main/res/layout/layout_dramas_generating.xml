<?xml version="1.0" encoding="utf-8"?><!--导出视频水印-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="viewModel"
            type="com.kgmedia.fastfilm.feature.main.MainViewModel" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:id="@+id/blurView"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="10dp"
            android:elevation="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.github.mmin18.widget.RealtimeBlurView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:realtimeBlurRadius="20dp"
                app:realtimeOverlayColor="@android:color/transparent" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/color_50_000000" />
        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/ivGenerateIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:src="@drawable/img_generate_icon"
            app:layout_constraintBottom_toBottomOf="@id/blurView"
            app:layout_constraintStart_toStartOf="@id/blurView" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="你有故事正在制作中..."
            android:textColor="@color/white"
            android:textSize="12dp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/blurView"
            app:layout_constraintStart_toEndOf="@id/ivGenerateIcon"
            app:layout_constraintTop_toTopOf="@id/blurView" />

        <TextView
            android:id="@+id/btnGenerateContinue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/gradient_left_ff4332_right_ffa029_r6"
            android:onClick="@{viewModel.clickHandler::onClick}"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:text="继续制作"
            android:textColor="@color/white"
            android:textSize="10dp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/blurView"
            app:layout_constraintEnd_toStartOf="@id/ivGenerateClose"
            app:layout_constraintTop_toTopOf="@id/blurView" />

        <ImageView
            android:id="@+id/ivGenerateClose"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="12dp"
            android:onClick="@{viewModel.clickHandler::onClick}"
            android:src="@drawable/ic_close_white72"
            app:layout_constraintBottom_toBottomOf="@id/blurView"
            app:layout_constraintEnd_toEndOf="@id/blurView"
            app:layout_constraintTop_toTopOf="@id/blurView" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>