<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_today_progress_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_msg_agent_left"
    android:paddingHorizontal="16dp"
    android:paddingVertical="20dp">

    <!-- 顶部：对勾 + 今日进展 + 日期 -->
    <ImageView
        android:id="@+id/iv_progress_check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_tick_green_filled"
        app:layout_constraintBottom_toBottomOf="@id/tv_progress_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_progress_title" />

    <TextView
        android:id="@+id/tv_progress_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/str_agent_today_progress_title"
        android:textColor="@color/color_90_000000"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/iv_progress_check"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_progress_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/color_56_3c3c43"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/tv_progress_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_progress_title"
        tools:text="5月18日" />

    <View
        android:id="@+id/v_progress_divider"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="16dp"
        android:background="@color/color_10_000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_progress_title" />

    <!-- 气泡 + 文案 + 查看完整报告 -->
    <FrameLayout
        android:id="@+id/fl_progress_bubble"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_understanding_align_bubble"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_progress_divider">

        <TextView
            android:id="@+id/tv_progress_percent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/color_90_000000"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="85%" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_progress_align_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/str_agent_today_progress_align_title"
        android:textColor="@color/color_90_000000"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/fl_progress_bubble"
        app:layout_constraintTop_toTopOf="@id/fl_progress_bubble" />

    <TextView
        android:id="@+id/tv_progress_align_delta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/color_56_3c3c43"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/fl_progress_bubble"
        app:layout_constraintEnd_toStartOf="@id/tv_progress_view_report"
        app:layout_constraintStart_toStartOf="@id/tv_progress_align_title"
        app:layout_constraintTop_toBottomOf="@id/tv_progress_align_title"
        tools:text="对齐度+25%" />

    <TextView
        android:id="@+id/tv_progress_view_report"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="2dp"
        android:gravity="center_vertical"
        android:text="@string/str_agent_today_progress_view_report"
        android:textColor="@color/color_56_3c3c43"
        android:textSize="13sp"
        app:drawableEndCompat="@drawable/ic_arrow_right"
        app:layout_constraintBottom_toBottomOf="@id/tv_progress_align_delta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_progress_align_delta" />

    <!-- 动态分区列表（数量不固定）：每个分区是一个 item_today_progress_section -->
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/flow_progress_sections"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        app:flow_verticalGap="16dp"
        app:flow_verticalStyle="packed"
        app:flow_wrapMode="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fl_progress_bubble" />

</androidx.constraintlayout.widget.ConstraintLayout>