<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_white_rectangle_top_corner_r24"
    android:gravity="center_horizontal"
    android:orientation="vertical">


    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/membership_validity_period"
        android:textColor="@color/textColorPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="58dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginEnd="4dp"
        android:importantForAccessibility="no"
        android:paddingVertical="16dp"
        android:src="@drawable/ic_clear_input"
        app:layout_constraintBottom_toBottomOf="@id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_title" />

    <TextView
        android:id="@+id/tv_describe_01"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/vip_describe_01"
        android:textColor="#ff121212"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <TextView
        android:id="@+id/tv_describe_02"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/vip_describe_02"
        android:textColor="#ff121212"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/tv_describe_01" />

    <TextView
        android:id="@+id/tv_describe_03"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="40dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/vip_describe_03"
        android:textColor="#80121212"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_describe_02" />
</androidx.constraintlayout.widget.ConstraintLayout>
