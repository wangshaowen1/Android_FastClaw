<?xml version="1.0" encoding="utf-8"?><!--首次充值弹窗-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.payment.points.FirstTimeUnlockViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ffffff_tr24"
        android:clickable="true"
        android:focusable="true">

        <com.kgmedia.fastfilm.widget.roundedimageview.RoundedImageView
            android:id="@+id/bg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_recharge_dialog"
            app:layout_constraintDimensionRatio="375:146"
            app:layout_constraintTop_toTopOf="parent"
            app:riv_corner_radius_top_left="24dp"
            app:riv_corner_radius_top_right="24dp" />

        <com.kgmedia.fastfilm.widget.HorizontalScrollRecyclerView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="12dp"
            android:adapter="@{layout.sampleAdapter}"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="@+id/bg"
            app:layout_constraintDimensionRatio="375:28"
            tools:listitem="@layout/item_first_time_recharge_sample" />

        <TextView
            android:id="@+id/btnRecharge"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/selector_common_button"
            android:gravity="center"
            android:onClick="@{() -> layout.unlock()}"
            android:text="解锁完整作品"
            android:textColor="@color/white"
            android:textSize="16dp"
            app:layout_constraintDimensionRatio="317:48"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bg"
            app:layout_constraintWidth_percent="0.8453" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="36dp"
            android:text="@{layout.cost}"
            android:textColor="@color/color_ff4b00"
            android:textSize="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnRecharge"
            tools:text="解锁后续图片还需560积分" />

        <FrameLayout
            setVisible="@{layout.loading}"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="gone">

            <include
                layout="@layout/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

        </FrameLayout>

        <ImageView
            singleClick="@{() -> layout.dismiss()}"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="16dp"
            android:src="@drawable/ic_light_dialog_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>