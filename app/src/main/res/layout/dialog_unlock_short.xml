<?xml version="1.0" encoding="utf-8"?><!--首次充值弹窗-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.play.UnLockSeriesShortViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ffffff_tr24">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="@color/color_121212"
            android:textSize="16sp"
            android:text="@{`解锁第`+layout.position+`章`}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="解锁第1章" />

        <TextView
            android:id="@+id/unlockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="34dp"
            android:text="解锁本章"
            android:textColor="@color/color_121212"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/title" />

        <TextView
            style="@style/Text.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="0.5dp"
            android:drawableEnd="@drawable/ic_point_54"
            android:drawablePadding="2dp"
            android:text="@{layout.unlockCoins+``}"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@id/unlockText"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="560" />

        <TextView
            android:id="@+id/autoUnlockText"
            style="@style/Text.Common"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="自动解锁下一章"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="@id/unlockText"
            app:layout_constraintTop_toBottomOf="@id/unlockText" />

        <ImageView
            android:id="@+id/autoUnlockSwitch"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="48dp"
            android:layout_height="24dp"
            android:layout_marginEnd="16dp"
            android:src="@{layout.shortLocked?@drawable/ic_switch_on:@drawable/ic_switch_off}"
            app:layout_constraintBottom_toBottomOf="@id/autoUnlockText"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/autoUnlockText"
            tools:src="@drawable/ic_switch_off" />

        <Button
            android:id="@+id/unlockNow"
            style="@style/Button.Bold"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="29dp"
            android:layout_marginTop="42dp"
            android:text="立即解锁"
            app:layout_constraintTop_toBottomOf="@id/autoUnlockText" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="可重复看丨不可退款丨"
            android:textColor="@color/color_50_121212"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/textView"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/unlockNow" />

        <TextView
            android:id="@+id/textView"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="付费须知"
            android:textColor="@color/textColorPrimary"
            android:textSize="12sp"
            app:layout_constraintBaseline_toBaselineOf="@id/textView2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/textView2" />

        <ImageView
            singleClick="@{() -> layout.dismiss()}"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="16dp"
            android:src="@drawable/ic_light_dialog_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>