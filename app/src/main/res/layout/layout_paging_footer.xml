<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/paging_footer_loading_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="15dp"
        android:visibility="gone">

        <ProgressBar
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:indeterminateTint="@color/color_6a6a6a" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/brvah_loading"
            android:textColor="@color/color_6a6a6a"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/paging_footer_error_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="15dp"
        android:text="@string/brvah_load_failed"
        android:textColor="@color/color_6a6a6a"
        android:textSize="12sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/paging_footer_end_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="15dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/paging_footer_end_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_more_data"
            android:textColor="@color/color_6a6a6a"
            android:textSize="12sp" />
    </FrameLayout>
</FrameLayout>
