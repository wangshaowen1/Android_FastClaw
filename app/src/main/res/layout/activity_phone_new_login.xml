<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.login.phone.PhoneNewLoginViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/login_bg">

        <ImageView
            android:id="@+id/ivLoginBg"
            android:layout_width="320dp"
            android:layout_height="488dp"
            android:layout_marginStart="-3dp"
            android:layout_marginTop="26dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_phone_new_login_top"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.shiyuan.fastclaw.widget.StatusBarView
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="44dp"
            android:importantForAccessibility="no"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:src="@drawable/ic_phone_new_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPhoneTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="35dp"
            android:layout_marginTop="164dp"
            android:text="@string/login_new_phone_title"
            android:textColor="@color/color_90_000000"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/statusBar" />

        <TextView
            android:id="@+id/tvPhoneSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="35dp"
            android:layout_marginTop="5dp"
            android:text="@string/login_new_phone_subtitle"
            android:textColor="@color/color_90_000000"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPhoneTitle" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="42dp"
            android:layout_marginEnd="35dp"
            android:background="@drawable/bg_ffffff_r100"
            android:importantForAutofill="no"
            android:gravity="center_vertical"
            android:inputType="phone"
            android:maxLength="11"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@={layout.mobile}"
            android:textColor="@color/color_90_000000"
            android:textCursorDrawable="@drawable/edittext_cursor"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPhoneSubtitle"
            tools:text="1309898970" />

        <TextView
            android:id="@+id/tvPhoneError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="28dp"
            android:text="@string/login_new_phone_error"
            android:textColor="@color/color_ff4332"
            android:textSize="12sp"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/etPhone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/llAgreement"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="45dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="35dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPhoneError">

            <ImageView
                android:id="@+id/ivCheck"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@{layout.checkedPolicy?@drawable/ic_checkbox_checked:@drawable/icon_checkbox_unchecked}" />

            <TextView
                android:id="@+id/tvAgreement"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="@color/color_90_000000"
                android:textSize="11sp"
                tools:text="我已阅读并同意 《快龙虾用户协议》和《隐私政策》" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnGetCode"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="21dp"
            android:layout_marginEnd="35dp"
            android:background="@drawable/bg_336fff_r100"
            android:gravity="center"
            android:text="@string/login_new_get_sms_code"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llAgreement" />

        <ImageView
            android:id="@+id/btnWechat"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/img_login_wechat"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnGetCode" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
