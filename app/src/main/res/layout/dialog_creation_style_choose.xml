<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.creator.style.CreationStyleChooseViewModel" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ffffff_tr24">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="全部风格"
            android:textColor="@color/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="15dp"
            android:onClick="@{()->layout.dismiss()}"
            android:padding="3dp"
            android:src="@drawable/ic_dialog_close_black"
            app:layout_constraintBottom_toBottomOf="@id/title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/title" />

        <com.kgmedia.fastfilm.widget.EdgeTransparentView
            android:layout_width="match_parent"
            android:layout_height="493dp"
            android:layout_marginTop="20dp"
            app:edge_position="bottom"
            app:edge_width="92dp"
            app:layout_constraintTop_toBottomOf="@id/title">

            <com.kgmedia.fastfilm.widget.LoadStateViewHolder
                android:id="@+id/loadState"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:lightMode="true">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="16dp"
                    tools:listitem="@layout/item_creation_style_all" />
            </com.kgmedia.fastfilm.widget.LoadStateViewHolder>
        </com.kgmedia.fastfilm.widget.EdgeTransparentView>

        <!-- 保存按钮 -->
        <Button
            android:id="@+id/btnConfirm"
            style="@style/Button.Bold"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginHorizontal="34dp"
            android:layout_marginBottom="22dp"
            android:text="确认"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>