<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.base.viewmodel.EmptyViewModel" />

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />
    </data>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:layout_width="280dp">

        <ImageView
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="164dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/bg_upgrade_v138"
            app:layout_constraintTop_toTopOf="parent" />

        <com.shiyuan.fastclaw.widget.GradientBorderView
            android:id="@+id/panel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="90dp"
            app:backgroundAngle="90"
            app:backgroundEndColor="@color/white"
            app:backgroundStartColor="#F2F8FF"
            app:layout_constraintBottom_toBottomOf="@id/pl"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.0"
            app:roundCornerRadius="20dp"
            tools:layout_editor_absoluteX="0dp" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/new_version_found"
            android:textAppearance="@style/Text18"
            android:textColor="@color/color_90_000000"
            app:layout_constraintEnd_toEndOf="@id/panel"
            app:layout_constraintStart_toStartOf="@id/panel"
            app:layout_constraintTop_toTopOf="@id/panel" />

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/Text12"
            android:textColor="@color/color_55_3c3c43"
            app:layout_constraintEnd_toEndOf="@id/panel"
            app:layout_constraintStart_toStartOf="@id/panel"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            tools:text="1.3.8" />

        <com.shiyuan.fastclaw.widget.AtMostScrollView
            android:id="@+id/llScrollView"
            android:layout_width="244dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:bottomFadingEdgeStrength="1"
            app:layout_constraintEnd_toEndOf="@id/panel"
            app:layout_constraintStart_toStartOf="@id/panel"
            app:layout_constraintTop_toBottomOf="@+id/version"
            app:maxHeight="69dp"
            app:topFadingEdgeStrength="0"
            app:verticalFadingEdgeEnabled="true">

            <TextView
                android:paddingBottom="3dp"
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:lineSpacingExtra="8sp"
                android:textAlignment="center"
                android:textColor="@color/color_90_000000"
                android:textSize="15sp"
                tools:text="更新对话修改，体验更智能" />
        </com.shiyuan.fastclaw.widget.AtMostScrollView>

        <TextView
            android:id="@+id/upgrade"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="169dp"
            android:layout_height="40dp"
            android:layout_marginTop="13dp"
            android:background="@drawable/selector_common_button"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/update_now"
            android:textColor="@color/fixed_white_1"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="@id/panel"
            app:layout_constraintStart_toStartOf="@id/panel"
            app:layout_constraintTop_toBottomOf="@+id/llScrollView" />

      <!--  <TextView
            android:visibility="gone"
            android:id="@+id/cancel"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="244dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="@string/update_cancel"
            android:textAppearance="@style/Text13"
            android:textColor="?attr/textColor3"
            app:layout_constraintEnd_toEndOf="@id/panel"
            app:layout_constraintStart_toStartOf="@id/panel"
            app:layout_constraintTop_toBottomOf="@+id/upgrade" />-->

        <androidx.constraintlayout.widget.Placeholder
            android:id="@+id/pl"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            app:layout_constraintTop_toBottomOf="@+id/upgrade" />


        <ImageView
            android:layout_marginTop="20dp"
            singleClick="@{layout.clickHandler::onClick}"
            android:id="@+id/cancel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/ic_close_up"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/panel"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent" />



    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
