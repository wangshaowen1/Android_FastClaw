<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.creator.generate.DramaGenerateStep1ViewModel" />

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ViewAnimator
            displayChild="@{layout.displayChild}"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/spacing_l"
                android:paddingTop="20dp"
                android:stackFromBottom="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:drawableTop="@drawable/ic_loading_fail"
                    android:gravity="center"
                    android:text="生成失败"
                    android:textColor="?attr/textColor4"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnRegenerate"
                    style="@style/Button.Bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:gravity="center"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="6dp"
                    android:text="重新生成"
                    android:textSize="12sp" />
            </LinearLayout>
        </ViewAnimator>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:paddingHorizontal="@dimen/spacing_l"
            android:paddingVertical="@dimen/spacing_m">

            <Button
                android:id="@+id/btnNext"
                style="@style/Button.Bold"
                android:layout_width="match_parent"
                android:enabled="@{layout.nextStepEnabled}"
                android:text="下一步：创建剧本"
                tools:enabled="false" />
        </FrameLayout>
    </LinearLayout>


</layout>