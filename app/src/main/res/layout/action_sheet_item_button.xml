<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:background="@color/actionsheet_divider_color"
        android:layout_height="@dimen/actionsheet_divier_height"/>
    <TextView
        android:id="@+id/tvAlert"
        android:layout_width="match_parent"
        android:layout_height="@dimen/actionsheet_button_height"
        android:gravity="center"
        android:textColor="@color/textColor_alert_button_others"
        android:textSize="@dimen/actionsheet_button_textSize" />
</LinearLayout>