<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kgmedia.fastfilm.feature.invitation.income.ItemInvitationIncomeVm" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/siv_avatar"
            placeHolder="@{@drawable/ic_default_avatar_big}"
            loadUri="@{item.data.avatarUrl}"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_default_avatar_big"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/roundStyle_circle" />

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:text="@{item.data.nickName}"
            android:textColor="@color/color_121212"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@id/tv_describe"
            app:layout_constraintEnd_toStartOf="@id/tv_amount_of_money"
            app:layout_constraintStart_toEndOf="@id/siv_avatar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="李克勤" />

        <TextView
            android:id="@+id/tv_describe"
            android:layout_width="0dp"
            android:layout_height="17dp"
            android:layout_marginTop="5dp"
            android:text="@{item.remarks}"
            tools:text="2025.09.02 00:12 充值能力包"
            android:textColor="#80121212"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/siv_avatar"
            app:layout_constraintEnd_toEndOf="@id/tv_name"
            app:layout_constraintStart_toStartOf="@id/tv_name"
            app:layout_constraintTop_toBottomOf="@id/tv_name"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/tv_amount_of_money"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{item.amount}"
            android:textColor="@color/color_ac0e00"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="+10元" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>