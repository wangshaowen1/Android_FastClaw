<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/srl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:srlEnableLoadMore="false">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="76dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <com.airbnb.lottie.LottieAnimationView
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_imageAssetsFolder="loading_opportunity/images"
                app:lottie_fileName="loading_opportunity/loading_opportunity.json"
                app:lottie_repeatMode="reverse"

                android:id="@+id/v"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!--/* 未开始匹配-->
            <LinearLayout

                android:id="@+id/card_understand_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:background="@drawable/bg_home_treasury_card"
                android:orientation="vertical"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/v">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="26dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:text="@string/not_opportunity_understand_title"
                        android:textColor="@color/color_90_000000"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:text="@string/not_opportunity_understand_description"
                        android:textColor="@color/color_85_3c3c43"
                        android:textSize="13sp"
                        android:textStyle="normal" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="@color/color_f2f6fe"
                            app:cardCornerRadius="@dimen/dp20"
                            app:cardElevation="0dp">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_opportunity_card_bg1"
                                android:paddingHorizontal="13dp"
                                android:paddingTop="23dp">

                                <TextView
                                    android:id="@+id/tv_upload_resume_title"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:gravity="center_vertical"
                                    android:text="@string/upload_resume"
                                    android:textColor="@color/color_000000"
                                    android:textSize="16sp"
                                    app:layout_constraintEnd_toStartOf="@id/card_upload_resume_action"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <TextView
                                    android:id="@+id/tv_upload_resume_description"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:gravity="center_vertical"
                                    android:includeFontPadding="false"
                                    android:text="@string/not_opportunity_upload_description"
                                    android:textColor="@color/color_85_3c3c43"
                                    android:textSize="13sp"
                                    app:layout_constraintEnd_toStartOf="@id/card_upload_resume_action"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/tv_upload_resume_title" />

                                <LinearLayout
                                    android:id="@+id/ll_state"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:layout_marginBottom="14dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:visibility="gone"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/tv_upload_resume_description">

                                    <ImageView
                                        android:id="@+id/iv_state"
                                        android:layout_width="13dp"
                                        android:layout_height="13dp"
                                        android:src="@drawable/ic_running2"
                                        tools:ignore="ContentDescription" />


                                    <TextView
                                        android:id="@+id/tv_state"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="3dp"
                                        android:layout_weight="1"
                                        android:gravity="center_vertical"
                                        android:includeFontPadding="false"
                                        android:text="@string/not_opportunity_resume_parsing"
                                        android:textColor="@color/color_2f6bff"
                                        android:textSize="12sp"
                                        android:textStyle="normal" />
                                </LinearLayout>

                                <View
                                    android:id="@+id/v_line"
                                    android:layout_width="match_parent"
                                    android:layout_height="23dp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/tv_upload_resume_description" />

                                <TextView
                                    android:id="@+id/card_upload_resume_action"
                                    android:layout_width="62dp"
                                    android:layout_height="27dp"
                                    android:background="@drawable/bg_upload_resume_btn"
                                    android:gravity="center"
                                    android:includeFontPadding="false"
                                    android:text="@string/not_opportunity_upload_action"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    android:textStyle="normal"
                                    app:layout_constraintBottom_toBottomOf="@id/tv_upload_resume_description"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="@id/tv_upload_resume_title" />


                                <TextView
                                    android:id="@+id/card_upload_already"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:gravity="center"
                                    android:includeFontPadding="false"
                                    android:text="@string/not_opportunity_upload_already"
                                    android:textColor="@color/color_85_3c3c43"
                                    android:textSize="14sp"
                                    android:visibility="gone"
                                    app:layout_constraintBottom_toBottomOf="@id/tv_upload_resume_description"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="@id/tv_upload_resume_title" />

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </androidx.cardview.widget.CardView>

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            app:cardBackgroundColor="@color/color_f8f8f8"
                            app:cardCornerRadius="@dimen/dp20"
                            app:cardElevation="0dp">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/cl_job_preference"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_opportunity_card_bg2"
                                android:paddingHorizontal="13dp"
                                android:paddingVertical="23dp">


                                <TextView
                                    android:id="@+id/tv_job_preference_title"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-medium"
                                    android:gravity="center_vertical"
                                    android:includeFontPadding="false"
                                    android:text="@string/not_opportunity_preference_title"
                                    android:textColor="@color/color_75_3c3c43"
                                    android:textSize="16sp"
                                    app:layout_constraintBottom_toTopOf="@id/tv_job_preference_description"
                                    app:layout_constraintEnd_toStartOf="@id/card_job_preference_action"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintVertical_chainStyle="packed" />

                                <TextView
                                    android:id="@+id/tv_job_preference_description"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:gravity="center_vertical"
                                    android:text="@string/not_opportunity_preference_description"
                                    android:textColor="@color/color_55_3c3c43"
                                    android:textSize="13sp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toStartOf="@id/card_job_preference_action"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@id/tv_job_preference_title" />

                                <TextView
                                    android:id="@+id/card_job_preference_action"
                                    android:layout_width="62dp"
                                    android:layout_height="27dp"
                                    android:background="@drawable/bg_20_666666_r50"
                                    android:gravity="center"
                                    android:text="@string/not_opportunity_preference_action"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!--/* 开始匹配但是没机会-->
            <LinearLayout
                android:visibility="gone"
                android:id="@+id/card_no_chance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:background="@drawable/bg_home_treasury_card"
                android:orientation="vertical"
                android:paddingVertical="@dimen/spacing_xl"
                android:paddingLeft="13dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/v">


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/spacing_xl"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/not_opportunity_searching_title"
                        android:textColor="@color/color_90_000000"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-medium" />

                    <View
                        android:layout_width="@dimen/dp1"
                        android:layout_height="@dimen/spacing_m"
                        android:layout_gravity="center_vertical"
                        android:layout_marginHorizontal="@dimen/spacing_s"
                        android:background="@color/color_000000" />

                    <TextView
                        android:id="@+id/tv_browsed_job_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:text="@string/not_opportunity_browsed_job_count"
                        android:textColor="@color/color_90_000000"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:includeFontPadding="false"
                    android:text="@string/not_opportunity_searching_description"
                    android:textColor="@color/color_85_3c3c43"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="61dp"
                        android:background="@drawable/bg_f8fef9_stroke_7bcd9b_r16"
                        android:paddingStart="11dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:id="@+id/iv_recommended_opportunity"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_opportunity_recommend"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="7dp"
                            android:includeFontPadding="false"
                            android:text="@string/not_opportunity_recommended"
                            android:textColor="@color/color_90_000000"
                            android:textSize="13sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@id/iv_recommended_opportunity"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_recommended_opportunity_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:textColor="#E609B65D"
                            android:textSize="18sp"
                            android:text="0"
                            android:fontFamily="sans-serif-medium"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="0" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="61dp"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_f4f8ff_stroke_d2dcff_r16"
                            android:paddingHorizontal="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/not_opportunity_pending"
                                android:textColor="@color/color_90_000000"
                                android:textSize="13sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tv_pending_opportunity_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:textColor="@color/color_85_3c3c43"
                                android:textSize="18sp"
                                android:fontFamily="sans-serif-medium"
                                android:text="0"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                tools:text="0" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_f4f8ff_stroke_d2dcff_r16"
                            android:paddingHorizontal="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/not_opportunity_mismatched"
                                android:textColor="@color/color_90_000000"
                                android:textSize="13sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tv_mismatched_opportunity_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:textColor="@color/color_85_3c3c43"
                                android:textSize="18sp"
                                android:fontFamily="sans-serif-medium"
                                android:text="0"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                tools:text="0" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </LinearLayout>

                </LinearLayout>


            </LinearLayout>

            <!--匹配到机会-->
            <LinearLayout
                android:visibility="gone"
                android:layout_marginTop="20dp"
                android:id="@+id/ll_match_opportunity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="15dp"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

             <TextView
                 android:id="@+id/tv_match_opportunity"
                 android:textColor="@color/black"
                 android:layout_marginLeft="5dp"
                 android:fontFamily="sans-serif-medium"
                 android:textSize="18sp"
                 tools:text="小虾发现了新机会2个"
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_marginTop="20dp"
                    android:id="@+id/rv_match_opportunity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            </LinearLayout>

            <!--已处理机会-->
            <LinearLayout
                android:visibility="gone"
                android:id="@+id/ll_processed_opportunity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="17dp"
                android:layout_marginTop="@dimen/spacing_xl"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/spacing_xl">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/not_opportunity_processed_title"
                        android:textColor="@color/color_90_000000"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/ll_view_all_processed_opportunity"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:visibility="gone"
                        android:id="@+id/ll_view_all_processed_opportunity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <TextView
                            android:id="@+id/tv_view_all_processed_opportunity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="3dp"
                            android:includeFontPadding="false"
                            android:text="@string/view_all"
                            android:textColor="@color/color_85_3c3c43"
                            android:textSize="12sp" />

                        <ImageView
                            android:id="@+id/iv_processed_opportunity_arrow"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:scaleType="center"
                            android:src="@drawable/ic_opportunity_processed_arrow"
                            tools:ignore="ContentDescription" />

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <RelativeLayout
                    android:visibility="gone"
                    android:id="@+id/rl_empty"
                    android:layout_marginTop="18dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/iv_processed_opportunity_searching"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_centerHorizontal="true"
                        android:src="@drawable/ic_opportunity_searching"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/spacing_l"
                        android:layout_below="@id/iv_processed_opportunity_searching"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="5dp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="@string/not_opportunity_searching_hint"
                        android:textColor="@color/color_85_3c3c43"
                        android:textSize="12sp" />


                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_marginTop="12dp"
                    android:id="@+id/rv_processed_opportunity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            </LinearLayout>

        </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </com.scwang.smart.refresh.layout.SmartRefreshLayout>


</layout>
