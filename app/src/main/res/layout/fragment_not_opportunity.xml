<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <View
            android:layout_width="match_parent"
            android:layout_height="160dp"/>


        <LinearLayout
            android:layout_marginTop="160dp"
            android:id="@+id/card_understand_user"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp"
            android:background="@drawable/bg_home_treasury_card"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="26dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text="@string/not_opportunity_understand_title"
                    android:textColor="@color/color_90_000000"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text="@string/not_opportunity_understand_description"
                    android:textColor="@color/color_85_3c3c43"
                    android:textSize="13sp"
                    android:textStyle="normal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/color_f2f6fe"
                        app:cardCornerRadius="@dimen/dp20"
                        app:cardElevation="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:paddingTop="23dp"
                            android:background="@drawable/bg_opportunity_card_bg1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="13dp">

                            <TextView
                                android:id="@+id/tv_upload_resume_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:text="@string/upload_resume"
                                android:textColor="@color/color_000000"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-medium"
                                app:layout_constraintEnd_toStartOf="@id/card_upload_resume_action"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tv_upload_resume_description"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:gravity="center_vertical"
                                android:includeFontPadding="false"
                                android:text="@string/not_opportunity_upload_description"
                                android:textColor="@color/color_85_3c3c43"
                                android:textSize="13sp"
                                app:layout_constraintEnd_toStartOf="@id/card_upload_resume_action"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tv_upload_resume_title" />

                            <LinearLayout
                                android:visibility="gone"
                                android:id="@+id/ll_state"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                android:layout_marginBottom="14dp"
                                android:layout_marginTop="10dp"
                                app:layout_constraintTop_toBottomOf="@id/tv_upload_resume_description"
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/iv_state"
                                    android:layout_width="13dp"
                                    android:layout_height="13dp"
                                    android:src="@drawable/ic_running2"
                                    tools:ignore="ContentDescription" />


                                <TextView
                                    android:id="@+id/tv_state"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="3dp"
                                    android:layout_weight="1"
                                    android:gravity="center_vertical"
                                    android:includeFontPadding="false"
                                    android:text="@string/not_opportunity_resume_parsing"
                                    android:textColor="@color/color_2f6bff"
                                    android:textSize="12sp"
                                    android:textStyle="normal" />
                            </LinearLayout>

                            <View
                                android:id="@+id/v_line"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tv_upload_resume_description"
                                android:layout_width="match_parent"
                                android:layout_height="23dp"/>

                            <TextView
                                android:id="@+id/card_upload_resume_action"
                                android:layout_width="62dp"
                                android:layout_height="27dp"
                                android:background="@drawable/bg_upload_resume_btn"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="@string/not_opportunity_upload_action"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                android:textStyle="normal"
                                app:layout_constraintBottom_toBottomOf="@id/tv_upload_resume_description"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="@id/tv_upload_resume_title" />


                            <TextView
                                android:visibility="gone"
                                android:fontFamily="sans-serif-medium"
                                android:id="@+id/card_upload_already"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:text="@string/not_opportunity_upload_already"
                                android:textColor="@color/color_85_3c3c43"
                                android:textSize="14sp"
                                app:layout_constraintBottom_toBottomOf="@id/tv_upload_resume_description"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="@id/tv_upload_resume_title" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        app:cardBackgroundColor="@color/color_f8f8f8"
                        app:cardCornerRadius="@dimen/dp20"
                        app:cardElevation="0dp">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cl_job_preference"
                            android:paddingVertical="23dp"
                            android:background="@drawable/bg_opportunity_card_bg2"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingHorizontal="13dp">


                            <TextView
                                android:id="@+id/tv_job_preference_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:includeFontPadding="false"
                                android:text="@string/not_opportunity_preference_title"
                                android:textColor="@color/color_75_3c3c43"
                                android:textSize="16sp"
                                android:fontFamily="sans-serif-medium"
                                app:layout_constraintBottom_toTopOf="@id/tv_job_preference_description"
                                app:layout_constraintEnd_toStartOf="@id/card_job_preference_action"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintVertical_chainStyle="packed" />

                            <TextView
                                android:id="@+id/tv_job_preference_description"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:gravity="center_vertical"
                                android:text="@string/not_opportunity_preference_description"
                                android:textColor="@color/color_55_3c3c43"
                                android:textSize="13sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/card_job_preference_action"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@id/tv_job_preference_title" />

                            <TextView
                                android:id="@+id/card_job_preference_action"
                                android:layout_width="62dp"
                                android:layout_height="27dp"
                                android:background="@drawable/bg_20_666666_r50"
                                android:gravity="center"
                                android:text="@string/not_opportunity_preference_action"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
