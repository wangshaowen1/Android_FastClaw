<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="viewModel"
            type="com.kgmedia.fastfilm.feature.aicompose.generating.GeneratingViewModel" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:clickable="true"
        android:focusable="true"
        android:padding="12dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_f6f6f6_r12"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/cover"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_margin="9dp"
                android:src="@drawable/ic_generating_cover"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.airbnb.lottie.LottieAnimationView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center_horizontal"
                android:layout_margin="8dp"
                android:visibility="@{viewModel.firstItem.progress>=100?View.GONE:View.VISIBLE}"
                app:layout_constraintBottom_toBottomOf="@+id/cover"
                app:layout_constraintEnd_toEndOf="@+id/cover"
                app:layout_constraintStart_toStartOf="@+id/cover"
                app:layout_constraintTop_toTopOf="@+id/cover"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/lottie_item_generating"
                app:lottie_repeatMode="restart" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:ellipsize="end"
                android:lines="1"
                android:text="@{viewModel.firstItem.title(viewModel.firstItem.data,viewModel.firstItem.progress)}"
                android:textColor="@color/color_21213b"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/tvStatus"
                app:layout_constraintEnd_toStartOf="@+id/btnControl"
                app:layout_constraintStart_toEndOf="@+id/cover"
                app:layout_constraintTop_toTopOf="@+id/cover"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="绘本生成中...1%" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:lines="1"
                android:text="@{viewModel.firstItem.status(viewModel.firstItem.progress)}"
                android:textColor="@color/color_50_21213b"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@+id/tvTitle"
                app:layout_constraintStart_toStartOf="@+id/tvTitle"
                app:layout_constraintTop_toBottomOf="@+id/tvTitle"
                tools:text="正在构思您的专属故事" />

            <ImageView
                android:id="@+id/btnControl"
                singleClick="@{(v)->viewModel.firstItem.play()}"
                android:layout_width="52dp"
                android:layout_height="0dp"
                android:alpha="@{viewModel.firstItem.playable ? 1f : 0.4f}"
                android:paddingHorizontal="12dp"
                android:src="@drawable/ic_generating_play"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>