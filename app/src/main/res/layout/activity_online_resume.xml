<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.mine.viewModel.UnderstandsViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_F5F6FA">

        <ImageView
            android:id="@+id/view_header_bg"
            android:layout_width="match_parent"
            android:layout_height="495dp"
            android:scaleType="fitXY"
            android:src="@drawable/bg_online_resume_top"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_model_toolbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:toolbar="@{layout.mToolbarVMUnderstands}" />

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/layout_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/spacing_s"
            app:layout_constraintBottom_toTopOf="@id/ll_bt"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/appbar_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/transparent"
                android:orientation="vertical"
                app:elevation="0dp">

                <com.google.android.material.appbar.CollapsingToolbarLayout
                    android:id="@+id/coll_toolbar_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_scrollFlags="scroll|exitUntilCollapsed|snap">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/ll_top"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="26dp">


                        <RelativeLayout
                            android:id="@+id/rl_bfb"
                            android:layout_width="75dp"
                            android:layout_height="75dp"
                            android:layout_marginStart="48.5dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <com.shiyuan.fastclaw.widget.progress.WaveProgressView
                                android:id="@+id/wave_view"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:wpv_progress="10"
                                app:wpv_text="0%"
                                app:wpv_textColor="@color/color_90_000000"
                                app:wpv_textSize="18sp"
                                app:wpv_waveAmplitude="@dimen/spacing_s"
                                app:wpv_waveBackgroundColor="#D9FBFE"
                                app:wpv_waveColor="#54DAF0"
                                app:wpv_waveCount="1" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/ic_pr_bg" />
                        </RelativeLayout>

                        <ImageView
                            android:layout_width="106dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="37.5dp"
                            android:scaleType="fitXY"
                            android:src="@drawable/ic_online_resume_q"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                        </ImageView>

                        <TextView
                            android:id="@+id/tv_understand_title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/online_resume_understand_title"
                            android:textColor="@color/color_96_000000"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toTopOf="@id/tv_understand_desc"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.0"
                            app:layout_constraintStart_toEndOf="@id/rl_bfb"
                            app:layout_constraintTop_toTopOf="@id/rl_bfb"
                            app:layout_constraintVertical_chainStyle="packed" />

                        <TextView
                            android:id="@+id/tv_understand_desc"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:gravity="center"
                            android:text="@string/online_resume_understand_desc"
                            android:textColor="@color/color_96_000000"
                            android:textSize="13sp"
                            app:layout_constraintBottom_toBottomOf="@id/rl_bfb"
                            app:layout_constraintEnd_toEndOf="@id/tv_understand_title"
                            app:layout_constraintStart_toStartOf="@id/tv_understand_title"
                            app:layout_constraintTop_toBottomOf="@id/tv_understand_title" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.appbar.CollapsingToolbarLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_table"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginHorizontal="@dimen/spacing_l"
                    android:background="@drawable/bg_f0f6ff_tr20">

                    <View
                        android:id="@+id/view_tab_bg"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_f0f6ff_tr20"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/ll_tab1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/ic_online_resume_tab_left"
                        android:gravity="center"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.5">

                        <TextView
                            android:id="@+id/tv_table1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/resume_information"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/iv_table1"
                            android:layout_width="52dp"
                            android:layout_height="10dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_online_resume_tab_bot"
                            app:layout_constraintBottom_toBottomOf="@id/tv_table1"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/ll_tab2"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.5">

                        <TextView
                            android:textStyle="bold"
                            android:id="@+id/tv_table2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/job_preference"
                            android:textColor="@color/color_75_3c3c43"
                            android:textSize="15sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />


                        <ImageView
                            android:id="@+id/iv_table2"
                            android:layout_width="52dp"
                            android:layout_height="10dp"
                            app:layout_constraintBottom_toBottomOf="@id/tv_table2"
                            app:layout_constraintLeft_toLeftOf="parent"
                            app:layout_constraintRight_toRightOf="parent" />


                    </androidx.constraintlayout.widget.ConstraintLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.appbar.AppBarLayout>

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="@dimen/spacing_l"
                android:background="@drawable/bg_ffffff_r20"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:paddingBottom="@dimen/spacing_xl"
                app:layout_behavior="@string/appbar_scrolling_view_behavior">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingTop="10dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_profile"
                        android:layout_width="match_parent"
                        android:layout_height="122dp"
                        android:background="@drawable/bg_f3f9ff_ffffff_r12"
                        android:padding="@dimen/spacing_m">

                        <ImageView
                            android:id="@+id/iv_avatar"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:background="@drawable/bg_2f6bff_r50"
                            android:importantForAccessibility="no"
                            android:padding="15dp"
                            android:src="@drawable/ic_resume_attachment"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/white" />

                        <TextView
                            android:id="@+id/tv_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="11dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/color_96_000000"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/iv_avatar"
                            app:layout_constraintTop_toTopOf="@id/iv_avatar"
                            tools:text="张志源" />

                        <TextView
                            android:id="@+id/tv_tip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/color_75_3c3c43"
                            android:textSize="13sp"
                            app:layout_constraintEnd_toEndOf="@id/tv_name"
                            app:layout_constraintStart_toStartOf="@id/tv_name"
                            app:layout_constraintTop_toBottomOf="@id/tv_name"
                            tools:text="@string/end_month_position" />

                        <LinearLayout
                            android:id="@+id/layout_profile_tags"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_m"
                            android:orientation="horizontal"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/iv_avatar">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_f5f6fa_r12"
                                android:paddingHorizontal="@dimen/spacing_s"
                                android:paddingVertical="@dimen/spacing_xs"
                                android:text="@string/resume_information"
                                android:textColor="@color/color_75_3c3c43"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_s"
                                android:background="@drawable/bg_f5f6fa_r12"
                                android:paddingHorizontal="@dimen/spacing_s"
                                android:paddingVertical="@dimen/spacing_xs"
                                android:text="@string/job_preference"
                                android:textColor="@color/color_75_3c3c43"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xl">

                        <FrameLayout
                            android:id="@+id/fl_understands1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/spacing_s"
                            android:paddingBottom="@dimen/spacing_l"
                            android:visibility="gone">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_understands1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:nestedScrollingEnabled="false" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/fl_understands2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="@dimen/spacing_s"
                            android:paddingBottom="@dimen/spacing_l"
                            android:visibility="gone">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_understands2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:nestedScrollingEnabled="false" />
                        </FrameLayout>

                        <include
                            android:id="@+id/view_understands"
                            layout="@layout/view_understands1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </FrameLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <FrameLayout
            android:id="@+id/ll_bt"
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:paddingHorizontal="39dp"
            android:paddingTop="@dimen/spacing_s"
            android:paddingBottom="26dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tv_bt"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_ffffff_r100"
                android:drawableStart="@drawable/ic_resume_attachment"
                android:drawablePadding="@dimen/spacing_xs"
                android:elevation="@dimen/spacing_s"
                android:gravity="center"
                android:text="@string/resume_attachment"
                android:textColor="@color/color_90_000000"
                android:textSize="15sp"
                android:textStyle="bold" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
