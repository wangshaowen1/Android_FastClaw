                </androidx.constraintlayout.widget.ConstraintLayout>-->

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_table"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:orientation="vertical"
                    android:background="@drawable/ic_understands_table1"
                    app:layout_constraintTop_toBottomOf="@id/ll_top">

                    <LinearLayout
                        android:id="@+id/ll_tab1"
                        android:paddingTop="10dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tv_table1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/resume_information"
                            android:textColor="@color/color_90_000000"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/iv_table1"
                            android:layout_marginTop="2dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_tab_cur_line"
                            android:layout_width="35dp"
                            android:layout_height="11dp"/>


                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/ll_tab2"
                        android:orientation="vertical"
                        android:paddingTop="10dp"
                        android:gravity="center_horizontal"
                        app:layout_constraintRight_toRightOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.5"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content">


                        <TextView
                            android:fontFamily="sans-serif-medium"
                            android:id="@+id/tv_table2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/job_preference"
                            android:textColor="@color/color_90_000000"
                            android:textSize="16sp" />

                        <ImageView
                            android:id="@+id/iv_table2"
                            android:visibility="gone"
                            android:layout_marginTop="2dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_tab_cur_line"
                            android:layout_width="35dp"
                            android:layout_height="11dp"/>

                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.appbar.AppBarLayout>

            <androidx.viewpager2.widget.ViewPager2
                app:layout_behavior="@string/appbar_scrolling_view_behavior"
                android:id="@+id/vp_resume_pages"
                android:layout_width="match_parent"
                android:layout_marginHorizontal="@dimen/spacing_l"
                android:layout_height="match_parent" />

        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <LinearLayout
            android:id="@+id/ll_bt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="40dp"
            android:layout_marginTop="21dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_ffffff_r20"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:paddingVertical="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_online_resume_attachment" />

            <TextView
                android:id="@+id/tv_bt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="@string/resume_attachment"
                android:textColor="@color/color_90_000000"
                android:textSize="15sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
