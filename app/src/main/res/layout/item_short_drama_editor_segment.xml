<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kgmedia.fastfilm.feature.creator.storyboard.ItemStoryboardVM" />

        <import type="android.view.View" />
    </data>

    <com.kgmedia.fastfilm.widget.BorderConstraintLayout
        showBorder="@{item.selected}"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="5dp"
        android:onClick="@{(v)->item.onItemClick.invoke(v)}"
        app:backgroundStartColor="?attr/fillColor4"
        app:borderStartColor="@color/fixed_white_1"
        app:borderWidth="1.5dp"
        app:roundCornerRadius="8dp">

        <com.kgmedia.fastfilm.widget.roundedimageview.RoundedImageView
            android:id="@+id/ivCover"
            loadThumbnailUri="@{item.data.imageUrl}"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="@{item.data.generating?View.INVISIBLE:View.VISIBLE}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="100:75"
            app:layout_constraintStart_toStartOf="parent"
            app:riv_corner_radius="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/mask_opacity_60_dark"
            android:gravity="center"
            android:text="@{item.data.generating ? `制作中` : (`分镜`+item.data.sortNo)}"
            android:textAppearance="@style/Text12"
            android:textColor="?attr/textColor1"
            android:textSize="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivCover"
            app:layout_constraintDimensionRatio="100:24"
            app:layout_constraintEnd_toEndOf="@+id/ivCover"
            app:layout_constraintStart_toStartOf="@+id/ivCover"
            tools:text="分镜1" />

        <ImageView
            setVisible="@{item.data.generating}"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/icon_ai"
            app:layout_constraintBottom_toBottomOf="@+id/ivCover"
            app:layout_constraintEnd_toEndOf="@+id/ivCover"
            app:layout_constraintStart_toStartOf="@+id/ivCover"
            app:layout_constraintTop_toTopOf="@+id/ivCover"
            app:layout_constraintVertical_bias="0.4" />

    </com.kgmedia.fastfilm.widget.BorderConstraintLayout>
</layout>