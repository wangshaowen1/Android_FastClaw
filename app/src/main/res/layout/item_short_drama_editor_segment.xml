<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kgmedia.fastfilm.feature.editor.ItemShortDramaSegmentVM" />


        <import type="android.view.View" />
    </data>

    <com.kgmedia.fastfilm.widget.BorderConstraintLayout
        showBorder="@{item.selected}"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:onClick="@{(v)->item.onItemClick.invoke(v)}"
        app:borderEndColor="@color/color_ffa029"
        app:borderStartColor="@color/color_ff4332"
        app:borderWidth="2dp"
        app:roundCornerRadius="8dp">

        <com.kgmedia.fastfilm.widget.roundedimageview.RoundedImageView
            android:id="@+id/ivCover"
            loadThumbnailUri="@{item.data.shotSegmentImageUrl}"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="@{item.data.generating?View.INVISIBLE:View.VISIBLE}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="78:58"
            app:layout_constraintStart_toStartOf="parent"
            app:riv_corner_radius="8dp" />

        <TextView
            setVisible="@{!item.data.generated}"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_121212_r8"
            android:gravity="center"
            android:text="@{item.genStatusSimple(item.data.genStatus)}"
            android:textColor="@color/color_50_ffffff"
            android:textSize="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivCover"
            app:layout_constraintEnd_toEndOf="@+id/ivCover"
            app:layout_constraintStart_toStartOf="@+id/ivCover"
            app:layout_constraintTop_toTopOf="@+id/ivCover"
            tools:text="排队中...." />

        <com.kgmedia.fastfilm.widget.roundedimageview.RoundedImageView
            setVisible="@{item.index>2 &amp;&amp; item.firstGenLocked &amp;&amp; item.allSegmentsGenerated}"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_locked_segment"
            app:layout_constraintBottom_toBottomOf="@+id/ivCover"
            app:layout_constraintEnd_toEndOf="@+id/ivCover"
            app:layout_constraintStart_toStartOf="@+id/ivCover"
            app:layout_constraintTop_toTopOf="@+id/ivCover"
            app:riv_corner_radius="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_10_ffffff_tl8_br8"
            android:gravity="center"
            android:text="@{``+item.data.sequenceNumber}"
            android:textColor="@android:color/white"
            android:textSize="10dp"
            android:textStyle="bold"
            app:layout_constraintDimensionRatio="28:20"
            app:layout_constraintStart_toStartOf="@+id/ivCover"
            app:layout_constraintTop_toTopOf="@+id/ivCover"
            app:layout_constraintWidth_percent="0.358974358974"
            tools:text="03" />
    </com.kgmedia.fastfilm.widget.BorderConstraintLayout>
</layout>