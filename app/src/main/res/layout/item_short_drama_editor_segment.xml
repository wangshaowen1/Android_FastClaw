<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kgmedia.fastfilm.feature.editor.ItemShortDramaSegmentVM" />


        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="5dp"
        android:onClick="@{(v)->item.onItemClick.invoke(v)}">

        <com.kgmedia.fastfilm.widget.roundedimageview.RoundedImageView
            android:id="@+id/ivCover"
            loadThumbnailUri="@{item.data.shotSegmentImageUrl}"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="@{item.data.generating?View.INVISIBLE:View.VISIBLE}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="100:75"
            app:layout_constraintStart_toStartOf="parent"
            app:riv_border_color="@color/fixed_white_1"
            app:riv_border_width="1.5dp"
            app:riv_corner_radius="8dp"
            tools:src="?attr/funcColorSuccess" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/mask_opacity_60_dark"
            android:gravity="center"
            android:text="@{`分镜`+item.data.sequenceNumber}"
            android:textAppearance="@style/Text12"
            android:textColor="?attr/textColor1"
            android:textSize="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivCover"
            app:layout_constraintDimensionRatio="100:24"
            app:layout_constraintEnd_toEndOf="@+id/ivCover"
            app:layout_constraintStart_toStartOf="@+id/ivCover"
            tools:text="分镜1" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>