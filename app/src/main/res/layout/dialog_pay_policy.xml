<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ffffff_r20"
    android:paddingHorizontal="30dp"
    android:paddingTop="24dp"
    android:paddingBottom="28dp">

    <TextView
        android:id="@+id/tvTitle"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/color_90_000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="@string/policy_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"
        android:id="@+id/tvContent"
        style="@style/Text14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="@dimen/lineSpacingExtra"
        android:textColor="@color/color_75_3c3c43"
        android:text="@string/policy_content" />

    <TextView
        android:fontFamily="sans-serif-medium"
        tools:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnAgree"
        app:layout_constraintTop_toTopOf="@id/btnAgree"
        app:layout_constraintBottom_toBottomOf="@id/btnAgree"
        android:layout_marginEnd="8dp"
        android:id="@+id/btnReject"
        android:layout_width="90dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_br1_3c3c43_r100"
        android:gravity="center"
        android:text="@string/app_not_agree_and_quit"
        android:textStyle="bold"
        android:textColor="@color/color_75_3c3c43"
        android:textSize="14sp"/>

    <Button
        android:fontFamily="sans-serif-medium"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toEndOf="@id/btnReject"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvContent"
        android:id="@+id/btnAgree"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_336fff_r100"
        android:gravity="center"
        android:text="@string/app_agree_and_sign_in"
        android:textColor="@color/white"
        android:textSize="16sp" />

</androidx.constraintlayout.widget.ConstraintLayout>
