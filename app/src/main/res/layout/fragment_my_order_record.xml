<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.mine.fragment.MyOrderRecordViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_f5f6fa"
        android:orientation="vertical"
        android:paddingTop="@dimen/spacing_xl">

        <TextView
            android:id="@+id/tv_problem_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:text="@string/my_order_problem_tip"
            android:textColor="@color/color_75_3c3c43"
            android:textSize="12sp"
            tools:text="订单问题请 联系客服" />

        <com.scwang.smart.refresh.layout.SmartRefreshLayout
            android:id="@+id/srl"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:paddingTop="@dimen/spacing_m"
            app:srlEnableLoadMore="false">

            <com.shiyuan.fastclaw.widget.LoadStateViewHolder
                android:id="@+id/lsv_order_record"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:noData="@string/no_data"
                app:noDataTextColor="@color/color_85_3c3c43"
                app:noDataTextSize="14sp"
                app:noDataTextBold="false"
                app:noDataSrc="@drawable/ic_empty">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_order_record"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ffffff_r12"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="11dp"
                    android:paddingTop="@dimen/spacing_l"
                    android:paddingBottom="@dimen/spacing_l"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_my_order_record" />
            </com.shiyuan.fastclaw.widget.LoadStateViewHolder>
        </com.scwang.smart.refresh.layout.SmartRefreshLayout>
    </LinearLayout>
</layout>
