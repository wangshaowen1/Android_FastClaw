<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kgmedia.fastfilm.feature.login.ItemAgeRangeVM" />
    </data>

    <com.kgmedia.fastfilm.widget.BorderConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="5dp"
        android:layout_marginBottom="18dp"
        app:backgroundEndColor="@color/color_f5f5f5"
        app:backgroundStartColor="@color/color_f5f5f5"
        app:borderEndColor="@color/color_ffa029"
        app:borderStartColor="@color/color_ff4332"
        app:borderWidth="2dp"
        app:roundCornerRadius="8dp"
        app:showBorder="@{item.data.id==item.selectedItem.id}">

        <TextView
            singleClick="@{(v)->item.onItemClick.invoke(v)}"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="@{item.data.eraDesc}"
            android:textColor="@{item.data.id==item.selectedItem.id?@color/color_ff4b00:@color/textColorPrimary}"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="20-25"
            tools:textColor="@color/textColorPrimary" />
    </com.kgmedia.fastfilm.widget.BorderConstraintLayout>
</layout>