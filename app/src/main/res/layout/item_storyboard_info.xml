<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kgmedia.fastfilm.feature.creator.generate.ItemStoryboardVM" />

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />

    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_faf9f7_r12"
        android:minHeight="100dp">

        <TextView
            singleClick="@{(v)->item.onItemClick.invoke(v)}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingTop="30dp"
            android:paddingBottom="12dp"
            android:text="@{item.showText}"
            android:textColor="@color/color_70_121212"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="@{!TextUtils.isEmpty(item.data.shotSegmentId)?View.VISIBLE:View.GONE}"
            tools:text="幽静竹林中，熊猫阿宝正将所能掌控的优雅尽数倾注于太极练习中。" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="生成失败"
                android:textColor="@color/color_50_121212"
                android:textSize="12sp" />

            <com.kgmedia.fastfilm.widget.BorderConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingHorizontal="15dp"
                android:paddingVertical="5dp"
                app:borderEndColor="#FF4332"
                app:borderStartColor="#FFA029"
                app:borderWidth="1dp"
                app:roundCornerRadius="50dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="重新生成"
                    android:textColor="@color/color_ff4b00"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </com.kgmedia.fastfilm.widget.BorderConstraintLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:drawableStart="@drawable/ic_add_gray48"
            android:drawablePadding="2dp"
            android:gravity="center"
            android:text="新增分镜"
            android:textColor="@color/color_50_121212"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawableTop="@drawable/ic_loading_gray"
            android:gravity="center"
            android:text="正在生成中...."
            android:textColor="@color/color_50_121212"
            android:textSize="12sp"
            android:visibility="@{TextUtils.isEmpty(item.data.shotSegmentId)?View.VISIBLE:View.GONE}" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ffcaa5_top_left_leaf_r12"
            android:includeFontPadding="false"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="@{item.data.sequenceNumber+``}"
            android:textColor="@color/color_c45f00"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="01" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:src="@drawable/ic_edit_green60"
            android:visibility="@{!TextUtils.isEmpty(item.data.shotSegmentId)?View.VISIBLE:View.GONE}" />
    </FrameLayout>
</layout>
