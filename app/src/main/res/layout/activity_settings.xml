<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.settings.SettingsViewModel" />

        <import type="com.kgmedia.fastfilm.common.utils.DebugUtils" />

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />

        <import type="com.kgmedia.fastfilm.common.ext.FormatUtils" />
    </data>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_model_toolbar"
            app:toolbar="@{layout.mToolbarVM}" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:background="@drawable/bg_white_rectangle_corner_r16"
                    android:layout_marginHorizontal="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/sll_personal_information"
                        singleClick="@{layout.clickHandler::onClick}"
                        android:background="@drawable/selector_item_background_top_r16"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"


                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="12dp">

                        <TextView
                            style="@style/Text.Medium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/app_personal_information"
                            android:textColor="@color/textColorPrimary"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:src="@drawable/arrow_right_gray36" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/sll_phone"
                        singleClick="@{layout.clickHandler::onClick}"
                        android:background="@drawable/selector_item_background"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="12dp">

                        <TextView
                            style="@style/Text.Medium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="手机号码"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/Text.Common"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:hint="未绑定"
                            android:text="@{TextUtils.isEmpty(layout.phone)?``:FormatUtils.encryptPhoneNum(layout.phone)}"
                            android:textColorHint="@color/color_ff8676"
                            android:textColor="@color/color_60_121212"
                            android:textSize="12sp" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/arrow_right_gray36" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/sll_about_us"
                        singleClick="@{layout.clickHandler::onClick}"
                        android:background="@drawable/selector_item_background"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="12dp">

                        <TextView
                            style="@style/Text.Medium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/app_about_us"
                            android:textColor="@color/textColorPrimary"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:src="@drawable/arrow_right_gray36" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/sll_contact_customer_service"
                        singleClick="@{layout.clickHandler::onClick}"
                        android:background="@drawable/selector_item_background"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="12dp">

                        <TextView
                            style="@style/Text.Medium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/app_contact_customer_service"
                            android:textColor="@color/textColorPrimary"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/Text.Common"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:text="@string/app_customer_service_hours"
                            android:textColor="@color/color_60_121212"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:src="@drawable/arrow_right_gray36" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/sll_suggestion_and_feedback"
                        singleClick="@{layout.clickHandler::onClick}"
                        android:background="@drawable/selector_item_background"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="12dp">

                        <TextView
                            style="@style/Text.Medium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/app_suggestion_and_feedback"
                            android:textColor="@color/textColorPrimary"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:src="@drawable/arrow_right_gray36" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/sll_cancel_the_account"
                        singleClick="@{layout.clickHandler::onClick}"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/selector_item_background_bottom_r16"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="12dp">

                        <TextView
                            style="@style/Text.Medium"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/app_cancel_the_account"
                            android:textColor="@color/textColorPrimary"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:importantForAccessibility="no"
                            android:src="@drawable/arrow_right_gray36" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_white_rectangle_corner_r16"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:visibility="@{DebugUtils.INSTANCE.isDebug()?View.VISIBLE:View.GONE}">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="测试IP="
                        android:textColor="@color/textColorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etIp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:text="@={layout.debugIp}"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnIPConfirm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="确定 "
                        android:textColor="@color/textColorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnIPSelect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" 选择"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <Button
                    android:id="@+id/stv_log_out"
                    style="@style/Button.Bold"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="79dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="50dp"
                    android:gravity="center"
                    android:text="@string/app_log_out" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>