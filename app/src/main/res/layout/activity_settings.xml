<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.settings.SettingsViewModel" />

        <import type="com.shiyuan.fastclaw.common.utils.DebugUtils" />

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />

        <import type="com.shiyuan.fastclaw.common.ext.FormatUtils" />
    </data>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:windowBackground"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_model_toolbar"
            app:toolbar="@{layout.mToolbarVM}" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <RelativeLayout
                    singleClick="@{layout.clickHandler::onClick}"
                    android:id="@+id/rl1"
                    android:background="@drawable/bg_ffffff_r12"
                    android:paddingVertical="18dp"
                    android:paddingHorizontal="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:ignore="UselessParent">

                    <TextView
                        android:text="@string/app_user_agreement"
                        android:textColor="@color/color_1a1a1a"
                        android:textSize="16sp"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                    </TextView>


                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:importantForAccessibility="no"
                        android:src="@mipmap/ic_arrow_right" />
                </RelativeLayout>

                <RelativeLayout
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_marginTop="16dp"
                    android:id="@+id/rl2"
                    android:background="@drawable/bg_ffffff_r12"
                    android:paddingVertical="18dp"
                    android:paddingHorizontal="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:ignore="UselessParent">

                    <TextView
                        android:text="@string/app_privacy_policy"
                        android:textColor="@color/color_1a1a1a"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                    </TextView>


                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:importantForAccessibility="no"
                        android:src="@mipmap/ic_arrow_right" />
                </RelativeLayout>

                <RelativeLayout
                    singleClick="@{layout.clickHandler::onClick}"
                    android:id="@+id/rl3"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_ffffff_r12"
                    android:paddingVertical="18dp"
                    android:paddingHorizontal="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:ignore="UselessParent">

                    <TextView
                        android:text="@string/app_about_fast_claw"
                        android:textColor="@color/color_1a1a1a"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                    </TextView>


                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:importantForAccessibility="no"
                        android:src="@mipmap/ic_arrow_right" />
                </RelativeLayout>


                <RelativeLayout
                    singleClick="@{layout.clickHandler::onClick}"
                    android:id="@+id/rl4"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_ffffff_r12"
                    android:paddingVertical="18dp"
                    android:paddingHorizontal="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:ignore="UselessParent">

                    <TextView
                        android:id="@+id/tv_lg"
                        android:layout_centerInParent="true"
                        android:text="@string/app_log_out"
                        android:textColor="@color/color_1a1a1a"
                        android:textSize="16sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                    </TextView>

                </RelativeLayout>


            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</layout>