<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.mine.MineViewModel" />

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:windowBackground"
            android:orientation="vertical">

            <com.shiyuan.fastclaw.widget.StatusBarView
                android:id="@+id/sbv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_marginHorizontal="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RelativeLayout
                    android:paddingVertical="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mine_title"
                        android:textColor="@color/color_1a1a1a"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <ImageView
                        singleClick="@{layout.clickHandler::onClick}"
                        android:id="@+id/iv_setting"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:importantForAccessibility="no"
                        android:src="@mipmap/ic_mine_setting" />


                </RelativeLayout>

                <LinearLayout
                    android:layout_marginTop="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    tools:ignore="UselessParent">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/siv_avatar"
                        loadUri="@{layout.userInfo[`avatar`]}"
                        placeHolder="@{@drawable/ic_default_avatar}"
                        singleClick="@{layout.clickHandler::onClick}"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_default_avatar"
                        app:shapeAppearanceOverlay="@style/roundStyle_circle" />


                    <TextView
                        singleClick="@{layout.clickHandler::onClick}"
                        android:id="@+id/tv_name"
                        android:layout_marginStart="@dimen/dp20"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="@={layout.userInfo[`nickname`]}"
                        android:textColor="@color/color_1a1a1a"
                        android:textSize="17sp"
                        android:textStyle="bold" />


                </LinearLayout>


                <LinearLayout
                    android:paddingTop="@dimen/dp20"
                    android:paddingBottom="24dp"
                    android:paddingHorizontal="16dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_ffffff_r12"
                    android:layout_marginTop="@dimen/dp20"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:ignore="UselessLeaf">

                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mine_sticks"
                        android:textColor="@color/color_1a1a1a"
                        android:textSize="14sp"
                        android:textStyle="bold" />


                   <RelativeLayout
                       singleClick="@{layout.clickHandler::onClick}"
                       android:id="@+id/rl_xt"
                       android:layout_marginTop="12dp"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content">

                       <TextView
                           android:id="@+id/tv_points"
                           android:text="0"
                           android:textColor="@color/color_1a1a1a"
                           android:textSize="32sp"
                           android:textStyle="bold"
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content">
                       </TextView>


                       <ImageView
                           android:layout_width="16dp"
                           android:layout_height="16dp"
                           android:layout_alignParentEnd="true"
                           android:layout_centerVertical="true"
                           android:importantForAccessibility="no"
                           android:src="@mipmap/ic_arrow_right" />
                   </RelativeLayout>


                   <RelativeLayout
                       android:visibility="gone"
                       android:layout_marginTop="12dp"
                       android:paddingVertical="6dp"
                       android:paddingHorizontal="12dp"
                       android:id="@+id/rl_points"
                        android:background="@drawable/bg_f3f5f6_r100"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_centerVertical="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/mine_tip"
                            android:textColor="@color/color_666666"
                            android:textSize="12sp" />

                        <TextView
                            android:textStyle="bold"
                            android:paddingVertical="4dp"
                            android:paddingHorizontal="12dp"
                            android:background="@drawable/bg_0099ff_r100"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:text="@string/mine_tip2"
                            android:textColor="@color/white"
                            android:textSize="12sp" />

                    </RelativeLayout>


                </LinearLayout>


            </LinearLayout>

        </LinearLayout>


    </FrameLayout>
</layout>