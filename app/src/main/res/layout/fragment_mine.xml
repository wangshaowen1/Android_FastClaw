<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.mine.MineViewModel" />

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:windowBackground"
        android:orientation="vertical">

        <com.kgmedia.fastfilm.widget.StatusBarView
            android:id="@+id/sbv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_l">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/siv_avatar"
                loadUri="@{layout.userInfo[`avatar`]}"
                placeHolder="@{@drawable/ic_default_avatar_big}"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="@dimen/spacing_l"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_default_avatar_big"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/roundStyle_circle" />

            <TextView
                android:id="@+id/tv_login"
                style="@style/TextTitle"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:text="登录/注册"
                android:textColor="@color/text_color_1_dark"
                android:visibility="@{layout.isLogin()?View.GONE:View.VISIBLE}"
                app:layout_constraintBottom_toBottomOf="@id/siv_avatar"
                app:layout_constraintStart_toEndOf="@id/siv_avatar"
                app:layout_constraintTop_toTopOf="@id/siv_avatar"
                tools:visibility="gone" />

            <androidx.constraintlayout.widget.Group
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="@{layout.isLogin()?View.VISIBLE:View.GONE}"
                app:constraint_referenced_ids="tv_name,tv_id,iv_copy" />

            <TextView
                android:id="@+id/tv_name"
                style="@style/TextTitle"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_m"
                android:layout_marginTop="@dimen/spacing_s"
                android:text="@{layout.userInfo[`nickname`]}"
                android:textColor="@color/text_color_1_dark"
                app:layout_constraintBottom_toTopOf="@id/tv_id"
                app:layout_constraintStart_toEndOf="@id/siv_avatar"
                app:layout_constraintTop_toTopOf="@id/siv_avatar"
                tools:text="Duebass" />

            <TextView
                android:id="@+id/tv_id"
                style="@style/TextBody"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_s"
                android:text="@{`ID:`+layout.userInfo[`city`]}"
                android:textColor="@color/text_color_3_dark"
                app:layout_constraintBottom_toBottomOf="@id/siv_avatar"
                app:layout_constraintStart_toStartOf="@id/tv_name"
                app:layout_constraintTop_toBottomOf="@id/tv_name"
                tools:text="ID:10000" />

            <ImageView
                android:id="@+id/iv_copy"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_copy"
                app:layout_constraintBottom_toBottomOf="@id/tv_id"
                app:layout_constraintStart_toEndOf="@id/tv_id"
                app:layout_constraintTop_toTopOf="@id/tv_id" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_06_ffffff_r12"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/suggestions_feedback"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_l">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no" />

                <TextView
                    style="@style/TextBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_m"
                    android:layout_weight="1"
                    android:text="建议与反馈"
                    android:textColor="@color/text_color_3_dark" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_settings"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_l">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_mine_settings"
                    android:importantForAccessibility="no" />

                <TextView
                    style="@style/TextBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_m"
                    android:layout_weight="1"
                    android:text="设置"
                    android:textColor="@color/text_color_3_dark" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:importantForAccessibility="no" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</layout>