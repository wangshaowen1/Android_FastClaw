<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.mine.viewModel.MineViewModel" />

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:src="@drawable/img_mine_top_bg"
            app:layout_constraintTop_toTopOf="parent" />

        <com.shiyuan.fastclaw.widget.StatusBarView
            android:id="@+id/sbv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/siv_avatar"
            loadUri="@{layout.userInfo[`avatar`]}"
            placeHolder="@{@drawable/ic_default_avatar}"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="30dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_default_avatar"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sbv"
            app:shapeAppearanceOverlay="@style/roundStyle_circle" />

        <TextView
            android:id="@+id/tv_name"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="@={layout.userInfo[`nickname`]}"
            android:textColor="@color/color_1a1a1a"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/siv_avatar"
            app:layout_constraintLeft_toRightOf="@id/siv_avatar"
            app:layout_constraintRight_toLeftOf="@id/iv_setting"
            app:layout_constraintTop_toTopOf="@id/siv_avatar"
            tools:text="虾米虾米" />

        <ImageView
            android:id="@+id/iv_setting"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="26dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_mine_setting"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sbv" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_mine_point"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/img_mine_xt_bg"
            android:paddingHorizontal="10dp"
            android:paddingTop="24dp"
            android:paddingBottom="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/siv_avatar">


            <TextView
                android:id="@+id/tv_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@{layout.userPoints}"
                android:textColor="@color/color_242424"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="-" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mine_sticks"
                android:textColor="@color/color_242424"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintLeft_toLeftOf="@id/tv_points"
                app:layout_constraintTop_toBottomOf="@id/tv_points" />


            <View
                android:id="@+id/v"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                app:layout_constraintLeft_toLeftOf="@id/tv_title"
                app:layout_constraintTop_toBottomOf="@id/tv_title" />


            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                app:layout_constraintBottom_toBottomOf="@id/tv_title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_points" />


            <TextView
                android:id="@+id/tv_mine_points_tip"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_7affffff_r100"
                android:paddingVertical="9dp"
                android:paddingStart="12dp"
                android:paddingEnd="72dp"
                android:text="@string/mine_tip"
                android:textColor="@color/color_30817b"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/v"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tv_mine_tip_btn"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_242424_r100"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="@string/mine_tip2"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tv_mine_points_tip"
                app:layout_constraintEnd_toEndOf="@id/tv_mine_points_tip"
                app:layout_constraintTop_toTopOf="@id/tv_mine_points_tip"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_mine_lj"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="17dp"
            android:background="@drawable/gradient_top_e6f7ff_bottom_ffffff_r16"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/layout_mine_point">


            <RelativeLayout
                android:id="@+id/rl_bfb"
                android:layout_width="56dp"
                android:layout_height="56dp"
                tools:ignore="MissingConstraints">

                <com.shiyuan.fastclaw.widget.progress.WaveProgressView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:wpv_progress="60"
                    app:wpv_text="60%"
                    app:wpv_textColor="@color/color_90_000000"
                    app:wpv_textSize="18sp"
                    app:wpv_waveAmplitude="8dp"
                    app:wpv_waveBackgroundColor="#D9FBFE"
                    app:wpv_waveColor="#54DAF0"
                    app:wpv_waveCount="1" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/ic_pr_bg"/>

            </RelativeLayout>


            <TextView
                android:id="@+id/tv_dn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:text="@string/resume_understanding"
                android:textColor="@color/color_2a4b46"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintLeft_toRightOf="@id/rl_bfb"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/resume_dn"
                android:textColor="@color/color_556973"
                android:textSize="12sp"
                app:layout_constraintLeft_toLeftOf="@id/tv_dn"
                app:layout_constraintTop_toBottomOf="@id/tv_dn" />

            <TextView
                android:id="@+id/tv_k"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="查看完整报告"
                android:textColor="@color/color_56_3c3c43"
                android:textSize="12dp"
                app:layout_constraintBottom_toBottomOf="@id/tv_dn"
                app:layout_constraintRight_toLeftOf="@id/iv"
                app:layout_constraintTop_toTopOf="@id/tv_dn" />

            <ImageView
                android:id="@+id/iv"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                app:layout_constraintBottom_toBottomOf="@id/tv_k"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_k" />


        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_mine_bj"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_f7f7f7_r16"
            android:paddingHorizontal="16dp"
            android:paddingVertical="20dp"
            app:layout_constraintTop_toBottomOf="@id/layout_mine_lj">

            <ImageView
                android:id="@+id/iv_jl"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_file_success"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text="@string/confirm_my_resume"
                android:textColor="@color/color_90_000000"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/iv_jl"
                app:layout_constraintLeft_toRightOf="@id/iv_jl"
                app:layout_constraintTop_toTopOf="@id/iv_jl" />


            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                app:layout_constraintBottom_toBottomOf="@id/iv_jl"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@id/iv_jl" />


        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>