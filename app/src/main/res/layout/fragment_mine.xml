<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.mine.MineViewModel" />

        <import type="android.view.View" />

        <import type="android.text.TextUtils" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.shiyuan.fastclaw.widget.StatusBarView
            android:id="@+id/sbv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_mine_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="10dp"
            android:text="@string/mine_title"
            android:textColor="@color/color_1a1a1a"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sbv" />

        <ImageView
            android:id="@+id/iv_setting"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="13dp"
            android:importantForAccessibility="no"
            android:padding="3dp"
            android:src="@drawable/ic_mine_setting"
            app:layout_constraintBottom_toBottomOf="@id/tv_mine_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_mine_title" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/siv_avatar"
            loadUri="@{layout.userInfo[`avatar`]}"
            placeHolder="@{@drawable/ic_default_avatar}"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="26dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_default_avatar"
            app:layout_constraintStart_toStartOf="@id/tv_mine_title"
            app:layout_constraintTop_toBottomOf="@id/tv_mine_title"
            app:shapeAppearanceOverlay="@style/roundStyle_circle" />

        <TextView
            android:id="@+id/tv_name"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:text="@={layout.userInfo[`nickname`]}"
            android:textColor="@color/color_1a1a1a"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@id/siv_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/siv_avatar"
            app:layout_constraintTop_toTopOf="@id/siv_avatar"
            tools:text="虾米虾米12345" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_mine_point"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_ffffff_r12"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/siv_avatar">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mine_sticks"
                android:textColor="@color/color_1a1a1a"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@{layout.userPoints}"
                android:textColor="@color/color_1a1a1a"
                android:textSize="32sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/tv_title"
                app:layout_constraintTop_toBottomOf="@id/tv_title"
                tools:text="-" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                app:layout_constraintBottom_toBottomOf="@id/tv_points"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_points" />

            <TextView
                android:id="@+id/tv_mine_points_tip"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_f3f5f6_r100"
                android:paddingVertical="9dp"
                android:paddingStart="12dp"
                android:paddingEnd="72dp"
                android:text="@string/mine_tip"
                android:textColor="@color/color_666666"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_points"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tv_mine_tip_btn"
                singleClick="@{layout.clickHandler::onClick}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_0099ff_r100"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="@string/mine_tip2"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tv_mine_points_tip"
                app:layout_constraintEnd_toEndOf="@id/tv_mine_points_tip"
                app:layout_constraintTop_toTopOf="@id/tv_mine_points_tip"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>