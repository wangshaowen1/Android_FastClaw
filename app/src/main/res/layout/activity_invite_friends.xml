<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.invite.InviteFriendsViewModel" />
    </data>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_E9F1FF">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar_layout"
            android:layout_width="match_parent"
            android:layout_height="366dp"
            android:background="@color/transparent"
            app:elevation="0dp">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:contentScrim="@color/transparent"
                app:layout_scrollFlags="scroll|exitUntilCollapsed|snap">

                <ImageView
                    android:id="@+id/iv_header"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/img_invite_friends_header"
                    app:layout_collapseMode="parallax"
                    app:layout_collapseParallaxMultiplier="0.7" />

            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/spacing_xl"
            app:behavior_overlapTop="142dp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/spacing_m">

                <LinearLayout
                    android:id="@+id/reward_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_80_ffffff_ffffff_r20"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/invite_reward_prefix"
                            android:textColor="@color/color_95_121D27"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/invite_reward_one"
                            android:textColor="@color/color_95_121D27"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/invite_reward_middle"
                            android:textColor="@color/color_95_121D27"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/invite_reward_point"
                            android:textColor="@color/color_FF5842"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/invite_reward_suffix"
                            android:textColor="@color/color_FF5842"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical">

                        <include
                            android:id="@+id/reward_register"
                            layout="@layout/view_invite_reward_item"
                            app:amountText="@{@string/invite_reward_register_amount}"
                            app:descText="@{@string/invite_reward_register_desc}"
                            app:iconRes="@{@drawable/img_invite_reward_register}"
                            app:titleText="@{@string/invite_reward_register_title}" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="12dp" />

                        <include
                            android:id="@+id/reward_experience"
                            layout="@layout/view_invite_reward_item"
                            app:amountText="@{@string/invite_reward_experience_amount}"
                            app:descText="@{@string/invite_reward_experience_desc}"
                            app:iconRes="@{@drawable/img_invite_reward_experience}"
                            app:titleText="@{@string/invite_reward_experience_title}"
                            tools:ignore="IncludeLayoutParam" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_invite_now"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_fa4736_fc7c41_stroke_99ffaeb1_r50"
                        android:gravity="center"
                        android:text="@string/invite_now"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/record_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_ffffff_r20"
                    android:orientation="vertical"
                    android:paddingBottom="20dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:scaleType="centerCrop"
                            android:layout_width="match_parent"
                            android:layout_height="93dp"
                            android:src="@drawable/bg_invite_record_header" />

                        <FrameLayout
                            android:id="@+id/rl"
                            android:layout_width="match_parent"
                            android:layout_height="24dp"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="20dp">

                            <View
                                android:layout_width="73dp"
                                android:layout_height="4dp"
                                android:layout_gravity="bottom|start"
                                android:background="@drawable/bg_invite_record_title_line" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="24dp"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="start|center_vertical"
                                android:text="@string/invite_record_title"
                                android:textColor="#F2121D27"
                                android:textSize="18sp" />

                            <ImageView
                                android:layout_width="9dp"
                                android:layout_height="9dp"
                                android:layout_marginStart="76dp"
                                android:layout_marginTop="10dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_invite_record_star" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_below="@id/rl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="@dimen/spacing_l"
                            android:layout_marginTop="@dimen/spacing_xl"
                            android:background="@drawable/bg_0fff5842_r12"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingVertical="@dimen/spacing_m">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/invite_success_count"
                                    android:textColor="@color/color_60_121D27"
                                    android:textSize="13sp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_m"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@{layout.inviteSuccessCountText}"
                                        android:textColor="@color/color_FF5842"
                                        android:textSize="24sp"
                                        android:textStyle="bold"
                                        tools:text="@string/invite_success_count_value" />

                                    <TextView
                                        android:layout_marginLeft="3dp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/invite_person_unit"
                                        android:textColor="@color/color_FF5842"
                                        android:textSize="15sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="42dp"
                                android:background="@color/color_30_d9d9d9" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="15dp"
                                    android:text="@string/invite_total_reward"
                                    android:textColor="@color/color_60_121D27"
                                    android:textSize="13sp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/spacing_m"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@{layout.inviteTotalRewardText}"
                                        android:textColor="@color/color_FF5842"
                                        android:textSize="24sp"
                                        android:textStyle="bold"
                                        tools:text="@string/invite_total_reward_value" />

                                    <TextView
                                        android:layout_marginLeft="3dp"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@{layout.inviteTotalRewardUnitText}"
                                        android:textColor="@color/color_FF5842"
                                        android:textSize="15sp"
                                        tools:text="@string/invite_total_reward_unit" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                    </RelativeLayout>


                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_invite_records"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/spacing_l"
                        android:layout_marginTop="@dimen/spacing_l"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        tools:itemCount="2"
                        tools:listitem="@layout/view_invite_record_item" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:textColor="@color/color_75_3c3c43"
                    android:textSize="12sp"
                    android:text="活动最终解释权归快龙虾所有"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_model_toolbar"
            app:toolbar="@{layout.mToolbarVM}" />

        <TextView
            android:id="@+id/tv_invite_rule"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="106dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_50_000000_r10"
            android:gravity="center"
            android:text="@string/invite_rule"
            android:textColor="@color/white"
            android:textSize="12sp"
            tools:text="规则" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
