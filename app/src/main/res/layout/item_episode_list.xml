<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kgmedia.fastfilm.feature.mine.episode.ItemEpisodeListVm" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        singleClick="@{(v)->item.onItemClick()}"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ffffff_r12"
        android:padding="10dp"
        tools:layout_marginBottom="10dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/siv_picture"
            loadThumbnailUri="@{item.data.seriesCoverUrl}"
            placeHolder="@{@drawable/ic_default_cover}"
            android:layout_width="60dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/roundStyle_r4"
            tools:src="@drawable/ic_default_cover" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@{item.data.seriesName}"
            android:textColor="@color/color_121212"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/ll_details"
            app:layout_constraintStart_toStartOf="@id/ll_details"
            app:layout_constraintTop_toTopOf="@id/siv_picture"
            tools:text="回到洪荒做老大" />

        <LinearLayout
            android:id="@+id/ll_details"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/siv_picture"
            app:layout_constraintEnd_toStartOf="@id/ll_end_menu"
            app:layout_constraintStart_toEndOf="@id/siv_picture"
            app:layout_constraintTop_toTopOf="@id/siv_picture">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{item.introduction}"
                android:textColor="@color/color_50_121212"
                android:textSize="12sp"
                tools:text="共12章 I 7643播放 I 674追更" />

            <TextView
                setVisible="@{item.data.launchStatus!=1}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/listing_to_earn_profits"
                android:textColor="@color/color_f57912"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@{item.transactionDate()}"
            android:textColor="@color/color_50_121212"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="@id/siv_picture"
            app:layout_constraintEnd_toEndOf="@id/ll_details"
            app:layout_constraintStart_toStartOf="@id/ll_details"
            tools:ignore="SmallSp"
            tools:text="2025-12-12 12:12 上架" />

        <LinearLayout
            android:id="@+id/ll_end_menu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                setVisible="@{item.data.launchStatus==1}"
                singleClick="@{(v)->item.share()}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_share_wechat" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:layout_marginTop="3dp"
                    android:text="@string/share"
                    android:textColor="@color/color_3f3f3f"
                    android:textSize="10sp"
                    tools:ignore="SmallSp" />
            </LinearLayout>

            <TextView
                setVisible="@{item.data.launchStatus!=1}"
                singleClick="@{(v)->item.launch()}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_left_ff4332_right_ffa029_r50"
                android:paddingHorizontal="16dp"
                android:paddingVertical="5dp"
                android:text="@string/go_put_it_on_the_shelves"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>