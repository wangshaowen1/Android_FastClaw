<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_msg_agent_left"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <FrameLayout
        android:id="@+id/fl_bubble"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.shiyuan.fastclaw.widget.progress.WaveProgressView
            android:id="@+id/wpv_align_progress"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:wpv_progress="60"
            app:wpv_text="60%"
            app:wpv_textColor="@color/color_90_000000"
            app:wpv_textSize="14sp"
            app:wpv_waveAmplitude="8dp"
            app:wpv_waveBackgroundColor="#D9FBFE"
            app:wpv_waveColor="#54DAF0"
            app:wpv_waveCount="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/ic_pr_bg" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:includeFontPadding="false"
        android:text="@string/upload_success_title"
        android:textColor="@color/color_90_000000"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium"
        app:layout_constraintBottom_toTopOf="@id/tv_progress_desc"
        app:layout_constraintEnd_toStartOf="@id/iv_arrow"
        app:layout_constraintStart_toEndOf="@id/fl_bubble"
        app:layout_constraintTop_toTopOf="@id/fl_bubble"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_progress_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="12dp"
        android:includeFontPadding="false"
        android:textColor="@color/color_75_3c3c43"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/fl_bubble"
        app:layout_constraintEnd_toStartOf="@id/iv_arrow"
        app:layout_constraintStart_toStartOf="@id/tv_title"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        tools:text="对齐度飙升！从0%到20%" />

    <ImageView
        android:id="@+id/iv_arrow"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/icon_agent_into2"
        app:layout_constraintBottom_toBottomOf="@id/fl_bubble"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/fl_bubble" />

</androidx.constraintlayout.widget.ConstraintLayout>
