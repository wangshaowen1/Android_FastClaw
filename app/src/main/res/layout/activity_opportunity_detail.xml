<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.opportunity.vm.OpportunityViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <View
            android:layout_width="0dp"
            android:layout_height="147dp"
            android:background="@drawable/bg_opportunity_detail_top_glow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            app:toolbar="@{layout.mToolbarVMOpportunityDetail}"
            android:id="@+id/toolbar"
            layout="@layout/view_model_toolbar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/sv_opportunity_detail"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintBottom_toTopOf="@id/layout_bottom_action"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="20dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_marginTop="10dp"
                        android:id="@+id/tv_opportunity_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:includeFontPadding="false"
                        android:textColor="@color/color_96_000000"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/v_match_percent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="高级后端工程师" />

                    <TextView
                        android:id="@+id/tv_opportunity_company"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/color_96_000000"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="@id/tv_opportunity_title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_opportunity_title"
                        tools:text="腾讯科技（深圳）有限公司" />

                    <com.shiyuan.fastclaw.widget.progress.MatchPercentProgressView
                        android:id="@+id/v_match_percent"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="5dp"
                        app:layout_constraintBottom_toBottomOf="@id/tv_opportunity_company"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_opportunity_title" />

                    <LinearLayout
                        android:id="@+id/layout_job_requirements"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="11dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_opportunity_company">

                        <ImageView
                            android:scaleType="center"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_opportunity_detail_location" />

                        <TextView
                            android:id="@+id/tv_opportunity_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:includeFontPadding="false"
                            android:textColor="@color/color_55_3c3c43"
                            android:textSize="13sp"
                            tools:text="深圳" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="20dp"
                            android:contentDescription="@null"
                            android:scaleType="center"
                            android:src="@drawable/ic_opportunity_detail_experience" />

                        <TextView
                            android:id="@+id/tv_opportunity_experience"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:includeFontPadding="false"
                            android:textColor="@color/color_55_3c3c43"
                            android:textSize="13sp"
                            tools:text="3–5年" />

                        <ImageView
                            android:scaleType="center"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_opportunity_detail_education" />

                        <TextView
                            android:id="@+id/tv_opportunity_education"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:includeFontPadding="false"
                            android:textColor="@color/color_55_3c3c43"
                            android:textSize="13sp"
                            tools:text="本科" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_opportunity_salary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textColor="@color/color_2f6bff"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@id/layout_job_requirements"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/layout_job_requirements"
                        tools:text="13–30k·15薪" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tv_opportunity_introduction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="21dp"
                    android:background="@drawable/bg_opportunity_detail_card"
                    android:includeFontPadding="false"
                    android:lineHeight="21dp"
                    android:padding="12dp"
                    android:textColor="@color/color_90_000000"
                    android:textSize="14sp"
                    tools:text="这一家发展迅猛的AI初创公司，方向升级明显，而且你有现实拿到它的可能。发展前景佳，薪资涨幅高。" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/color_e9f0fe" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="22dp"
                    android:includeFontPadding="false"
                    android:text="@string/opportunity_detail_job_description"
                    android:textColor="@color/color_90_000000"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_job_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="16dp"
                    android:includeFontPadding="false"
                    android:lineHeight="24dp"
                    android:linksClickable="true"
                    android:textColor="@color/color_85_3c3c43"
                    android:textSize="14sp"
                    tools:text="【岗位职责】\n1、负责日常行政事务、办公物资管理、会议筹备与纪要整理。\n\n【任职要求】\n1、大专及以上学历，1 年以内相关工作经验...查看全部" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/color_e9f0fe" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="22dp"
                    android:includeFontPadding="false"
                    android:text="@string/opportunity_detail_work_location"
                    android:textColor="@color/color_90_000000"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_xq"
                    android:layout_width="match_parent"
                    android:layout_height="71dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_opportunity_detail_card"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/tv_location_company"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/color_90_000000"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        app:layout_constraintBottom_toTopOf="@id/tv_company_profile"
                        app:layout_constraintEnd_toStartOf="@id/iv_company_arrow"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"
                        tools:text="腾讯科技（深圳）有限公司" />

                    <TextView
                        android:id="@+id/tv_company_profile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/color_55_3c3c43"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@id/tv_location_company"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/tv_location_company"
                        tools:text="互联网 ·10000人以上·已上市" />

                    <ImageView
                        android:id="@+id/iv_company_arrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_opportunity_detail_company_arrow"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>



               <androidx.cardview.widget.CardView
                   app:cardCornerRadius="@dimen/dp20"
                   android:layout_width="match_parent"
                   android:layout_height="74dp"
                   app:cardElevation="@dimen/dp_0"
                   android:layout_marginStart="4dp"
                   android:layout_marginTop="10dp">

                   <androidx.constraintlayout.widget.ConstraintLayout
                       android:layout_width="match_parent"
                       android:layout_height="match_parent">

                       <ImageView
                           android:layout_width="match_parent"
                           android:layout_height="match_parent"
                           android:contentDescription="@null"
                           android:scaleType="fitXY"
                           android:src="@drawable/bg_opportunity_detail_map" />

                       <ImageView
                           android:id="@+id/tv_map_zs"
                           app:layout_constraintLeft_toLeftOf="parent"
                           android:layout_marginStart="70dp"
                           android:layout_marginLeft="@dimen/dp20"
                           app:layout_constraintTop_toTopOf="parent"
                           app:layout_constraintBottom_toBottomOf="parent"
                           android:layout_width="16dp"
                           android:layout_height="23dp"
                           android:contentDescription="@null"
                           android:src="@drawable/im_opportunity_map" />

                       <TextView
                           android:id="@+id/tv_work_address"
                           android:layout_marginStart="10dp"
                           app:layout_constraintTop_toTopOf="parent"
                           app:layout_constraintBottom_toBottomOf="parent"
                           app:layout_constraintStart_toEndOf="@id/tv_map_zs"
                           android:maxWidth="200dp"
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           android:layout_gravity="center_vertical|end"
                           android:layout_marginEnd="22dp"
                           android:background="@drawable/bg_opportunity_detail_address"
                           android:elevation="4dp"
                           android:includeFontPadding="false"
                           android:lineHeight="20dp"
                           android:maxLines="2"
                           android:paddingHorizontal="12dp"
                           android:paddingVertical="4dp"
                           android:textColor="@color/color_90_000000"
                           android:textSize="13sp"
                           tools:text="深圳创维半导体设计大厦西座12楼1205" />

                   </androidx.constraintlayout.widget.ConstraintLayout>

               </androidx.cardview.widget.CardView>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:background="@color/color_e9f0fe" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:scaleType="center"
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_opportunity_detail_security" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:includeFontPadding="false"
                        android:text="@string/opportunity_detail_security_tip_title"
                        android:textColor="@color/color_90_000000"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_tip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="4dp"
                    android:includeFontPadding="false"
                    android:lineHeight="24dp"
                    android:text="@string/opportunity_detail_security_tip_content"
                    android:textColor="@color/color_85_3c3c43"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/layout_bottom_action"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="5dp"
            android:paddingBottom="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tv_unsuitable"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:background="@drawable/bg_opportunity_detail_secondary_button"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/opportunity_detail_unsuitable"
                android:textColor="@color/color_2f6bff"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_communicate_now"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="2.3"
                android:background="@drawable/bg_opportunity_detail_primary_button"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/opportunity_detail_communicate_now"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
