<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.series.SeriesViewModel" />

        <import type="com.kgmedia.fastfilm.common.ext.FormatUtils" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.kgmedia.fastfilm.widget.LoadStateViewHolder
            displayChild="@{layout.loadState}"
            onRetry="@{layout::getSeriesInfo}"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.kgmedia.fastfilm.widget.StatusBarView
                    android:id="@+id/statusBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/btnEdit"
                    setVisible="@{layout.series.isMine()}"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="40dp"
                    android:layout_height="@dimen/action_bar_size"
                    android:paddingVertical="10dp"
                    android:src="@drawable/ic_edit_series"
                    app:layout_constraintEnd_toStartOf="@+id/btnMore"
                    app:layout_constraintTop_toBottomOf="@+id/statusBar" />

                <ImageView
                    android:id="@+id/btnMore"
                    setVisible="@{layout.series.isMine()}"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="40dp"
                    android:layout_height="@dimen/action_bar_size"
                    android:layout_marginEnd="8dp"
                    android:paddingVertical="10dp"
                    android:src="@drawable/ic_more_dark_72"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/statusBar" />

                <androidx.coordinatorlayout.widget.CoordinatorLayout
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/action_bar_size"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/statusBar">

                    <com.google.android.material.appbar.AppBarLayout
                        android:id="@+id/appBarLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:elevation="0dp"
                        android:stateListAnimator="@drawable/appbar_elevation">

                        <com.google.android.material.appbar.CollapsingToolbarLayout
                            android:id="@+id/toolbarLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_scrollFlags="scroll|exitUntilCollapsed">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <com.kgmedia.fastfilm.widget.roundedimageview.RoundedImageView
                                    android:id="@+id/ivCover"
                                    loadThumbnailUri="@{layout.series.seriesCoverUrl}"
                                    placeHolder="@{@drawable/ic_default_cover}"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_marginStart="16dp"
                                    android:layout_marginTop="10dp"
                                    android:scaleType="centerCrop"
                                    app:layout_constraintDimensionRatio="72:96"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintWidth_percent="0.192"
                                    app:riv_corner_radius="8dp"
                                    tools:src="@drawable/ic_default_cover" />

                                <TextView
                                    android:id="@+id/tvTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_marginEnd="16dp"
                                    android:ellipsize="end"
                                    android:lineSpacingExtra="@dimen/lineSpacingExtraShort"
                                    android:maxLines="2"
                                    android:text="@{layout.series.seriesName}"
                                    android:textColor="@color/textColorPrimary"
                                    android:textSize="16dp"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/ivCover"
                                    app:layout_constraintTop_toTopOf="@+id/ivCover"
                                    tools:text="穿成恶毒女配后，我反向攻略女主穿成恶毒女配后，我反向攻略女主" />

                                <com.kgmedia.fastfilm.widget.GradientBorderView
                                    setVisible="@{layout.series.isMine() &amp;&amp; layout.series.launchStatus == 1}"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    app:backgroundStartColor="@color/color_fff3e3"
                                    app:borderEndColor="@color/color_ffa029"
                                    app:borderStartColor="@color/color_ff4332"
                                    app:borderWidth="1dp"
                                    app:layout_constraintBottom_toBottomOf="@+id/tvPrice"
                                    app:layout_constraintEnd_toEndOf="@+id/tvPrice"
                                    app:layout_constraintStart_toStartOf="@+id/tvPrice"
                                    app:layout_constraintTop_toTopOf="@+id/tvPrice"
                                    app:roundCornerRadius="4dp" />

                                <TextView
                                    android:id="@+id/tvPrice"
                                    setVisible="@{layout.series.isMine() &amp;&amp; layout.series.launchStatus == 1}"
                                    singleClick="@{layout.clickHandler::onClick}"
                                    android:layout_width="wrap_content"
                                    android:layout_height="24dp"
                                    android:layout_marginTop="6dp"
                                    android:gravity="center"
                                    android:paddingHorizontal="12dp"
                                    android:text="@{layout.series.seriesPrice>0?`单章`+FormatUtils.formatMoney(layout.series.seriesPrice)+`元`:`全部免费`}"
                                    android:textColor="@color/color_ff4b00"
                                    android:textSize="10dp"
                                    app:layout_constraintStart_toStartOf="@+id/tvTitle"
                                    app:layout_constraintTop_toBottomOf="@+id/tvTitle"
                                    tools:text="单章3元" />

                                <TextView
                                    android:id="@+id/tvPlayNum"
                                    setVisible="@{layout.series.launchStatus == 1}"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:drawableStart="@drawable/ic_play_num"
                                    android:drawablePadding="2dp"
                                    android:gravity="center_vertical"
                                    android:text="@{FormatUtils.formatPlays(layout.series.playNum)}"
                                    android:textColor="@color/color_50_121212"
                                    android:textSize="10dp"
                                    app:layout_constraintBottom_toBottomOf="@+id/ivCover"
                                    app:layout_constraintStart_toStartOf="@+id/tvPrice"
                                    tools:text="512.1万" />

                                <TextView
                                    setVisible="@{layout.series.isMine() &amp;&amp; layout.series.launchStatus == 1}"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="16dp"
                                    android:text="已上架"
                                    android:textColor="@color/color_50_121212"
                                    android:textSize="10dp"
                                    app:layout_constraintBaseline_toBaselineOf="@+id/tvPlayNum"
                                    app:layout_constraintStart_toEndOf="@+id/tvPlayNum" />

                                <TextView
                                    android:id="@+id/tvSeriesIntro"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="16dp"
                                    android:text="故事简介"
                                    android:textColor="@color/textColorPrimary"
                                    android:textSize="14dp"
                                    android:textStyle="bold"
                                    app:layout_constraintStart_toStartOf="@+id/ivCover"
                                    app:layout_constraintTop_toBottomOf="@+id/ivCover" />

                                <com.kgmedia.fastfilm.widget.expandtextview.ExpandableTextView
                                    android:id="@+id/tvSeriesIntroDesc"
                                    text="@{layout.series.seriesIntro}"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="16dp"
                                    android:layout_marginTop="4dp"
                                    android:lineSpacingExtra="@dimen/lineSpacingExtra"
                                    android:textColor="@color/color_50_121212"
                                    android:textSize="12dp"
                                    app:collapseLines="2"
                                    app:collapseTipLabel="收起"
                                    app:expandTipLabel="展开"
                                    app:expandable="true"
                                    app:layout_constraintTop_toBottomOf="@+id/tvSeriesIntro"
                                    app:tipPosition="align_right"
                                    app:tipsColor="@color/color_50_121212"
                                    app:tipsSize="12dp" />

                                <TextView
                                    android:id="@+id/tvSeriesInfo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:layout_marginTop="16dp"
                                    android:gravity="center_vertical"
                                    android:text="@{`目录｜共`+layout.series.totalWorkNum+`章`}"
                                    android:textColor="@color/textColorPrimary"
                                    android:textSize="14dp"
                                    android:textStyle="bold"
                                    app:layout_constraintStart_toStartOf="@+id/tvSeriesIntro"
                                    app:layout_constraintTop_toBottomOf="@+id/tvSeriesIntroDesc"
                                    tools:text="目录｜共6章" />

                                <TextView
                                    android:id="@+id/btnContinueSmall"
                                    setVisible="@{layout.series.isMine() &amp;&amp; layout.series.launchStatus != 1}"
                                    singleClick="@{layout.clickHandler::onClick}"
                                    android:layout_width="wrap_content"
                                    android:layout_height="24dp"
                                    android:background="@drawable/selector_common_button"
                                    android:drawableStart="@drawable/ic_add_white"
                                    android:gravity="center"
                                    android:paddingHorizontal="6dp"
                                    android:text="续写故事"
                                    android:textColor="@android:color/white"
                                    android:textSize="12dp"
                                    app:layout_constraintBottom_toBottomOf="@+id/tvSeriesInfo"
                                    app:layout_constraintEnd_toEndOf="@+id/tvSeriesIntroDesc"
                                    app:layout_constraintTop_toTopOf="@+id/tvSeriesInfo" />
                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </com.google.android.material.appbar.CollapsingToolbarLayout>

                    </com.google.android.material.appbar.AppBarLayout>

                    <com.scwang.smart.refresh.layout.SmartRefreshLayout
                        android:id="@+id/swipeRefreshLayout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:overScrollMode="never"
                        app:layout_behavior="@string/appbar_scrolling_view_behavior"
                        app:layout_constraintDimensionRatio="375:324"
                        app:layout_constraintTop_toBottomOf="@+id/tvSubtitle"
                        app:srlAccentColor="@color/color_121212"
                        app:srlEnablePreviewInEditMode="true"
                        app:srlPrimaryColor="@color/transparent">

                        <com.kgmedia.fastfilm.widget.LoadStateViewHolder
                            android:id="@+id/loadStateViewHolder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recyclerView"
                                bottom="@{92f/375f}"
                                setPaddingByWidth="@{false}"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:clipToPadding="false"
                                android:orientation="vertical"
                                android:overScrollMode="never"
                                android:scrollbars="none"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                tools:listitem="@layout/item_series_episode" />

                        </com.kgmedia.fastfilm.widget.LoadStateViewHolder>
                    </com.scwang.smart.refresh.layout.SmartRefreshLayout>

                </androidx.coordinatorlayout.widget.CoordinatorLayout>

                <View
                    android:id="@+id/shadow"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:background="@drawable/gradient_top_00_ffffff_bottom_ffffff"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="375:92" />

                <LinearLayout
                    android:id="@+id/btnShare"
                    setVisible="@{layout.series.launchStatus == 1}"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/btn_gradient_left_44c13b_right_43e638_r50"
                    android:gravity="center"
                    app:layout_constraintBottom_toBottomOf="@+id/shadow"
                    app:layout_constraintDimensionRatio="120:48"
                    app:layout_constraintStart_toStartOf="@+id/shadow"
                    app:layout_constraintTop_toTopOf="@+id/shadow"
                    app:layout_constraintWidth_percent="0.32">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_share_72" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="分享"
                        android:textColor="@android:color/white"
                        android:textSize="16dp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btnContinue"
                    setVisible="@{layout.series.isMine() &amp;&amp; layout.series.launchStatus == 1}"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@drawable/btn_common_dark_normal"
                    android:gravity="center"
                    android:text="续写故事"
                    android:textColor="@android:color/white"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/btnShare"
                    app:layout_constraintEnd_toEndOf="@+id/shadow"
                    app:layout_constraintStart_toEndOf="@+id/btnShare"
                    app:layout_constraintTop_toTopOf="@+id/btnShare" />

                <TextView
                    android:id="@+id/btnSubscribe"
                    setVisible="@{!layout.series.isMine() &amp;&amp; layout.series.launchStatus == 1}"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@drawable/btn_common_dark_normal"
                    android:gravity="center"
                    android:text="@{layout.subscribed? `已追更` : `追更`}"
                    android:textColor="@android:color/white"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/btnShare"
                    app:layout_constraintEnd_toEndOf="@+id/shadow"
                    app:layout_constraintStart_toEndOf="@+id/btnShare"
                    app:layout_constraintTop_toTopOf="@+id/btnShare"
                    tools:text="追更" />

                <TextView
                    android:id="@+id/btnRelease"
                    setVisible="@{layout.series.isMine() &amp;&amp; layout.series.launchStatus != 1}"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/btn_common_dark_normal"
                    android:gravity="center"
                    android:text="上架小说"
                    android:textColor="@android:color/white"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@+id/shadow"
                    app:layout_constraintDimensionRatio="317:48"
                    app:layout_constraintEnd_toEndOf="@+id/shadow"
                    app:layout_constraintStart_toStartOf="@+id/shadow"
                    app:layout_constraintTop_toTopOf="@+id/shadow"
                    app:layout_constraintWidth_percent="0.8453" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.kgmedia.fastfilm.widget.LoadStateViewHolder>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.kgmedia.fastfilm.widget.StatusBarView
                android:id="@+id/statusBar1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/btnBack"
                singleClick="@{(v)->layout.back()}"
                android:layout_width="56dp"
                android:layout_height="@dimen/action_bar_size"
                android:paddingVertical="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_nav_back_black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/statusBar1" />
        </LinearLayout>

    </FrameLayout>

</layout>