<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.series.SeriesViewModel" />

    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:windowBackground">

        <com.kgmedia.fastfilm.widget.LoadStateViewHolder
            displayChild="@{layout.loadState}"
            onRetry="@{layout::getWorkDtl}"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.kgmedia.fastfilm.widget.StatusBarView
                    android:id="@+id/statusBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/btnMore"
                    setVisible="@{layout.workInfo.isMine()}"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="48dp"
                    android:layout_height="@dimen/action_bar_size"
                    android:layout_marginEnd="8dp"
                    android:paddingVertical="10dp"
                    android:src="@drawable/icon_more"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/statusBar" />

                <androidx.coordinatorlayout.widget.CoordinatorLayout
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/action_bar_size"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/statusBar">

                    <com.google.android.material.appbar.AppBarLayout
                        android:id="@+id/appBarLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:elevation="0dp"
                        android:stateListAnimator="@drawable/appbar_elevation">

                        <com.google.android.material.appbar.CollapsingToolbarLayout
                            android:id="@+id/toolbarLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_scrollFlags="scroll|exitUntilCollapsed">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/ivCover"
                                    loadThumbnailUri="@{layout.workInfo.workCoverUrl}"
                                    placeHolder="@{@color/fill_color_1_dark}"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_marginStart="15dp"
                                    android:layout_marginTop="12dp"
                                    android:scaleType="centerCrop"
                                    app:layout_constraintDimensionRatio="78:104"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintWidth_percent="0.208"
                                    app:shapeAppearanceOverlay="@style/roundStyle_r8"
                                    tools:src="@color/fill_color_1_dark" />

                                <TextView
                                    android:id="@+id/tvTitle"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="12dp"
                                    android:layout_marginEnd="15dp"
                                    android:ellipsize="end"
                                    android:lineSpacingExtra="@dimen/lineSpacingExtraShort"
                                    android:maxLines="2"
                                    android:text="@{layout.workInfo.workTitle}"
                                    android:textAppearance="@style/Text18"
                                    android:textColor="?attr/textColor1"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toEndOf="@+id/ivCover"
                                    app:layout_constraintTop_toTopOf="@+id/ivCover"
                                    tools:text="代码纪元：觉醒指令" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="@{`已创作 `+layout.workInfo.finishedEpisodeCnt+` 集 / 共`+layout.workInfo.totalEpisodeCnt+`集`}"
                                    android:textAppearance="@style/Text12"
                                    android:textColor="?attr/textColor3"
                                    app:layout_constraintEnd_toEndOf="@+id/tvTitle"
                                    app:layout_constraintStart_toStartOf="@+id/tvTitle"
                                    app:layout_constraintTop_toBottomOf="@+id/tvTitle"
                                    tools:text="已创作 N 集 / 共M集" />

                                <TextView
                                    android:id="@+id/tvSeriesIntro"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="24dp"
                                    android:text="作品简介"
                                    android:textAppearance="@style/Text14"
                                    android:textColor="?attr/textColor1"
                                    app:layout_constraintStart_toStartOf="@+id/ivCover"
                                    app:layout_constraintTop_toBottomOf="@+id/ivCover" />

                                <com.kgmedia.fastfilm.widget.expandtextview.ExpandableTextView
                                    android:id="@+id/tvSeriesIntroDesc"
                                    text="@{layout.workInfo.workDesc}"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="15dp"
                                    android:layout_marginTop="12dp"
                                    android:lineSpacingExtra="@dimen/lineSpacingExtraShort"
                                    android:textColor="?textColor4"
                                    android:textSize="12sp"
                                    app:collapseLines="3"
                                    app:collapseTipLabel="收起"
                                    app:expandTipLabel="展开"
                                    app:expandable="true"
                                    app:layout_constraintTop_toBottomOf="@+id/tvSeriesIntro"
                                    app:tipPosition="align_right"
                                    app:tipsColor="?attr/textColor1"
                                    app:tipsSize="12sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="24dp"
                                    android:text="剧集目录"
                                    android:textAppearance="@style/Text14"
                                    android:textColor="?attr/textColor1"
                                    app:layout_constraintStart_toStartOf="@+id/tvSeriesIntro"
                                    app:layout_constraintTop_toBottomOf="@+id/tvSeriesIntroDesc" />

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </com.google.android.material.appbar.CollapsingToolbarLayout>

                    </com.google.android.material.appbar.AppBarLayout>

                    <com.scwang.smart.refresh.layout.SmartRefreshLayout
                        android:id="@+id/swipeRefreshLayout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:overScrollMode="never"
                        app:layout_behavior="@string/appbar_scrolling_view_behavior"
                        app:layout_constraintDimensionRatio="375:324"
                        app:layout_constraintTop_toBottomOf="@+id/tvSubtitle"
                        app:srlAccentColor="@color/color_121212"
                        app:srlEnablePreviewInEditMode="true"
                        app:srlPrimaryColor="@color/transparent">

                        <com.kgmedia.fastfilm.widget.LoadStateViewHolder
                            android:id="@+id/loadStateViewHolder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:scrollable="true">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/recyclerView"
                                bottom="@{64f/375f}"
                                setPaddingByWidth="@{false}"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:clipToPadding="false"
                                android:overScrollMode="never"
                                android:paddingHorizontal="9dp"
                                android:paddingVertical="6dp"
                                android:scrollbars="none"
                                app:layoutManager="androidx.recyclerview.widget.StaggeredGridLayoutManager"
                                app:spanCount="3"
                                tools:listitem="@layout/item_my_episode_info" />

                        </com.kgmedia.fastfilm.widget.LoadStateViewHolder>

                    </com.scwang.smart.refresh.layout.SmartRefreshLayout>

                </androidx.coordinatorlayout.widget.CoordinatorLayout>

                <!--setVisible="@{layout.workInfo.isMine() &amp;&amp; layout.workInfo.workStatus == 60}"-->
                <TextView
                    android:id="@+id/btnContinue"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/selector_common_button"
                    android:gravity="center"
                    android:text="创建续集"
                    android:textAppearance="@style/Text16"
                    android:textColor="@color/fixed_white_1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="345:44" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.kgmedia.fastfilm.widget.LoadStateViewHolder>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.kgmedia.fastfilm.widget.StatusBarView
                android:id="@+id/statusBar1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/btnBack"
                singleClick="@{(v)->layout.back()}"
                android:layout_width="48dp"
                android:layout_height="@dimen/action_bar_size"
                android:paddingVertical="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_back_left"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/statusBar1" />
        </LinearLayout>
    </FrameLayout>
</layout>