<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.series.setprice.SetPriceViewModel" />

        <import type="android.view.View" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ffffff_tr24"
        android:clickable="true"
        android:focusable="true">

        <com.kgmedia.fastfilm.widget.LoadStateViewHolder
            displayChild="@{layout.loadState}"
            onRetry="@{layout::getPriceConfig}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.kgmedia.fastfilm.widget.roundedimageview.RoundedImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_set_price"
                    app:layout_constraintDimensionRatio="375:146"
                    app:layout_constraintTop_toTopOf="parent"
                    app:riv_corner_radius_top_left="24dp"
                    app:riv_corner_radius_top_right="24dp" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@{layout.release ? `上架作品，立即赚收益` : `设置价格`}"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="上架作品，立即赚收益" />

                <TextView
                    android:id="@+id/tvPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:text="每章价格"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="14dp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

                <TextView
                    android:id="@+id/tv_points_explanation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@{layout.config.priceTips}"
                    android:textColor="@color/color_50_000000"
                    android:textSize="10dp"
                    app:layout_constraintStart_toStartOf="@id/tvPrice"
                    app:layout_constraintTop_toBottomOf="@+id/tvPrice"
                    tools:text="收益的积分自动兑换为现金到账，兑换比例为：1元 = 10积分" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:adapter="@{layout.priceAdapter}"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="10dp"
                    android:scrollbars="none"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/tv_points_explanation"
                    app:spanCount="3"
                    tools:itemCount="6"
                    tools:listitem="@layout/item_set_price" />

                <LinearLayout
                    android:id="@+id/startEpisode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    app:layout_constraintTop_toBottomOf="@+id/rvPrice">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="从第几章开始收费"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="14dp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="@+id/tvPrice"
                        app:layout_constraintTop_toBottomOf="@+id/rvPrice" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="第"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="12dp" />

                    <EditText
                        android:id="@+id/etStartEpisode"
                        android:layout_width="60dp"
                        android:layout_height="32dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/bg_f6f7fb_r8"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="4"
                        android:text="@={layout.startEpisode}"
                        android:textColor="@color/color_50_121212"
                        android:textSize="10dp"
                        tools:text="4" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="章"
                        android:textColor="@color/textColorPrimary"
                        android:textSize="12dp" />
                </LinearLayout>

                <androidx.constraintlayout.widget.Group
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="@{layout.isVip()?View.GONE:View.VISIBLE}"
                    app:constraint_referenced_ids="ll_directly_listed,ll_activate_membership,ic_activate_membership_recommend"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/ll_directly_listed"
                    singleClick="@{() -> layout.confirm()}"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="42dp"
                    android:background="@drawable/selector_common_button"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toStartOf="@id/ll_activate_membership"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/startEpisode">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{layout.release?`直接上架`:`确认修改`}"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        tools:text="直接上架" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{layout.config.profitTips}"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        tools:text="可获得20%收益" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_activate_membership"
                    singleClick="@{() -> layout.startVip()}"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="9dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/gradient_left_ffab41_fffdb6_r50"
                    android:gravity="center"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ll_directly_listed"
                    app:layout_constraintTop_toTopOf="@+id/ll_directly_listed">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{layout.release?`开通会员上架`:`开通会员修改`}"
                        android:textColor="@color/color__7b2d00"
                        android:textSize="16sp"
                        tools:text="开通会员上架" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{layout.config.vipProfitTips}"
                        android:textColor="@color/color__7b2d00"
                        android:textSize="10sp"
                        tools:text="可获得100%收益" />
                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    loadUri="@{layout.config.recommendIconUrl}"
                    android:importantForAccessibility="no"
                    app:layout_constraintBottom_toTopOf="@id/ll_activate_membership"
                    app:layout_constraintEnd_toEndOf="@id/ll_activate_membership"
                    app:layout_constraintTop_toTopOf="@id/ll_activate_membership"
                    tools:src="@drawable/ic_activate_membership_recommend" />

                <TextView
                    android:id="@+id/btnConfirm"
                    singleClick="@{() -> layout.confirm()}"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="42dp"
                    android:background="@drawable/gradient_left_ffab41_fffdb6_r50"
                    android:gravity="center"
                    android:text="@{layout.release?`确认上架`:`确认修改`}"
                    android:textColor="@color/color__7b2d00"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:visibility="@{layout.isVip()?View.VISIBLE:View.GONE}"
                    app:layout_constraintDimensionRatio="317:48"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ll_activate_membership"
                    app:layout_constraintWidth_percent="0.8453"
                    tools:text="确认上架" />

                <TextView
                    android:id="@+id/tv_instructions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="当前为高级会员,分成比例100%"
                    android:textColor="@color/color_50_000000"
                    android:textSize="12sp"
                    android:visibility="@{layout.isVip()?View.VISIBLE:View.GONE}"
                    app:layout_constraintTop_toBottomOf="@id/btnConfirm"
                    tools:text="当前为高级会员,分成比例100%" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_instructions" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.kgmedia.fastfilm.widget.LoadStateViewHolder>

        <ImageView
            singleClick="@{() -> layout.dismiss()}"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="8dp"
            android:padding="16dp"
            android:src="@drawable/ic_light_dialog_close" />

    </FrameLayout>

</layout>