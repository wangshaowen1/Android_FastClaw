<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.information.viewModel.InformationViewModel" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ll"
                android:background="@drawable/bg_ffffff_leftbot_rightbot_r20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="10dp"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_f3f9ff_ffffff_r12"
                    android:paddingStart="6dp"
                    android:paddingTop="11dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="3dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_avatar"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_home_header_avatar"
                        app:shapeAppearanceOverlay="@style/roundStyle_circle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_profile_edit"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_online_resume_profile_edit"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@id/tv_name" />

                    <TextView
                        android:id="@+id/tv_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_marginEnd="@dimen/spacing_s"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/color_96_000000"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/iv_profile_edit"
                        app:layout_constraintStart_toEndOf="@id/iv_avatar"
                        app:layout_constraintTop_toTopOf="@id/iv_avatar"
                        tools:text="Name" />

                    <TextView
                        android:id="@+id/tv_tip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/color_75_3c3c43"
                        android:textSize="13sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/tv_name"
                        app:layout_constraintBottom_toBottomOf="@id/iv_avatar"
                        tools:text="Status" />

                    <LinearLayout
                        android:id="@+id/layout_profile_contacts"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14.5dp"
                        android:orientation="vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/iv_avatar">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/layout_profile_phone"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_online_resume_profile_phone" />

                                <TextView
                                    android:id="@+id/tv_profile_phone"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="2dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="@color/color_75_3c3c43"
                                    android:textSize="13sp"
                                    tools:text="17824839308" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layout_profile_email"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/spacing_xl"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_online_resume_profile_email" />

                                <TextView
                                    android:id="@+id/tv_profile_email"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="2dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textColor="@color/color_75_3c3c43"
                                    android:textSize="13sp"
                                    tools:text="example@qq.com" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layout_profile_wechat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_s"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_online_resume_profile_wechat" />

                            <TextView
                                android:id="@+id/tv_profile_wechat"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="2dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/color_75_3c3c43"
                                android:textSize="13sp"
                                tools:text="wechat" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <ImageView
                    android:id="@+id/iv_profile_decor"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginHorizontal="7dp"
                    android:layout_marginTop="@dimen/spacing_m"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/img_online_resume_profile_decor" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_resume_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="18dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_resume_info" />

            </LinearLayout>

            <include
                android:visibility="gone"
                android:id="@+id/view_understands"
                layout="@layout/view_understands1"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
