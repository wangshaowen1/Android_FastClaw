<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.clawagent.ClawAgentViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_f6f9ff"
        android:paddingBottom="52dp">

        <com.shiyuan.fastclaw.widget.super_button.SuperButton
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:sGradientStartColor="@color/color_e7eeff"
            app:sGradientEndColor="@color/color_00_f3f6fd"
            app:sGradientAngle="270"
            android:layout_width="match_parent"
            android:layout_height="153dp"
            />

        <com.shiyuan.fastclaw.widget.StatusBarView
            android:id="@+id/sbv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_agent_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_agent_claw_avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/sbv" />

        <TextView
            android:id="@+id/tv_agent_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/str_agent_name"
            android:textColor="@color/color_90_000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/tv_agent_desc"
            app:layout_constraintStart_toEndOf="@id/iv_agent_avatar"
            app:layout_constraintTop_toTopOf="@id/iv_agent_avatar" />

        <TextView
            singleClick="@{layout.clickHandler::onClick}"
            android:id="@+id/tv_agent_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="@string/str_agent_desc2"
            android:textColor="@color/color_C23C3C43"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@id/iv_agent_avatar"
            app:layout_constraintStart_toEndOf="@id/tv_agent_status"
            app:layout_constraintTop_toBottomOf="@id/tv_agent_name" />

        <com.shiyuan.fastclaw.widget.super_button.SuperButton
            android:layout_marginTop="1dp"
            android:id="@+id/tv_agent_status"
            android:layout_width="6dp"
            android:layout_height="6dp"
            app:layout_constraintBottom_toBottomOf="@id/tv_agent_desc"
            app:layout_constraintStart_toStartOf="@id/tv_agent_name"
            app:layout_constraintTop_toTopOf="@id/tv_agent_desc"
            app:sCornersRadius="45dp"
            app:sSolidColor="@color/color_ff8D28" />

        <ImageView
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_marginTop="1dp"
            android:id="@+id/tv_agent_index"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginStart="2dp"
            android:src="@drawable/ic_arrow_right_gray_12"
            app:layout_constraintBottom_toBottomOf="@id/tv_agent_desc"
            app:layout_constraintLeft_toRightOf="@id/tv_agent_desc"
            app:layout_constraintTop_toTopOf="@id/tv_agent_desc" />

        <ImageView
            android:id="@+id/iv_agent_memory"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="136dp"
            android:layout_height="34dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_agent_memory"
            app:layout_constraintBottom_toBottomOf="@id/iv_agent_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/iv_agent_avatar" />

        <com.scwang.smart.refresh.layout.SmartRefreshLayout
            android:id="@+id/srl_msg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="12dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@id/layout_bottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_agent_avatar"
            app:layout_constraintVertical_bias="0"
            app:srlEnableLoadMore="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_msg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingBottom="9dp" />

        </com.scwang.smart.refresh.layout.SmartRefreshLayout>

        <com.shiyuan.fastclaw.widget.super_button.SuperButton
            android:layout_width="match_parent"
            android:layout_height="30dp"
            app:layout_constraintBottom_toBottomOf="@id/srl_msg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:sGradientAngle="90"
            app:sGradientEndColor="#00F6F9FF"
            app:sGradientStartColor="#FFF6F9FF" />

        <ImageView
            android:id="@+id/iv_scroll_bottom"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginBottom="-8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_agent_scroll_bottom"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/srl_msg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_bottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_action"
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_marginBottom="12dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="16dp"
                android:paddingEnd="8dp"
                android:scrollbars="none"
                app:layout_constraintBottom_toTopOf="@id/layout_send"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:itemCount="5"
                tools:listitem="@layout/item_claw_agent_quick_action" />

            <com.shiyuan.fastclaw.widget.shape.SuperConstraintLayout
                android:id="@+id/layout_send"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                app:background_normalColor="@color/color_ffffff"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:super_corner="27dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:visibility="gone"
                    android:id="@+id/layout_reanswer"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:paddingHorizontal="14dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reanswer"
                        android:textColor="@color/color_55_3c3c43"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_reanswer_close"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="3dp"
                        singleClick="@{layout.clickHandler::onClick}"
                        android:src="@drawable/ic_agent_input_close"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/color_e9f0fe"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/layout_reanswer">

                    <EditText
                        android:id="@+id/et_send"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:background="@null"
                        android:hint="@string/str_agent_send_hint"
                        android:maxLines="4"
                        android:paddingStart="8dp"
                        android:paddingEnd="50dp"
                        android:textColor="@color/color_90_000000"
                        android:textColorHighlight="@color/color_20_0099FF"
                        android:textColorHint="@color/color_56_3c3c43"
                        android:textCursorDrawable="@drawable/cursor_genner_edit"
                        android:textSize="15sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="发消息或者按住说话..." />

                    <TextView
                        android:id="@+id/tv_voice_press"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="按住说话"
                        android:textColor="@color/color_90_000000"
                        android:textSize="15sp"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_send"
                        singleClick="@{layout.clickHandler::onClick}"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_agent_send"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@id/et_send"
                        app:layout_constraintEnd_toEndOf="@id/et_send"
                        app:layout_constraintTop_toTopOf="@id/et_send"
                        tools:visibility="visible" />

                    <ImageView
                        android:id="@+id/iv_input_mode"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_agent_voice_mode"
                        app:layout_constraintBottom_toBottomOf="@id/et_send"
                        app:layout_constraintEnd_toEndOf="@id/et_send"
                        app:layout_constraintTop_toTopOf="@id/et_send"
                        tools:visibility="gone" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.shiyuan.fastclaw.widget.shape.SuperConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
