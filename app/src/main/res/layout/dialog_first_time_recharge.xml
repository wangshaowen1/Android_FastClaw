<?xml version="1.0" encoding="utf-8"?><!--首次充值弹窗-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.payment.points.FirstTimeRechargeViewModel" />

        <import type="com.kuaige.payment.PaymentClient.PaymentMethod" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ffffff_tr24"
        android:clickable="true"
        android:focusable="true"
        android:paddingBottom="14dp">

        <com.kgmedia.fastfilm.widget.roundedimageview.RoundedImageView
            android:id="@+id/bg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_recharge_dialog"
            app:layout_constraintDimensionRatio="375:146"
            app:layout_constraintTop_toTopOf="parent"
            app:riv_corner_radius_top_left="24dp"
            app:riv_corner_radius_top_right="24dp" />

        <com.kgmedia.fastfilm.widget.HorizontalScrollRecyclerView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="12dp"
            android:adapter="@{layout.sampleAdapter}"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="@+id/bg"
            app:layout_constraintDimensionRatio="375:28"
            tools:listitem="@layout/item_first_time_recharge_sample" />

        <TextView
            android:id="@+id/tvRecharge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:text="充值积分"
            android:textColor="@color/textColorPrimary"
            android:textSize="14dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bg" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="@{layout.cost}"
            android:textColor="@color/color_ff4b00"
            android:textSize="10dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvRecharge"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvRecharge"
            tools:text="解锁后续图片还需560积分" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecharge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:adapter="@{layout.adapter}"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="11dp"
            android:scrollbars="none"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/tvRecharge"
            app:spanCount="3"
            tools:itemCount="3"
            tools:listitem="@layout/item_first_time_recharge" />

        <TextView
            android:id="@+id/tvPayment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="支付方式:"
            android:textColor="@color/color_50_121212"
            android:textSize="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rvRecharge" />

        <LinearLayout
            android:id="@+id/payment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="horizontal"
            app:layout_constraintDimensionRatio="375:42"
            app:layout_constraintTop_toBottomOf="@+id/tvPayment">

            <TextView
                android:id="@+id/btnWechat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_pm_wechat"
                android:drawableEnd="@{layout.payment == PaymentMethod.WxPay ? @drawable/ic_choose_checked : @drawable/ic_choose_normal_dark}"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:onClick="@{() -> layout.changePayment(PaymentMethod.WxPay)}"
                android:paddingHorizontal="16dp"
                android:text="微信支付"
                android:textColor="@color/textColorPrimary"
                android:textSize="14dp"
                tools:drawableEnd="@drawable/ic_choose_checked" />

            <TextView
                android:id="@+id/btnAlipay"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_pm_alipay"
                android:drawableEnd="@{layout.payment == PaymentMethod.Alipay ? @drawable/ic_choose_checked : @drawable/ic_choose_normal_dark}"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:onClick="@{() -> layout.changePayment(PaymentMethod.Alipay)}"
                android:paddingHorizontal="16dp"
                android:text="支付宝"
                android:textColor="@color/textColorPrimary"
                android:textSize="14dp"
                tools:drawableEnd="@drawable/ic_choose_normal_dark" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnRecharge"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/selector_common_button"
            android:gravity="center"
            android:onClick="@{() -> layout.recharge()}"
            android:text="充值并解锁完整作品"
            android:textColor="@color/white"
            android:textSize="16dp"
            app:layout_constraintDimensionRatio="317:48"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/payment"
            app:layout_constraintWidth_percent="0.8453" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnRecharge">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="充值即代表同意"
                android:textColor="@color/color_50_121212"
                android:textSize="12dp" />

            <TextView
                singleClick="@{(v)->layout.viewPolicy()}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="10dp"
                android:text="《充值协议》"
                android:textColor="@color/textColorPrimary"
                android:textSize="12dp" />

        </LinearLayout>

        <FrameLayout
            setVisible="@{layout.loading}"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="gone">

            <include
                layout="@layout/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

        </FrameLayout>

        <ImageView
            singleClick="@{() -> layout.dismiss()}"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="16dp"
            android:src="@drawable/ic_light_dialog_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>