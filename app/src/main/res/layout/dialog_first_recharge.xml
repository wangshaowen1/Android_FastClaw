<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.splash.newer.FirstRechargeViewModel" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/img_newcomer_gift_pack"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:src="@drawable/img_price"
            app:layout_constraintBottom_toTopOf="@id/btnPay"
            app:layout_constraintEnd_toEndOf="@id/bg"
            app:layout_constraintStart_toStartOf="@id/bg" />

        <TextView
            android:id="@+id/tvTitleLeft"
            android:layout_width="82dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="当前算力"
            android:textColor="#5C170B"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/ivPrice"
            app:layout_constraintEnd_toEndOf="@id/ivPrice"
            app:layout_constraintHorizontal_bias="0.0367"
            app:layout_constraintStart_toStartOf="@id/ivPrice"
            app:layout_constraintTop_toTopOf="@id/ivPrice"
            app:layout_constraintVertical_bias="0.3262" />

        <TextView
            android:id="@+id/tvOriginalPower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="#FA3A0A"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/tvTitleLeft"
            app:layout_constraintStart_toStartOf="@id/tvTitleLeft"
            app:layout_constraintTop_toBottomOf="@id/tvTitleLeft"
            tools:text="680" />

        <TextView
            android:id="@+id/tvOriginalPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#CC5c170b"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@id/tvTitleLeft"
            app:layout_constraintStart_toStartOf="@id/tvTitleLeft"
            app:layout_constraintTop_toBottomOf="@id/tvOriginalPower"
            tools:text="$68" />

        <TextView
            android:id="@+id/tvTitleRight"
            style="@style/Text16"
            android:layout_width="82dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="超值赠送"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="@id/ivPrice"
            app:layout_constraintEnd_toEndOf="@id/ivPrice"
            app:layout_constraintHorizontal_bias="0.80"
            app:layout_constraintStart_toStartOf="@id/ivPrice"
            app:layout_constraintTop_toTopOf="@id/ivPrice"
            app:layout_constraintVertical_bias="0.18" />

        <TextView
            android:id="@+id/tvPower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/tvTitleRight"
            app:layout_constraintStart_toStartOf="@id/tvTitleRight"
            app:layout_constraintTop_toBottomOf="@id/tvTitleRight"
            tools:text="880" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="@id/tvTitleRight"
            app:layout_constraintStart_toStartOf="@id/tvTitleRight"
            app:layout_constraintTop_toBottomOf="@id/tvPower">

            <TextView
                android:id="@+id/tvOriginalPowerRight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="680+" />

            <TextView
                android:id="@+id/tvRewards"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#FFD930"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="200" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="奖励"
                android:textColor="#FFD930"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="15dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/ivPrice"
            app:layout_constraintEnd_toEndOf="@id/bg"
            app:layout_constraintStart_toStartOf="@id/bg">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="限时优惠"
                android:textColor="#420A11"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_hour"
                style="@style/CountDownTextStyle"
                android:text="23" />

            <TextView
                style="@style/CountDownColonStyle"
                android:text=":" />

            <TextView
                android:id="@+id/tv_minute"
                style="@style/CountDownTextStyle"
                android:text="59" />

            <TextView
                style="@style/CountDownColonStyle"
                android:text=":" />

            <TextView
                android:id="@+id/tv_second"
                style="@style/CountDownTextStyle"
                android:text="00" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivDiscountBg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-19dp"
            android:layout_marginEnd="11dp"
            android:src="@drawable/img_newcomer_gift_lable"
            app:layout_constraintEnd_toEndOf="@id/bg"
            app:layout_constraintTop_toTopOf="@id/ivPrice" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:paddingStart="7dp"
            android:rotation="10"
            android:text="+赠\n30%"
            android:textColor="#25210F"
            android:textSize="11dp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/ivDiscountBg"
            app:layout_constraintEnd_toEndOf="@id/ivDiscountBg"
            app:layout_constraintStart_toStartOf="@id/ivDiscountBg"
            app:layout_constraintTop_toTopOf="@id/ivDiscountBg" />

        <ImageView
            android:id="@+id/btnPay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="19dp"
            android:src="@drawable/img_newcomer_gift_btn"
            app:layout_constraintBottom_toBottomOf="@id/bg"
            app:layout_constraintEnd_toEndOf="@id/bg"
            app:layout_constraintStart_toStartOf="@id/bg" />

        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:src="@drawable/icon_dialog_bottom_close"
            app:layout_constraintEnd_toEndOf="@id/bg"
            app:layout_constraintStart_toStartOf="@id/bg"
            app:layout_constraintTop_toBottomOf="@id/bg" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
