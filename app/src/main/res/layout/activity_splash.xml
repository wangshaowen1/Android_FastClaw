<?xml version="1.0" encoding="utf-8"?><!--欢迎页-->
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.splash.SplashViewModel" />

    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.kgmedia.fastfilm.widget.AutoResizeImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/img_splash" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="72dp"
            android:src="@drawable/img_splash_top" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center"
            android:layout_marginBottom="40dp"
            android:src="@drawable/img_splash_logo" />
    </FrameLayout>
</layout>