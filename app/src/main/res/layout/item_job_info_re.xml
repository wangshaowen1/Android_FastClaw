<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/ll"
        android:paddingVertical="12dp"
        android:paddingHorizontal="9dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_f9f9f9_r14"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/color_85_3c3c43"
                android:textSize="14sp"
                tools:text="深圳市乘海科技有限公司" />

            <com.shiyuan.fastclaw.widget.shape.SuperLinearLayout
                android:id="@+id/layout_missing"
                android:layout_marginRight="4dp"
                android:paddingVertical="6dp"
                app:super_corner="8dp"
                android:paddingHorizontal="10dp"
                app:background_normalColor="@color/color_1AF74C30"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@id/iv_arrow"
                android:orientation="horizontal">

                <ImageView
                    android:layout_gravity="center_vertical"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_warning"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:layout_marginLeft="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="待补充"
                    android:textColor="@color/color_F74C30"
                    android:textSize="12sp" />

            </com.shiyuan.fastclaw.widget.shape.SuperLinearLayout>

            <ImageView
                android:layout_marginLeft="4dp"
                android:id="@+id/iv_arrow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_arrow_right"
                tools:ignore="ContentDescription" />


        </RelativeLayout>

        <TextView
            android:id="@+id/tv_vale"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginTop="6dp"
            android:textColor="@color/color_90_000000"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="深圳市乘海科技有限公司" />
    </LinearLayout>
</layout>
