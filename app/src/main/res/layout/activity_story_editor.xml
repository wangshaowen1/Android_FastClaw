<?xml version="1.0" encoding="utf-8"?><!--选择话题-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.creator.generate.StoryEditorViewModel" />

        <import type="android.view.View" />

        <import type="com.kgmedia.fastfilm.common.utils.Utils" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.kgmedia.fastfilm.widget.StatusBarView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnClose"
                singleClick="@{(v)->layout.back()}"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="@dimen/spacing_s"
                android:importantForAccessibility="no"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_close"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/statusBar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="160dp"
                android:textColor="?attr/textColor3"
                android:textSize="16sp"
                tools:text="代码纪元：觉醒指令..." />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_s"
                android:src="@drawable/icon_edit_full_gray" />
        </LinearLayout>

        <include
            layout="@layout/layout_story_board_header"
            app:step="@{1}" />

        <FrameLayout
            android:id="@+id/container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>
</layout>
