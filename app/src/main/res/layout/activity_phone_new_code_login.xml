<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.login.phone.PhoneNewLoginViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/login_bg">

        <ImageView
            android:id="@+id/ivLoginBg"
            android:layout_width="320dp"
            android:layout_height="488dp"
            android:layout_marginStart="-3dp"
            android:layout_marginTop="26dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_phone_new_login_top"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.shiyuan.fastclaw.widget.StatusBarView
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="44dp"
            android:importantForAccessibility="no"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:src="@drawable/ic_phone_new_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvCodeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="35dp"
            android:layout_marginTop="164dp"
            android:text="@string/login_new_code_title"
            android:textColor="@color/color_90_000000"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/statusBar" />

        <TextView
            android:id="@+id/tvCodeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="35dp"
            android:layout_marginTop="5dp"
            android:textColor="@color/color_90_000000"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCodeTitle"
            tools:text="验证码已发送至1029309900" />

        <LinearLayout
            android:id="@+id/llCodeBoxes"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="42dp"
            android:layout_marginEnd="35dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCodeSubtitle">

                <TextView
                    android:id="@+id/tvCode1"
                    style="@style/Text20"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_ffffff_r12"
                    android:gravity="center"
                    android:textColor="@color/color_90_000000"
                    android:textSize="24sp"
                    tools:text="6" />

            <TextView
                android:id="@+id/tvCode2"
                style="@style/Text20"
                android:layout_width="60dp"
                android:layout_height="60dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_ffffff_r12"
                    android:gravity="center"
                    android:textColor="@color/color_90_000000"
                    android:textSize="24sp"
                    tools:text="6" />

            <TextView
                android:id="@+id/tvCode3"
                style="@style/Text20"
                android:layout_width="60dp"
                android:layout_height="60dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_ffffff_r12"
                    android:gravity="center"
                    android:textColor="@color/color_90_000000"
                    android:textSize="24sp"
                    tools:text="6" />

            <TextView
                android:id="@+id/tvCode4"
                style="@style/Text20"
                android:layout_width="60dp"
                android:layout_height="60dp"
                    android:layout_marginStart="24dp"
                    android:background="@drawable/bg_ffffff_r12"
                    android:gravity="center"
                    android:textColor="@color/color_90_000000"
                    android:textSize="24sp"
                    tools:text="1" />
        </LinearLayout>

        <EditText
            android:id="@+id/etCode"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="35dp"
            android:alpha="0"
            android:background="@android:color/transparent"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/llCodeBoxes" />

        <TextView
            android:id="@+id/tvCodeError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="8dp"
            android:text="@string/login_new_code_error"
            android:textColor="@color/color_ff4332"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llCodeBoxes"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvResend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="34dp"
            android:text="@string/resend_sms_code"
            android:textColor="@color/color_90_000000"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llCodeBoxes" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
