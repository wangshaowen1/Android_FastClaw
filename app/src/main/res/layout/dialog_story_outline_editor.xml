<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.creator.generate.edit.StoryOutlineEditorViewModel" />

        <import type="android.view.View" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ffffff_tr24"
        android:orientation="vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="编辑故事章节"
            android:textColor="@color/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.kgmedia.fastfilm.widget.CounterInputLayout
            android:id="@+id/inputer"
            android:layout_width="match_parent"
            android:layout_height="327dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_f5f5f5_r12"
            app:inputCounterGravity="right"
            app:inputCounterTextColor="@color/color_50_121212"
            app:inputCounterTextSize="10sp"
            app:inputCounterVisible="true"
            app:inputHint="请输入故事内容..."
            app:inputHorizontalPadding="12dp"
            app:inputTextSize="15sp"
            app:inputBottomMargin="26dp"
            app:inputVerticalPadding="12dp"
            app:maxLength="@{layout.maxInputLength}" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="26dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:alpha="0.76"
                android:text="确认更新后会重新生成分镜"
                android:textColor="@color/color_ff4b00"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCancel"
                style="@style/Button.Menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_b9b9b9_r10"
                android:paddingStart="26dp"
                android:paddingEnd="26dp"
                android:text="取消" />

            <Button
                android:id="@+id/btnConfirm"
                style="@style/Button.Menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/gradient_left_ffa029_right_ff4b00_r10"
                android:text="确认更新" />
        </LinearLayout>
    </LinearLayout>
</layout>