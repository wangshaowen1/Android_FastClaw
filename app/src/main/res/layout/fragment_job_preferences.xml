<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.information.viewModel.InformationViewModel" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <FrameLayout
            android:background="@drawable/bg_ffffff_leftbot_rightbot_r20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingTop="@dimen/spacing_m"
            android:paddingBottom="@dimen/spacing_xl">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_job_preferences"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <include
                android:id="@+id/view_understands"
                layout="@layout/view_understands1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </FrameLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
