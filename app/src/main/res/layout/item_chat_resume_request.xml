<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/color_75_3c3c43"
            android:textSize="10sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="17:24"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@null"
            android:src="@drawable/icon_default_avatar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTime"
            app:layout_goneMarginTop="0dp" />

        <com.shiyuan.fastclaw.widget.shape.SuperConstraintLayout
            android:id="@+id/layoutCard"
            android:layout_width="255dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            app:background_normalColor="@color/color_ffffff"
            app:border_color="#D9E6FF"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/ivAvatar"
            app:layout_constraintTop_toTopOf="@id/ivAvatar"
            app:layout_goneMarginTop="0dp"
            app:super_corner="20dp"
            app:view_border_width="1dp">

            <com.shiyuan.fastclaw.widget.super_button.SuperButton
                android:layout_width="match_parent"
                android:layout_height="61dp"
                app:sCornersTopLeftRadius="6dp"
                app:sCornersTopRightRadius="20dp"
                app:sGradientAngle="270"
                app:sGradientEndColor="#00000000"
                app:sGradientStartColor="#1F336FFF" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/ivFile"
                    android:layout_width="25dp"
                    android:layout_height="29dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chat_resume_file"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvTitle"
                    app:layout_constraintBottom_toBottomOf="@id/tvTitle"
                    />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:includeFontPadding="false"
                    android:textColor="@color/color_000000"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/ivFile"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="我想要您一份附件简历，您是否同意？" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="18dp"
                android:gravity="end"
                android:includeFontPadding="false"
                android:textColor="@color/color_2f6bff"
                android:textSize="14sp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutContent"
                tools:text="已发送"
                tools:visibility="gone" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutActions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="18dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutContent">

                <TextView
                    android:id="@+id/tvReject"
                    android:layout_width="0dp"
                    android:layout_height="33dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_f2f3f7_r100"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/message_chat_resume_reject"
                    android:textColor="@color/color_000000"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toStartOf="@id/tvAccept"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvAccept"
                    android:layout_width="0dp"
                    android:layout_height="33dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_2f6bff_r100"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/message_chat_resume_accept"
                    android:textColor="@color/color_ffffff"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/tvReject"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.shiyuan.fastclaw.widget.shape.SuperConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
