<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kgmedia.fastfilm.feature.editor.dubbing.ItemDubbingTimbreVM" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <com.kgmedia.fastfilm.widget.roundedimageview.RoundedImageView
            android:id="@+id/ivAvatar"
            loadThumbnailUri="@{item.data.timbreCoverUrl}"
            placeHolder="@{@drawable/ic_default_avatar_big}"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:onClick="@{(v) -> item.click()}"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.65"
            app:riv_oval="true"
            tools:src="@drawable/ic_default_avatar_big" />

        <FrameLayout
            setVisible="@{item.playing}"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_50_000000_r50"
            app:layout_constraintBottom_toBottomOf="@+id/ivAvatar"
            app:layout_constraintEnd_toEndOf="@+id/ivAvatar"
            app:layout_constraintStart_toStartOf="@+id/ivAvatar"
            app:layout_constraintTop_toTopOf="@+id/ivAvatar">

            <com.airbnb.lottie.LottieAnimationView
                setLottieAnimationViewAnimations="@{item.playing}"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                app:lottie_loop="true"
                app:lottie_rawRes="@raw/lottie_middle_play_ump"
                app:lottie_repeatMode="restart" />

        </FrameLayout>

        <com.kgmedia.fastfilm.widget.GradientBorderView
            setVisible="@{item.selected}"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:borderEndColor="@color/color_ffa029"
            app:borderStartColor="@color/color_ff4332"
            app:borderWidth="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/ivAvatar"
            app:layout_constraintEnd_toEndOf="@+id/ivAvatar"
            app:layout_constraintStart_toStartOf="@+id/ivAvatar"
            app:layout_constraintTop_toTopOf="@+id/ivAvatar"
            app:roundCornerRadius="100dp" />

        <ImageView
            setVisible="@{item.data.vipStatus == 1}"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/ic_vip54"
            app:layout_constraintBottom_toBottomOf="@+id/ivAvatar"
            app:layout_constraintDimensionRatio="1"
            app:layout_constraintEnd_toEndOf="@+id/ivAvatar"
            app:layout_constraintWidth_percent="0.26" />

        <TextView
            android:layout_width="60dp"
            android:layout_height="17dp"
            android:layout_marginTop="6dp"
            android:text="@{item.data.timbreName}"
            android:textColor="@color/color_121212"
            android:textSize="12dp"
            app:layout_constraintEnd_toEndOf="@+id/ivAvatar"
            app:layout_constraintStart_toStartOf="@+id/ivAvatar"
            app:layout_constraintTop_toBottomOf="@+id/ivAvatar"
            tools:text="默认音色" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>