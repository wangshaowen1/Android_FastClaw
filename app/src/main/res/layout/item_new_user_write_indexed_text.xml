<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="num"
            type="String" />

        <variable
            name="text"
            type="CharSequence" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_faf5f5_r6"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">


        <TextView
            android:id="@+id/tvBaseline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:lines="1"
            android:text="@{text}"
            android:textColor="@color/color_121212"
            android:textSize="14dp"
            android:visibility="invisible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="@dimen/lineSpacingExtra"
            android:text="@{text}"
            android:textColor="@color/color_121212"
            android:textSize="14dp"
            app:layout_constraintBaseline_toBaselineOf="@+id/tvBaseline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="如果我能看得见，就能分清黑夜与白天。——李大大《如果能看得见》" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>