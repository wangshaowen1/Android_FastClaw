<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.home.HomeViewModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.shiyuan.fastclaw.widget.StatusBarView
            android:id="@+id/sbv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/siv_avatar"
                    placeHolder="@{@drawable/ic_default_avatar}"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_default_avatar"
                    app:shapeAppearanceOverlay="@style/roundStyle_circle" />


                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@id/siv_avatar"
                    android:fontFamily="@font/alimama_shu_hei_ti_bold"
                    android:text="@string/home_name"
                    android:textColor="@color/color_1a1a1a"
                    android:textSize="20sp"></TextView>


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@id/siv_avatar"
                    android:layout_marginStart="12dp"
                    android:layout_toEndOf="@id/siv_avatar"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_gravity="center_vertical"
                        android:src="@drawable/ic_home_state"></ImageView>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/home_state"
                        android:textColor="@color/color_666666"
                        android:textSize="10sp"></TextView>
                </LinearLayout>


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_toEndOf="@id/tv_name"
                    android:background="@drawable/bg_e2edfc_r4"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:text="@string/home_agent_tag"
                    android:textColor="@color/color_0066CC"
                    android:textSize="10sp" />


            </RelativeLayout>

            <TextView
                android:id="@+id/tvGreeting1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp20"
                android:background="@drawable/bg_ffffff_r12"
                android:padding="12dp"
                android:text="@string/home_greeting_1"
                android:textColor="@color/color_1a1a1a"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/home_greeting_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ffffff_r12"
                android:padding="12dp"
                android:text="@string/home_greeting_2"
                android:textColor="@color/color_1a1a1a"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_report_card"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="24dp"
                android:paddingBottom="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/alimama_shu_hei_ti_bold"
                            android:text="@string/home_interview_report_title"
                            android:textColor="@color/color_1a1a1a"
                            android:textSize="18sp"></TextView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp20"
                            android:text="@string/home_report_option_company"
                            android:textColor="@color/color_666666"
                            android:textSize="13sp"></TextView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/home_report_option_analysis"
                            android:textColor="@color/color_666666"
                            android:textSize="13sp"></TextView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/home_report_option_interview"
                            android:textColor="@color/color_666666"
                            android:textSize="13sp"></TextView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/home_report_option_salary"
                            android:textColor="@color/color_666666"
                            android:textSize="13sp"></TextView>


                    </LinearLayout>


                    <View
                        android:layout_width="@dimen/dp_0"
                        android:layout_height="match_parent"
                        android:layout_weight="1"></View>

                    <ImageView
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_gravity="center_vertical"
                        android:importantForAccessibility="no"
                        android:src="@mipmap/ima_home_report"></ImageView>

                </LinearLayout>


                <TextView
                    android:id="@+id/btnUploadResume"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="23dp"
                    android:background="@drawable/bg_upload_btn"
                    android:gravity="center"
                    android:text="@string/home_upload_resume"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


    </LinearLayout>


</layout>
