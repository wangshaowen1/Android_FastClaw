<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.opportunity.vm.OpportunityViewModel" />
    </data>

    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/srl"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/spacing_l"
        app:srlEnableLoadMore="false">

        <com.shiyuan.fastclaw.widget.LoadStateViewHolder
            android:layout_marginTop="@dimen/spacing_m"
            android:id="@+id/lsv_processed_opportunity"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:noData="@string/no_data2"
            app:noDataTextColor="@color/color_85_3c3c43"
            app:noDataTextSize="14sp"
            app:noDataTextBold="false"
            app:noDataSrc="@drawable/ic_empty">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_processed_opportunity"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingHorizontal="15dp"
                android:paddingBottom="@dimen/spacing_l"
                tools:itemCount="10"
                tools:listitem="@layout/item_processed_opportunity" />
        </com.shiyuan.fastclaw.widget.LoadStateViewHolder>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
</layout>
