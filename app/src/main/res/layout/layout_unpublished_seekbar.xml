<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/progressBg"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/bg_10_ffffff_r6"
        app:layout_constraintBottom_toBottomOf="@+id/thumb"
        app:layout_constraintTop_toTopOf="@+id/thumb" />

    <View
        android:id="@+id/progressBar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.66"
        android:background="@drawable/bg_ffffff_r4"
        app:layout_constraintBottom_toBottomOf="@+id/progressBg"
        app:layout_constraintEnd_toStartOf="@+id/progress"
        app:layout_constraintStart_toStartOf="@+id/progressBg"
        app:layout_constraintTop_toTopOf="@+id/progressBg" />

    <View
        android:id="@+id/progress"
        android:layout_width="1px"
        android:layout_height="1px"
        app:layout_constraintBottom_toBottomOf="@+id/progressBg"
        app:layout_constraintEnd_toEndOf="@+id/progressBg"
        app:layout_constraintStart_toStartOf="@+id/progressBg" />

    <ImageView
        android:id="@+id/thumb"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="17dp"
        android:src="@drawable/oval_ffffff"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/progress"
        app:layout_constraintStart_toStartOf="@+id/progress" />

    <TextView
        android:id="@+id/tvProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="13dp"
        android:textColor="@color/color_50_ffffff"
        android:textSize="10dp"
        app:layout_constraintBottom_toTopOf="@+id/progressBg"
        app:layout_constraintStart_toStartOf="@+id/progressBg"
        tools:text="0:00" />

</androidx.constraintlayout.widget.ConstraintLayout>