<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="385dp"
        android:background="@drawable/bg_claw_agent_insufficient_sheet"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/tv_heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="40dp"
                android:layout_marginTop="46dp"
                android:gravity="center_vertical"
                android:text="@string/str_agent_insufficient_shrimp_heading"
                android:textColor="@color/color_000000"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_marginTop="4dp"
                app:layout_constraintEnd_toEndOf="@id/tv_heading"
                app:layout_constraintStart_toStartOf="@id/tv_heading"
                app:layout_constraintTop_toBottomOf="@id/tv_heading"
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="19dp"
                android:background="@drawable/bg_40_ffffff_r8"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/color_000000"
                android:textSize="12sp" />


            <ImageView
                android:layout_marginTop="10dp"
                android:id="@+id/iv_close"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/str_agent_insufficient_shrimp_close"
                android:src="@drawable/ic_claw_agent_insufficient_close"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:layout_marginTop="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_title"
                android:id="@+id/iv_invite_card"
                android:layout_width="287dp"
                android:layout_height="156dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/img_claw_agent_insufficient_invite_card" />

            <TextView
                android:layout_marginTop="50dp"
                android:id="@+id/tv_invite_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/color_000000"
                android:textSize="14sp"
                app:layout_constraintTop_toTopOf="@id/iv_invite_card"
                app:layout_constraintStart_toStartOf="@id/iv_invite_card"
                app:layout_constraintEnd_toEndOf="@id/iv_invite_card"
                app:setHtmlText="@{@string/str_agent_insufficient_shrimp_invite}" />

            <TextView
                android:layout_marginTop="-7dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_invite_card"
                android:id="@+id/tv_recharge"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="23dp"
                android:layout_marginEnd="5dp"
                android:background="@drawable/bg_ecf3ff_r50"
                android:gravity="center"
                android:text="@string/str_agent_insufficient_shrimp_recharge"
                android:textColor="@color/color_2f6bff"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/cn_invite" />

            <TextView
                android:id="@+id/cn_invite"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="23dp"
                android:background="@drawable/gradient_top_2f6bff_bottom_8b7bff_r50"
                android:gravity="center"
                android:text="@string/invite_friends_title"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tv_recharge"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tv_recharge"
                app:layout_constraintTop_toTopOf="@id/tv_recharge" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

</layout>
