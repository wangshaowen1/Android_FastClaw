<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_f5f6fa_tr20"
        android:paddingTop="@dimen/spacing_s"
        android:paddingBottom="@dimen/spacing_l">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="@dimen/spacing_s"
            android:textColor="@color/color_90_000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/iv_close"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="@string/str_agent_insufficient_shrimp_close"
            android:src="@drawable/ic_claw_agent_popup_close"
            app:layout_constraintBottom_toBottomOf="@id/tv_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_title" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_marginStart="20dp"
            android:layout_marginTop="@dimen/spacing_l"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_2f6bff_r100"
            android:id="@+id/cn_invite"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            android:layout_width="0dp"
            android:layout_height="52dp">

            <TextView
                app:layout_constraintVertical_chainStyle="packed"
                app:layout_constraintVertical_bias="0.5"
                android:id="@+id/tv"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintBottom_toTopOf="@id/ll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/str_agent_insufficient"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ll"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv"
                app:layout_constraintStart_toStartOf="@id/tv"
                app:layout_constraintEnd_toEndOf="@id/tv"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:text="@string/shrimp_invite"
                    android:textSize="12sp"
                    android:textColor="@color/color_70_ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="100"
                    android:textSize="12sp"
                    android:textColor="#ffb300"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="@string/home_treasury_shrimp_chip"
                    android:textSize="12sp"
                    android:textColor="@color/color_70_ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>



        <TextView
            android:id="@+id/tv_recharge"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_e8f1ff_stroke_2f6bff_r100"
            android:gravity="center"
            android:text="@string/str_agent_insufficient_shrimp_recharge"
            android:textColor="@color/color_2f6bff"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cn_invite" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
