<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_f5f6fa_tr20"
        android:paddingTop="@dimen/spacing_s"
        android:paddingBottom="@dimen/spacing_l">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="@dimen/spacing_s"
            android:textColor="@color/color_90_000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/iv_close"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="14dp"
            android:contentDescription="@string/str_agent_insufficient_shrimp_close"
            android:src="@drawable/ic_claw_agent_popup_close"
            app:layout_constraintBottom_toBottomOf="@id/tv_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_title" />

        <TextView
            android:id="@+id/tv_invite"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="@dimen/spacing_l"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_2f6bff_r100"
            android:gravity="center"
            android:text="@string/str_agent_insufficient_shrimp_invite"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_title" />

        <TextView
            android:id="@+id/tv_recharge"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_e8f1ff_stroke_2f6bff_r100"
            android:gravity="center"
            android:text="@string/str_agent_insufficient_shrimp_recharge"
            android:textColor="@color/color_2f6bff"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_invite" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
