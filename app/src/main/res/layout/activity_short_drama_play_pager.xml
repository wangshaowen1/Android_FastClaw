<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.play.ShortDramaPlayPagerViewModel" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_121212">

        <include
            android:id="@+id/overlay"
            layout="@layout/layout_export_video_overlay" />

        <com.kgmedia.fastfilm.widget.LoadStateViewHolder
            android:id="@+id/loadingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical" />

        </com.kgmedia.fastfilm.widget.LoadStateViewHolder>
        <View
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/gradient_top_000000_bottom_00_000000"
            app:layout_constraintDimensionRatio="375:100"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>

        <com.kgmedia.fastfilm.widget.StatusBarView
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/btnBack"
            singleClick="@{(v)->layout.back()}"
            android:layout_width="44dp"
            android:layout_height="@dimen/action_bar_size"
            android:paddingStart="16dp"
            android:paddingEnd="4dp"
            android:src="@drawable/ic_nav_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/statusBar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="@{layout.workNoTitle}"
            app:layout_constraintBottom_toBottomOf="@+id/btnBack"
            app:layout_constraintStart_toEndOf="@+id/btnBack"
            app:layout_constraintTop_toTopOf="@+id/btnBack"
            tools:text="第1章" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>