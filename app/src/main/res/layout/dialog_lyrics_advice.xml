<?xml version="1.0" encoding="utf-8"?><!--歌词建议-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.base.viewmodel.EmptyViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_ffffff_tr16">

        <TextView
            android:id="@+id/tvTitle"
            setTextBold="@{true}"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="歌词建议"
            android:textColor="@color/color_121212"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            singleClick="@{(v)->layout.dismiss()}"
            android:layout_width="68dp"
            android:layout_height="62dp"
            android:paddingVertical="21dp"
            android:src="@drawable/ic_login_dialog_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="@dimen/lineSpacingExtra"
                    android:text="1、输入原创的歌名、歌词，再选定音乐风格和参考音乐，即可为你生成专属原创歌曲。"
                    android:textColor="@color/color_80_121212"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:lineSpacingExtra="@dimen/lineSpacingExtra"
                    android:text="2、如果想有更好的谱写效果，建议你对每句歌词换行处理，在歌词前加上段落标记[主歌]、[副歌]、[桥段]等；"
                    android:textColor="@color/color_80_121212"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:lineSpacingExtra="@dimen/lineSpacingExtra"
                    android:text="主歌：用于叙述故事和表达情感；\n副歌：用于强化主题和情感，旋律激昂、歌词要求简单易记；\n桥段：用于连接主歌和副歌，过渡作用，旋律独特、歌词抽象，为歌曲增添变化和层次感。（在写歌过程中，桥段不是必须写的哦~）"
                    android:textColor="@color/color_80_121212"
                    android:textStyle="bold"
                    android:textSize="13sp" />

                <TextView
                    setTextBold="@{true}"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="示例："
                    android:textColor="@color/color_121212"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_f7f7f7_r16"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        setTextBold="@{true}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="[主歌]"
                        android:textColor="#ffff5454"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lineSpacingExtra"
                        android:lineSpacingExtra="@dimen/lineSpacingExtra"
                        android:text="想念如果会有声音\n不愿那是悲伤的哭泣\n事到如今 终于让自己属于 我自己\n只剩眼泪 还骗不过自己"
                        android:textColor="@color/color_121212"
                        android:textSize="14sp" />

                    <TextView
                        setTextBold="@{true}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="[副歌]"
                        android:textColor="#ffff5454"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/lineSpacingExtra"
                        android:lineSpacingExtra="@dimen/lineSpacingExtra"
                        android:text="突然好想你 你会在哪里\n过得快乐或委屈\n突然好想你 突然锋利的回忆\n突然模糊的眼睛"
                        android:textColor="@color/color_121212"
                        android:textSize="14sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="26dp"
                    android:lineSpacingExtra="@dimen/lineSpacingExtra"
                    android:text="3、如果有想写的歌，但一时想不出歌词，可以在歌词区域，输入10个或以上字，点击【优化歌词】，AI帮你写词。"
                    android:textColor="@color/color_80_121212"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
