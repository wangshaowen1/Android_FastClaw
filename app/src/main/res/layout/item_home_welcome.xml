<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        android:orientation="vertical">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/black">

            <LinearLayout
                android:id="@+id/ll_top"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignBottom="@id/ll_shrimp"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_home_welcome_bubble"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="24dp">

                <TextView
                    android:id="@+id/tv_shrimp_tip1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/alimama_shu_hei_ti_bold"
                    android:text="@string/home_welcome_greeting"
                    android:textColor="@color/color_90_000000"
                    android:textSize="20sp"
                    tools:text="你好，我是小虾" />

                <TextView
                    android:id="@+id/tv_shrimp_tip2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/home_welcome_intro"
                    android:textColor="@color/color_76_3c3c43"
                    android:textSize="13sp"
                    app:layout_constraintLeft_toLeftOf="@id/tv_shrimp_tip1"
                    app:layout_constraintTop_toBottomOf="@id/tv_shrimp_tip1"
                    tools:text="你的职业经纪人，我能帮你：" />

            </LinearLayout>

            <ImageView
                android:id="@+id/iv_shrimp"
                android:layout_width="152dp"
                android:layout_height="152dp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/img_home_shrimp" />

            <LinearLayout
                android:id="@+id/ll_shrimp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/iv_shrimp"
                android:layout_marginTop="-36dp"
                android:background="@drawable/bg_home_welcome_glass"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="20dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ffffff_r100"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:gravity="center_vertical"
                        android:src="@drawable/ic_service_find_job" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="center_vertical"
                        android:text="@string/home_service_find_job_title"
                        android:textColor="@color/color_90_000000"
                        android:textSize="14sp"
                        android:textStyle="bold" />


                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:text="@string/home_service_find_job_desc"
                        android:textColor="@color/color_56_3c3c43"
                        android:textSize="12sp" />


                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_ffffff_r100"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:gravity="center_vertical"
                        android:src="@drawable/ic_service_interview" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:gravity="center_vertical"
                        android:text="@string/home_service_interview_title"
                        android:textColor="@color/color_90_000000"
                        android:textSize="14sp"
                        android:textStyle="bold" />


                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:text="@string/home_service_interview_desc"
                        android:textColor="@color/color_56_3c3c43"
                        android:textSize="12sp" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_ffffff_r100"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:gravity="center_vertical"
                        android:src="@drawable/ic_service_resume" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:gravity="center_vertical"
                        android:text="@string/home_service_resume_title"
                        android:textColor="@color/color_90_000000"
                        android:textSize="14sp"
                        android:textStyle="bold" />


                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:text="@string/home_service_resume_desc"
                        android:textColor="@color/color_56_3c3c43"
                        android:textSize="12sp" />


                </LinearLayout>


            </LinearLayout>

        </RelativeLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_home_welcome_bubble"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="20dp">

            <!-- 文字区域 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_upload_resume_title"
                    android:textColor="@color/color_90_000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/home_upload_resume_subtitle"
                    android:textColor="@color/color_76_3c3c43"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- 上传按钮 -->
            <LinearLayout
                android:id="@+id/btn_upload_resume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_upload_resume_btn"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="13dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/home_upload_resume_btn"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/home_upload_resume_btn"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


    </LinearLayout>


</layout>
