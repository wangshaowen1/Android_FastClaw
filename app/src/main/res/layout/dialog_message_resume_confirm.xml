<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_f5f6fa_tr20"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:text="@string/message_chat_resume_confirm_title"
        android:textColor="@color/color_90_000000"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivClose"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_close"
        app:layout_constraintBottom_toBottomOf="@id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvTitle" />

    <com.shiyuan.fastclaw.widget.shape.SuperConstraintLayout
        android:id="@+id/layoutFile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="27dp"
        android:padding="14dp"
        app:background_normalColor="@color/color_ffffff"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:super_corner="12dp">

        <ImageView
            android:id="@+id/ivFile"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_resume"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="middle"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/color_90_000000"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@id/tvUploadTime"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivFile"
            app:layout_constraintTop_toTopOf="@id/ivFile"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="张三的简历.pdf" />

        <TextView
            android:id="@+id/tvUploadTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:textColor="@color/color_55_3c3c43"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/ivFile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivFile"
            app:layout_constraintTop_toBottomOf="@id/tvFileName"
            tools:text="上传于2026.06.01" />

    </com.shiyuan.fastclaw.widget.shape.SuperConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutFile">

        <com.shiyuan.fastclaw.widget.super_button.SuperButton
            android:id="@+id/tvCancel"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/cancel"
            android:textColor="@color/color_90_000000"
            android:textSize="15sp"
            app:layout_constraintEnd_toStartOf="@id/tvSend"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:sCornersRadius="100dp"
            app:sSizeHeight="44dp"
            app:sSolidColor="@color/color_05_000000" />

        <com.shiyuan.fastclaw.widget.super_button.SuperButton
            android:id="@+id/tvSend"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/message_chat_send"
            android:textColor="@color/color_ffffff"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvCancel"
            app:layout_constraintTop_toTopOf="@id/tvCancel"
            app:sCornersRadius="100dp"
            app:sSizeHeight="44dp"
            app:sSolidColor="@color/color_2f6bff" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
