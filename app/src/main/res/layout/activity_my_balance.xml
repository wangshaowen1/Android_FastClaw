<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.recharge.MyBalanceViewModel" />

        <import type="android.view.View" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_model_toolbar"
            toolbar="@{layout.toolbar}" />

        <com.kgmedia.fastfilm.widget.LoadStateViewHolder
            displayChild="@{layout.loadState}"
            onRetry="@{layout::loadConfig}"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/tvBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="我的余额"
                    android:textAppearance="@style/Text12"
                    android:textColor="?attr/textColor3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/ivPower"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/icon_power"
                    app:layout_constraintBottom_toBottomOf="@+id/tvPower"
                    app:layout_constraintEnd_toStartOf="@+id/tvPower"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tvPower" />

                <TextView
                    android:id="@+id/tvPower"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/d_din_pro_600_semibold"
                    android:text="@{layout.balance}"
                    android:textColor="?attr/textColor1"
                    android:textSize="24sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ivPower"
                    app:layout_constraintTop_toBottomOf="@+id/tvBalance"
                    tools:text="1000" />

                <include
                    android:id="@+id/banner"
                    banner="@{layout.workCourseBanner}"
                    layout="@layout/layout_common_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@+id/tvPower" />

                <TextView
                    android:id="@+id/tvRechargeAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="24dp"
                    android:text="选择充值金额"
                    android:textAppearance="@style/Text16"
                    android:textColor="?attr/textColor2"
                    android:textStyle="normal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/banner" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRechargeAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adapter="@{layout.powerAdapter}"
                    android:overScrollMode="never"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="6dp"
                    android:scrollbars="none"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/tvRechargeAmount"
                    app:spanCount="3"
                    tools:itemCount="6"
                    tools:listitem="@layout/item_recharge_power" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/icon_prompt_16"
                    android:drawablePadding="4dp"
                    android:text="算力值有效期：1年"
                    android:textAppearance="@style/Text12"
                    android:textColor="?attr/textColor4"
                    app:layout_constraintStart_toStartOf="@+id/tvRechargeAmount"
                    app:layout_constraintTop_toBottomOf="@+id/rvRechargeAmount" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="40dp"
                    android:text="支付方式"
                    android:textAppearance="@style/Text16"
                    android:textColor="?attr/textColor2"
                    android:textStyle="normal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rvRechargeAmount" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPayment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="64dp"
                    android:adapter="@{layout.paymentAdapter}"
                    android:overScrollMode="never"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="6dp"
                    android:scrollbars="none"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/rvRechargeAmount"
                    app:spanCount="2"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_recharge_payment" />

                <TextView
                    singleClick="@{(v)->layout.recharge()}"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@drawable/selector_common_button"
                    android:gravity="center"
                    android:text="立即充值"
                    android:textAppearance="@style/Text16"
                    android:textColor="@color/fixed_white_1"
                    app:layout_constraintBottom_toTopOf="@+id/llPolicy"
                    app:layout_constraintDimensionRatio="345:44"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintWidth_percent="0.92" />

                <LinearLayout
                    android:id="@+id/llPolicy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="充值即代表同意"
                        android:textAppearance="@style/Text12"
                        android:textColor="?attr/textColor3" />

                    <TextView
                        singleClick="@{(v)->layout.viewPolicy()}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingVertical="12dp"
                        android:text="《充值协议》"
                        android:textAppearance="@style/Text12"
                        android:textColor="?attr/textColor1" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.kgmedia.fastfilm.widget.LoadStateViewHolder>
    </LinearLayout>

</layout>