<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        app:cardElevation="3dp"
        app:cardMaxElevation="6dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        android:layout_marginVertical="12dp"
        android:layout_marginHorizontal="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <ImageView
                android:id="@+id/iv_tick"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_tick_green_filled"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/str_agent_memory_title"
                android:textColor="@color/color_90_000000"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/iv_tick"
                app:layout_constraintStart_toEndOf="@id/iv_tick"
                app:layout_constraintTop_toTopOf="@id/iv_tick" />

            <TextView
                android:id="@+id/tv_all_memory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:text="@string/str_agent_memory_all"
                android:textColor="@color/color_76_3c3c43"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/tv_title"
                app:layout_constraintEnd_toStartOf="@id/iv_right"
                app:layout_constraintTop_toTopOf="@id/tv_title" />

            <ImageView
                android:id="@+id/iv_right"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_arrow_right"
                app:layout_constraintBottom_toBottomOf="@id/tv_all_memory"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tv_all_memory" />

            <TextView
                android:id="@+id/tv_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="20dp"
                app:layout_constraintBottom_toTopOf="@id/tv_confirm"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_title"
                android:textSize="16sp"
                tools:text="具体原因：对公司大小周不满" />

            <TextView
                android:id="@+id/tv_negation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_s1_10_000000_ffffff_r90"
                android:paddingHorizontal="26dp"
                android:paddingVertical="10dp"
                android:text="@string/str_agent_memory_negation"
                android:textSize="14sp"
                android:textColor="@color/color_90_000000"
                app:layout_constraintBottom_toBottomOf="@id/tv_confirm"
                app:layout_constraintEnd_toStartOf="@id/tv_confirm"
                app:layout_constraintTop_toTopOf="@id/tv_confirm" />

            <TextView
                android:id="@+id/tv_confirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_242424_r90"
                android:paddingHorizontal="19dp"
                android:paddingVertical="10dp"
                android:text="@string/str_agent_memory_confirm"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_content" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>
