<?xml version="1.0" encoding="utf-8"?><!--收益提现-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.wallet.withdraw.WithdrawViewModel" />

        <import type="android.view.View" />

        <import type="com.kgmedia.fastfilm.core.network.apis.entity.WithdrawAccountInfo" />

        <import type="com.kgmedia.fastfilm.common.ext.FormatUtils" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_model_toolbar"
            toolbar="@{layout.toolbar}" />

        <com.kgmedia.fastfilm.widget.LoadStateViewHolder
            displayChild="@{layout.loadState}"
            onRetry="@{layout::refreshSummary}"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:lightMode="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:paddingTop="26dp"
                            android:paddingBottom="32dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@{FormatUtils.formatDecimal(layout.summary.balance)}"
                                android:textColor="@color/color_121212"
                                android:textSize="30dp"
                                android:textStyle="bold"
                                tools:text="100.00" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="收益余额（元）"
                                android:textColor="@color/color_50_121212"
                                android:textSize="12dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="10dp"
                            android:text="提现金额"
                            android:textColor="@color/color_121212"
                            android:textSize="14dp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginHorizontal="16dp">

                            <EditText
                                android:id="@+id/etAmount"
                                setTextSizeSp="@{layout.withdrawAmount.length()>0?27:18}"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:gravity="center_vertical"
                                android:hint="请输入"
                                android:inputType="numberDecimal"
                                android:maxLength="7"
                                android:paddingStart="28dp"
                                android:paddingEnd="16dp"
                                android:singleLine="true"
                                android:textColor="@color/color_121212"
                                android:textColorHint="@color/color_20_121212"
                                android:textSize="18dp" />

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="¥"
                                android:textColor="@color/color_121212"
                                android:textSize="20dp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_gravity="bottom"
                                android:background="@color/color_05_121212" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="10dp"
                            android:text="提现方式"
                            android:textColor="@color/color_121212"
                            android:textSize="14dp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="10dp"
                            android:paddingHorizontal="16dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="9dp"
                                android:layout_weight="1"
                                android:background="@{layout.method == WithdrawAccountInfo.ACCOUNT_TYPE_WX?@drawable/bg_efefef_r8_wx:@drawable/bg_efefef_r8}"
                                android:elevation="0dp"
                                android:gravity="center_vertical"
                                android:onClick="@{(v)->layout.setWithdrawMethod(WithdrawAccountInfo.ACCOUNT_TYPE_WX)}"
                                android:orientation="horizontal"
                                android:visibility="gone"
                                tools:background="@drawable/bg_efefef_r8">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_marginStart="10dp"
                                    android:src="@drawable/ic_pm_wechat" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:text="微信"
                                    android:textColor="@color/color_121212"
                                    android:textSize="12dp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_ededed_r6"
                                android:elevation="0dp"
                                android:gravity="center_vertical"
                                android:onClick="@{(v)->layout.setWithdrawMethod(WithdrawAccountInfo.ACCOUNT_TYPE_ZFB)}"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="22dp"
                                    android:layout_height="22dp"
                                    android:layout_marginStart="10dp"
                                    android:src="@drawable/ic_pm_alipay" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:text="支付宝"
                                    android:textColor="@color/color_121212"
                                    android:textSize="12dp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="10dp"
                            android:text="提现账号"
                            android:textColor="@color/color_121212"
                            android:textSize="14dp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/account"
                            singleClick="@{(v)->layout.bindAccount()}"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_f6f6f6_stroke_10_121212_r6"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="16dp"
                                android:drawablePadding="4dp"
                                android:drawableTintMode="src_in"
                                android:text="@{`立即绑定`+(layout.method==WithdrawAccountInfo.ACCOUNT_TYPE_WX?`微信号`:`支付宝`)}"
                                android:textColor="@color/color_ff5858"
                                android:textSize="12dp"
                                android:textStyle="bold"
                                android:visibility="@{layout.accountInfo==null?View.VISIBLE:View.GONE}"
                                tools:text="立即绑定微信号" />

                            <com.kgmedia.fastfilm.widget.roundedimageview.RoundedImageView
                                loadThumbnailUri="@{layout.accountInfo.accountAvatar}"
                                placeHolder="@{@drawable/ic_default_avatar}"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginStart="10dp"
                                android:scaleType="centerCrop"
                                android:visibility="@{layout.accountInfo!=null?View.VISIBLE:View.GONE}"
                                app:riv_oval="true"
                                tools:src="@drawable/ic_default_avatar" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:text="@{layout.accountInfo.accountName}"
                                android:textColor="@color/color_121212"
                                android:textSize="12dp"
                                android:textStyle="bold"
                                android:visibility="@{layout.accountInfo!=null?View.VISIBLE:View.GONE}"
                                tools:text="昵称昵称" />
                        </LinearLayout>

                        <TextView
                            singleClick="@{(v)->layout.confirm()}"
                            android:layout_width="232dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="64dp"
                            android:background="@{layout.committable?@drawable/btn_common_dark_normal:@drawable/bg_20_121212_r50}"
                            android:gravity="center"
                            android:text="确定提现"
                            android:textColor="@color/white"
                            android:textSize="14dp"
                            android:textStyle="bold"
                            tools:background="@drawable/bg_20_121212_r50" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="阅读并同意 "
                                android:textColor="@color/color_50_121212"
                                android:textSize="12dp" />

                            <TextView
                                singleClick="@{(v)->layout.viewPolicy()}"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingVertical="10dp"
                                android:text="《积分兑换收益协议》"
                                android:textColor="@color/color_121212"
                                android:textSize="12dp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginTop="24dp"
                            android:text="提现须知："
                            android:textColor="@color/color_50_121212"
                            android:textSize="12dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="16dp"
                            android:lineSpacingExtra="@dimen/lineSpacingExtra"
                            android:text="@{layout.summary.withdrawalRuleMsgList()}"
                            android:textColor="@color/color_50_121212"
                            android:textSize="12dp"
                            tools:text="1.单笔提现金额为10～3000元，每人每天只可提现1次；\n2.提现会在7个工作日内到账，如遇节假日将依次延后，请耐心等待。" />
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>
        </com.kgmedia.fastfilm.widget.LoadStateViewHolder>
    </LinearLayout>
</layout>