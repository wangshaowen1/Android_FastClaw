<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.shiyuan.fastclaw.feature.login.phone.PhoneNewLoginViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_f7faff">

        <ImageView
            android:id="@+id/ivLoginBg"
            android:layout_width="320dp"
            android:layout_height="488dp"
            android:layout_marginStart="-3dp"
            android:layout_marginTop="26dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_phone_new_login_top"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.shiyuan.fastclaw.widget.StatusBarView
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="44dp"
            android:importantForAccessibility="no"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="10dp"
            android:src="@drawable/ic_phone_new_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPhoneTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="35dp"
            android:layout_marginTop="164dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:lineHeight="32dp"
            android:text="@string/change_mobile_title"
            android:textColor="@color/color_000000"
            android:textSize="28sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/statusBar" />

        <TextView
            android:id="@+id/tvPhoneSubtitle"
            android:layout_width="305dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="35dp"
            android:layout_marginTop="5dp"
            android:includeFontPadding="false"
            android:lineHeight="19dp"
            android:text="@string/change_mobile_subtitle"
            android:textColor="@color/color_90_000000"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPhoneTitle" />

        <com.shiyuan.fastclaw.widget.shape.SuperConstraintLayout
            android:id="@+id/layoutPhoneInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="27dp"
            android:layout_marginEnd="35dp"
            android:elevation="4dp"
            android:outlineAmbientShadowColor="#0F00258A"
            android:outlineSpotShadowColor="#0F00258A"
            app:background_normalColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPhoneSubtitle"
            app:super_corner="100dp"
            tools:targetApi="p">

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="4dp"
                android:background="@android:color/transparent"
                android:gravity="center_vertical"
                android:hint="@string/login_new_phone_hint"
                android:importantForAutofill="no"
                android:digits="0123456789"
                android:inputType="phone"
                android:maxLength="11"
                android:padding="0dp"
                android:text="@={layout.mobile}"
                android:textColor="@color/color_96_000000"
                android:textColorHint="@color/color_55_3c3c43"
                android:textCursorDrawable="@drawable/edittext_cursor"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivClearPhone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_goneMarginEnd="20dp"
                tools:text="1309898970" />

            <ImageView
                android:id="@+id/ivClearPhone"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:padding="15dp"
                android:src="@drawable/icon_backcheck_search_close"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="ContentDescription"
                tools:visibility="visible" />
        </com.shiyuan.fastclaw.widget.shape.SuperConstraintLayout>

        <TextView
            android:id="@+id/tvPhoneError"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="36dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="28dp"
            android:includeFontPadding="false"
            android:lineHeight="16dp"
            android:text="@string/login_new_phone_error"
            android:textColor="@color/color_F74C30"
            android:textSize="12sp"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutPhoneInput"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/btnGetCode"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="63dp"
            android:layout_marginEnd="35dp"
            android:background="@drawable/bg_2f6bff_r100"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineHeight="23dp"
            android:text="@string/login_new_get_sms_code"
            android:textColor="@color/white"
            android:textSize="15sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPhoneError" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
