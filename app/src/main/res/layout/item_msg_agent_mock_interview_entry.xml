<?xml version="1.0" encoding="utf-8"?>
<com.shiyuan.fastclaw.widget.shape.SuperConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_mock_interview_entry_card"
    android:layout_width="match_parent"
    android:layout_height="341dp"
    app:border_color="@color/color_ffffff"
    app:super_corner="20dp"
    app:view_border_width="1dp">

    <ImageView
        android:id="@+id/iv_room_bg"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="33dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/img_mock_interview_room_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_person"
        android:layout_width="98dp"
        android:layout_height="124dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/img_mock_interview_person"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.52"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_mock_interview_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/iv_mock_interview_header_bg"
            android:layout_width="0dp"
            android:layout_height="240dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/img_mock_interview_header_bg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_mock_interview_header"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:gravity="start|center_vertical"
            android:paddingStart="26dp"
            android:text="@string/str_agent_mock_interview_title"
            android:textColor="@color/color_ffffff"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_mock_interview_content"
            android:layout_width="0dp"
            android:layout_height="198dp"
            android:background="@drawable/bg_mock_interview_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:id="@+id/ll_mock_interview_steps"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_agent_mock_interview_step1"
                    android:textColor="@color/color_2f6bff"
                    android:textSize="11sp" />

                <ImageView
                    android:layout_width="7dp"
                    android:layout_height="6dp"
                    android:layout_marginHorizontal="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mock_interview_step_arrow" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/str_agent_mock_interview_step2"
                    android:textColor="@color/color_90_000000"
                    android:textSize="11sp" />

                <ImageView
                    android:layout_width="7dp"
                    android:layout_height="6dp"
                    android:layout_marginHorizontal="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mock_interview_step_arrow" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/str_agent_mock_interview_step3"
                    android:textColor="@color/color_90_000000"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_step_divider"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginTop="14dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/img_mock_interview_step_divider"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ll_mock_interview_steps" />

            <TextView
                android:id="@+id/tv_mock_interview_desc"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:text="@string/str_agent_mock_interview_desc"
                android:textColor="@color/color_90_000000"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_step_divider"
                tools:text="欢迎来到面试间，我将根据你的简历，帮你提前押题，提高面试通过率。" />

            <com.shiyuan.fastclaw.widget.shape.SuperLinearLayout
                android:id="@+id/layout_action"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:background_normalColor="@color/color_2f6bff"
                app:super_corner="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_mock_interview_desc">

                <TextView
                    android:id="@+id/tv_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/str_agent_mock_interview_action_main"
                    android:textColor="@color/color_ffffff"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_cost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/str_agent_mock_interview_action_cost"
                    android:textColor="@color/color_ffffff"
                    android:textSize="13sp" />
            </com.shiyuan.fastclaw.widget.shape.SuperLinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.shiyuan.fastclaw.widget.shape.SuperConstraintLayout>
