<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.shiyuan.fastclaw.feature.mine.ItemMineRechargePackageVM" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@{item.select ? @drawable/bg_mine_recharge_package_selected : @drawable/bg_mine_recharge_package_normal}"
        android:gravity="center"
        singleClick="@{(v) -> item.onItemClick.invoke(v)}"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPackageAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:text="@{item.data.amount}"
                android:textColor="@{item.select ? @color/color_2f6bff : @color/color_90_000000}"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="300" />

            <ImageView
                android:layout_gravity="center_vertical"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_marginStart="3dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_mine_shrimp_stick" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPackagePrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:text="@{item.data.price}"
            android:textColor="@{item.select ? @color/color_2f6bff : @color/color_55_3c3c43}"
            android:textSize="15sp"
            tools:text="¥30" />
    </LinearLayout>
</layout>
