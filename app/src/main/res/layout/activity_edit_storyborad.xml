<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.editor.ShortDramaEditorViewModel" />

        <import type="android.text.TextUtils" />

        <import type="com.kgmedia.fastfilm.common.ext.TextViewExtKt" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.kgmedia.fastfilm.widget.LoadStateViewHolder
            displayChild="@{layout.loadState}"
            onRetry="@{()->layout.getStoryboardInfo(false)}"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <com.kgmedia.fastfilm.widget.StatusBarView
                    android:id="@+id/statusBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/action_bar_size"
                    android:gravity="center"
                    android:text="重绘分镜"
                    android:textAppearance="@style/Text16"
                    android:textColor="?attr/textColor1"
                    app:layout_constraintTop_toBottomOf="@+id/statusBar" />

                <androidx.constraintlayout.widget.Placeholder
                    android:id="@+id/previewArea"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintDimensionRatio="375:356"
                    app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

                <TextView
                    android:id="@+id/btnGenerate"
                    singleClick="@{layout.clickHandler::onClick}"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="13dp"
                    android:background="@drawable/selector_common_button"
                    android:drawableStart="@drawable/icon_synthesis"
                    android:drawablePadding="4dp"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="保存"
                    android:textAppearance="@style/Text14"
                    android:textColor="?attr/textColor1"
                    app:layout_constraintBottom_toBottomOf="@+id/tvTitle"
                    app:layout_constraintEnd_toEndOf="@+id/tvTitle"
                    app:layout_constraintTop_toTopOf="@+id/tvTitle" />

                <ImageView
                    android:id="@+id/image"
                    loadUri="@{layout.currentSegment.data.image?layout.currentSegment.data.shotSegmentImageUrl:null}"
                    setDimensionRatio="@{layout.shortDrama.videoRatioValue}"
                    setVisible="@{layout.currentSegment.data.generated &amp;&amp; layout.currentSegment.data.image}"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:onClick="@{(v)->layout.play()}"
                    android:scaleType="centerCrop"
                    app:layout_constraintBottom_toBottomOf="@+id/previewArea"
                    app:layout_constraintEnd_toEndOf="@+id/previewArea"
                    app:layout_constraintStart_toStartOf="@+id/previewArea"
                    app:layout_constraintTop_toTopOf="@+id/previewArea"
                    tools:layout_constraintDimensionRatio="9:16" />

                <ImageView
                    setVisible="@{layout.currentSegment.data.generated &amp;&amp; layout.currentSegment.data.image}"
                    android:layout_width="32dp"
                    android:layout_height="16dp"
                    android:layout_margin="8dp"
                    android:src="@drawable/icon_ai_label"
                    app:layout_constraintStart_toStartOf="@+id/image"
                    app:layout_constraintTop_toTopOf="@+id/image"
                    tools:text="AI生成" />

                <ImageView
                    setVisible="@{!layout.playing}"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_short_drama_editor_play"
                    app:layout_constraintBottom_toBottomOf="@+id/previewArea"
                    app:layout_constraintEnd_toEndOf="@+id/previewArea"
                    app:layout_constraintStart_toStartOf="@+id/previewArea"
                    app:layout_constraintTop_toTopOf="@+id/previewArea" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    setDimensionRatio="@{layout.shortDrama.videoRatioValue}"
                    setVisible="@{layout.currentSegment.data != null &amp;&amp; !layout.currentSegment.data.generated}"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@color/color_10_ffffff"
                    android:gravity="center"
                    android:onClick="@{(v)->layout.play()}"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@+id/previewArea"
                    app:layout_constraintEnd_toEndOf="@+id/previewArea"
                    app:layout_constraintStart_toStartOf="@+id/previewArea"
                    app:layout_constraintTop_toTopOf="@+id/previewArea"
                    tools:layout_constraintDimensionRatio="9:16">

                    <TextView
                        android:id="@+id/tvStoryboardStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@{layout.currentSegment.genStatusBig(layout.currentSegment.data.genStatus)}"
                        android:textColor="?colorPrimary"
                        android:textSize="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="图片生成排队中" />

                    <TextView
                        setVisible="@{layout.currentSegment.data.generating}"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="退出后会继续生成"
                        android:textColor="?colorAccent"
                        android:textSize="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvStoryboardStatus" />

                    <TextView
                        android:id="@+id/btnRetry"
                        setVisible="@{layout.currentSegment.data.failed}"
                        singleClick="@{() -> layout.retryGenerate()}"
                        android:layout_width="90dp"
                        android:layout_height="32dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/btn_common_dark_normal"
                        android:gravity="center"
                        android:text="点击重试"
                        android:textColor="?colorPrimary"
                        android:textSize="12dp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvStoryboardStatus"
                        tools:visibility="visible" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tvStoryboardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="24dp"
                    android:text="分镜设计"
                    android:textAppearance="@style/Text14"
                    android:textColor="?attr/textColor2"
                    android:textStyle="bold"
                    app:layout_constraintDimensionRatio="345:130"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/previewArea" />

                <com.kgmedia.fastfilm.widget.roundedimageview.RoundedImageView
                    android:id="@+id/ivCover"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:scaleType="centerCrop"
                    app:layout_constraintDimensionRatio="108:152"
                    app:layout_constraintStart_toStartOf="@+id/tvStoryboardTitle"
                    app:layout_constraintTop_toBottomOf="@+id/tvStoryboardTitle"
                    app:layout_constraintWidth_percent="0.288"
                    app:riv_border_color="?attr/borderColor2"
                    app:riv_border_width="1dp"
                    app:riv_corner_radius="8dp"
                    tools:src="?funcColorSuccess" />

                <TextView
                    android:id="@+id/tvStoryboardDesc"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="15dp"
                    android:background="@drawable/fill_color1_r8"
                    android:ellipsize="end"
                    android:lineSpacingExtra="@dimen/lineSpacingExtraShort"
                    android:padding="12dp"
                    android:text="史莱克七怪之首，沉稳冷静。他留着一头深蓝色长发，目光深篷，拥有极强的战斗天赋和统筹全局的智慧。战斗时使用蓝银草魂灵与外附魂骨八蛛矛。"
                    android:textAppearance="@style/Text13"
                    android:textColor="?attr/textColor2"
                    app:layout_constraintDimensionRatio="229:130"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ivCover"
                    app:layout_constraintTop_toTopOf="@+id/ivCover" />

                <FrameLayout
                    android:id="@+id/btnRegenerateDesc"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/fill_color1_r4"
                    app:layout_constraintDimensionRatio="229:32"
                    app:layout_constraintEnd_toEndOf="@+id/tvStoryboardDesc"
                    app:layout_constraintStart_toStartOf="@+id/tvStoryboardDesc"
                    app:layout_constraintTop_toBottomOf="@+id/tvStoryboardDesc">

                    <com.kgmedia.fastfilm.widget.GradientTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="重新生成"
                        android:textColor="@android:color/white"
                        app:endColor="#8F83FF"
                        app:startColor="#68BFF9" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginHorizontal="15dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/selector_common_button"
                    android:gravity="center"
                    android:text="重绘分镜"
                    android:textAppearance="@style/Text16"
                    android:textColor="@color/fixed_white_1"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="345:44" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.kgmedia.fastfilm.widget.LoadStateViewHolder>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.kgmedia.fastfilm.widget.StatusBarView
                android:id="@+id/statusBar1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/btnBack"
                singleClick="@{(v)->layout.back()}"
                android:layout_width="48dp"
                android:layout_height="@dimen/action_bar_size"
                android:paddingVertical="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/icon_back_left"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/statusBar1" />
        </LinearLayout>

    </FrameLayout>
</layout>