<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.works.MyWorksViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:windowBackground">

        <com.kgmedia.fastfilm.widget.StatusBarView
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.Group
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="tvTitle,btnEdit"
            tools:visibility="visible" />

        <androidx.constraintlayout.widget.Group
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:constraint_referenced_ids="tvSelectCount,btnSelectAll,btnComplete" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/action_bar_size"
            android:gravity="center"
            android:text="我的作品"
            android:textAppearance="@style/Text18"
            android:textColor="?attr/textColor1"
            app:layout_constraintTop_toBottomOf="@+id/statusBar" />

        <ImageView
            android:id="@+id/btnEdit"
            android:layout_width="54dp"
            android:layout_height="@dimen/action_bar_size"
            android:paddingHorizontal="15dp"
            android:src="@drawable/icon_edit"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="@+id/tvTitle"
            app:layout_constraintTop_toTopOf="@+id/tvTitle" />

        <TextView
            android:id="@+id/tvSelectCount"
            android:layout_width="match_parent"
            android:layout_height="@dimen/action_bar_size"
            android:gravity="center"
            android:text="已选择 0 个"
            android:textAppearance="@style/Text14"
            android:textColor="?attr/textColor4"
            app:layout_constraintTop_toBottomOf="@+id/statusBar" />

        <TextView
            android:id="@+id/btnSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/action_bar_size"
            android:gravity="center"
            android:paddingHorizontal="15dp"
            android:text="全选"
            android:textAppearance="@style/Text14"
            android:textColor="?attr/textColor3"
            app:layout_constraintStart_toStartOf="@+id/tvSelectCount"
            app:layout_constraintTop_toTopOf="@+id/tvSelectCount" />

        <TextView
            android:id="@+id/btnComplete"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/action_bar_size"
            android:gravity="center"
            android:paddingHorizontal="15dp"
            android:text="完成"
            android:textAppearance="@style/Text14"
            android:textColor="?attr/textColor3"
            app:layout_constraintEnd_toEndOf="@+id/tvSelectCount"
            app:layout_constraintTop_toTopOf="@+id/tvSelectCount" />

        <androidx.recyclerview.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/action_bar_size"
            android:adapter="@{layout.adapter}"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="9dp"
            android:paddingVertical="6dp"
            android:scrollbars="none"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:layout_constraintBottom_toTopOf="@+id/btnDelete"
            app:layout_constraintTop_toBottomOf="@+id/statusBar"
            app:spanCount="3"
            tools:listitem="@layout/item_my_work" />

        <LinearLayout
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_bottom_nav_height"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableLeft="@drawable/icon_delete_red"
                android:drawablePadding="8dp"
                android:text="删除"
                android:textAppearance="@style/Text14"
                android:textColor="?attr/funcColorFailure" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>