<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_70_4c4c4c_r12">

    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="128dp"
        android:layout_height="128dp">

        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:lottie_autoPlay="true"
            app:lottie_imageAssetsFolder="loading_star/images"
            app:lottie_fileName="loading_star/loading_star.json"
            app:lottie_loop="true"
            app:lottie_repeatMode="restart" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/report_post_analysis"
            android:textColor="?attr/textColor1"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>