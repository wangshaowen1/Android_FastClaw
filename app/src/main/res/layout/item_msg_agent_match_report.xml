<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_match_report_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_msg_agent_left"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="20dp">

    <!-- 顶部：对勾 + 主标题 -->
    <ImageView
        android:id="@+id/iv_match_check"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_tick_green_filled"
        app:layout_constraintBottom_toBottomOf="@id/tv_match_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_match_title" />

    <TextView
        android:id="@+id/tv_match_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="@string/str_agent_match_report_title"
        android:textColor="@color/color_90_000000"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_match_check"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/v_match_divider"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:layout_marginTop="16dp"
        android:background="@color/color_10_000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_match_title" />

    <TextView
        android:id="@+id/tv_match_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingExtra="4dp"
        android:text="@string/str_agent_match_report_subtitle"
        android:textColor="@color/color_90_000000"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/v_match_divider" />

    <!-- 内嵌白卡：匹配信息 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_match_detail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_ffffff_r12"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_match_subtitle">

        <!-- 左：公司名 -->
        <TextView
            android:id="@+id/tv_match_company"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/color_90_000000"
            android:textSize="14sp"
            app:layout_constraintEnd_toStartOf="@id/v_match_gauge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="你和&#8220;深圳市快歌AI智能投资控股有限公司&#8221;" />

        <!-- 左：岗位（蓝色） -->
        <TextView
            android:id="@+id/tv_match_position"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/color_0099FF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/v_match_gauge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_match_company"
            tools:text="产品经理" />

        <ImageView
            app:layout_constraintTop_toTopOf="@id/tv_match_slogan"
            app:layout_constraintBottom_toBottomOf="@id/tv_match_slogan"
            app:layout_constraintStart_toStartOf="@id/tv_match_slogan"
            android:layout_marginStart="16dp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_agent_match_slogan_bg"
            android:id="@+id/iv_match_slogan_bg"
            android:layout_width="66dp"
            android:layout_height="50dp"/>
        
        <!-- 左：双向奔赴大字 -->
        <TextView
            android:id="@+id/tv_match_slogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="7dp"
            android:fontFamily="@font/alimama_shu_hei_ti_bold"
            android:text="@string/str_agent_match_slogan"
            android:textColor="@color/color_90_000000"
            android:textSize="32sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_match_position" />

        <!-- 右：仪表盘占位（后续替换为美术素材 ImageView） -->
        <View
            android:id="@+id/v_match_gauge"
            android:layout_width="130dp"
            android:layout_height="80dp"
            android:background="@drawable/ic_agent_match_score_bg"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 右：匹配分数 -->
        <TextView
            android:id="@+id/tv_match_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/d_din_pro_600_semibold"
            android:textColor="@color/color_90_000000"
            android:textSize="32sp"
            app:layout_constraintBottom_toTopOf="@id/tv_match_score_label"
            app:layout_constraintEnd_toEndOf="@id/v_match_gauge"
            app:layout_constraintStart_toStartOf="@id/v_match_gauge"
            tools:text="98" />

        <!-- 右：匹配率小字 -->
        <TextView
            android:id="@+id/tv_match_score_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/str_agent_match_rate_label"
            android:textColor="@color/color_56_3c3c43"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/v_match_gauge"
            app:layout_constraintEnd_toEndOf="@id/tv_match_score"
            app:layout_constraintStart_toStartOf="@id/tv_match_score" />

        <!-- Barrier：取左侧 slogan 与右侧 score_label 中更靠下的，作为结论卡顶部约束 -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/barrier_match_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="tv_match_slogan,tv_match_score_label" />

        <ImageView
            app:layout_constraintStart_toStartOf="@id/cl_match_conclusion"
            app:layout_constraintEnd_toEndOf="@id/cl_match_conclusion"
            app:layout_constraintTop_toTopOf="@id/cl_match_conclusion"
            app:layout_constraintBottom_toBottomOf="@id/cl_match_conclusion"
            android:src="@drawable/ic_agent_match_conclusion_bg"
            android:scaleType="fitXY"
            android:layout_width="0dp"
            android:layout_height="0dp"/>

        <!-- 底部浅蓝结论卡（一个容器装 title+desc，单一圆角背景） -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_match_conclusion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/barrier_match_bottom">

            <TextView
                android:id="@+id/tv_match_conclusion_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/color_1C67CB"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="没错，你就是他们要找的那个人！" />

            <TextView
                android:id="@+id/tv_match_conclusion_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/color_1C67CB"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_match_conclusion_title"
                tools:text="履历经历贴合招聘标准，契合企业需求，是HR理想人选。" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 底部黑色圆角按钮 -->
    <TextView
        android:id="@+id/btn_match_generate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_242424_r100"
        android:gravity="center"
        android:paddingVertical="16dp"
        android:text="@string/str_agent_match_generate_btn"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cl_match_detail" />

</androidx.constraintlayout.widget.ConstraintLayout>