<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.play.SeriesShortsViewModel" />

        <import type="android.view.View" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/seriesInfo"
        singleClick="@{layout.clickHandler::onClick}"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/bg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/bg_23232c_tr24"
            app:layout_constraintDimensionRatio="375:580"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView
            android:id="@+id/seriesTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:drawableStart="@drawable/ic_short_series"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            tools:text="章节｜穿成恶毒女配后，我反向攻略女主..."
            android:text="@{`章节 ｜ `+layout.seriesInfo.seriesName}"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:drawablePadding="7dp"
            app:layout_constraintEnd_toStartOf="@id/close"
            android:layout_marginEnd="18dp"
            />
        <TextView
            android:id="@+id/playbackInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/seriesTitle"
            app:layout_constraintTop_toBottomOf="@id/seriesTitle"
            android:layout_marginTop="9dp"
            android:text="@{layout.subTitle}"
            tools:text="5万 播放·5454 追更 更新至20章"
            android:textSize="12sp"
            android:textColor="@color/color_50_ffffff"
            style="@style/Text.Common"/>
        <TextView
            android:id="@+id/series"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="目录"
            app:layout_constraintTop_toBottomOf="@id/playbackInfo"
            app:layout_constraintStart_toStartOf="@id/seriesTitle"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            />
        <com.kgmedia.fastfilm.widget.LoadStateViewHolder
            android:id="@+id/loadStateViewHolder"
            android:layout_width="match_parent"
            android:layout_marginTop="8dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/bg"
            app:layout_constraintTop_toBottomOf="@+id/series"
            >
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/playlistView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingVertical="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_short_chooser"
               />
        </com.kgmedia.fastfilm.widget.LoadStateViewHolder>

        <ImageView
            android:id="@+id/close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_dialog_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:padding="4dp"
            android:layout_margin="16dp"
            android:onClick="@{()->layout.dismiss()}"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
