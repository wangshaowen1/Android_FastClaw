<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.kgmedia.fastfilm.feature.hit.recommend.ItemHitRecommendVm" />

        <import type="android.view.View" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_ffffff_r8"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- 左侧头像区域 -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_avatar"
            loadHQThumbnailUri="@{item.data.dramasCover}"
            placeHolder="@{@drawable/ic_default_cover}"
            android:layout_width="90dp"
            android:layout_height="120dp"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/roundStyle_r8"
            tools:src="@drawable/ic_default_cover" />

        <ImageView
            android:layout_width="30dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_50_000000_leaf_left_top_r8"
            android:paddingHorizontal="6dp"
            android:src="@drawable/ic_vip54"
            android:visibility="@{item.data.vipValid?View.VISIBLE:View.GONE}"
            app:layout_constraintStart_toStartOf="@id/iv_avatar"
            app:layout_constraintTop_toTopOf="@id/iv_avatar" />

        <!-- 人物名称 -->
        <TextView
            android:id="@+id/tv_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@{item.data.dramasName}"
            android:textColor="@color/textColorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btn_make_same"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@id/iv_avatar"
            app:layout_constraintTop_toTopOf="@id/iv_avatar"
            tools:text="都市丽人柳如烟" />

        <!-- 标签容器 -->
        <LinearLayout
            android:id="@+id/llContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toStartOf="@id/btn_make_same"
            app:layout_constraintStart_toStartOf="@id/tv_name"
            app:layout_constraintTop_toBottomOf="@id/tv_name">

            <TextView
                android:id="@+id/tv_tag_hot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_10_ff8902_r50"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="@{(item.data.tags.size()>0)?item.data.tags.get(0):``}"
                android:textColor="@color/color_ff7b23"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="@{(item.data.tags.size()>0)?View.VISIBLE:View.GONE}"
                tools:text="#全网热播" />

            <TextView
                android:id="@+id/tv_tag_recent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_10_ff3737_r50"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="@{(item.data.tags.size()>1)?item.data.tags.get(1):``}"
                android:textColor="@color/color_ff2b2b"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="@{(item.data.tags.size()>1)?View.VISIBLE:View.GONE}"
                tools:text="#近期热门" />
        </LinearLayout>

        <!-- 做同款按钮 -->
        <Button
            android:id="@+id/btn_make_same"
            style="@style/Button.Bold"
            singleClick="@{(v)->item.onItemClick.invoke(v)}"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingHorizontal="21dp"
            android:paddingVertical="6dp"
            android:text="做同款"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_name" />

        <!-- 对话文本 -->
        <TextView
            android:id="@+id/tv_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:ellipsize="end"
            android:lineSpacingExtra="@dimen/lineSpacingExtraShort"
            android:maxLines="2"
            android:text="@{item.data.introduction}"
            android:textColor="@color/color_50_121212"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/iv_avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_name"
            tools:text="分手吧，就这样吧!我现在男女通吃，跟你三观不合，就这样吧!你，你说什么..." />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>