<?xml version="1.0" encoding="utf-8"?><!--添加人脸-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.timbre.TimbreExtractionViewModel" />

        <import type="android.view.View" />

        <import type="com.kgmedia.fastfilm.common.utils.DateUtil" />

        <import type="com.kgmedia.fastfilm.widget.progress.RingProgressView" />
    </data>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_model_toolbar"
            app:toolbar="@{layout.mToolbarVM}" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_80_ffffff_r12"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="10dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/txt_timbre_extraction_1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginHorizontal="16dp"
                android:text="朗读下面文字或读任意内容即可，宝宝和家长都可以录制"
                android:textColor="@color/textColorPrimary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:text="《小兔子的阳光之旅》"
            android:textColor="@color/textColorPrimary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:lineSpacingExtra="@dimen/lineSpacingExtra"
            android:text="@string/text_timbre_clone_example_content"
            android:textColor="@color/textColorPrimary"
            android:textSize="16sp" />

        <ViewAnimator
            android:id="@+id/viewAnimator"
            displayChild="@{layout.displayChild}"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="16dp">

                <View
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_30_ffffff_stroke_round"
                    app:layout_constraintBottom_toBottomOf="@id/recordProgress"
                    app:layout_constraintEnd_toEndOf="@id/recordProgress"
                    app:layout_constraintStart_toStartOf="@id/recordProgress"
                    app:layout_constraintTop_toTopOf="@id/recordProgress" />

                <ImageView
                    android:id="@+id/btnPause"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:padding="9dp"
                    android:src="@{!layout.recordPause&amp;&amp;layout.recording?@drawable/ic_record_pause:@drawable/oval_ff4e4e_s20}"
                    app:layout_constraintBottom_toBottomOf="@id/recordProgress"
                    app:layout_constraintEnd_toEndOf="@id/recordProgress"
                    app:layout_constraintStart_toStartOf="@id/recordProgress"
                    app:layout_constraintTop_toTopOf="@id/recordProgress"
                    tools:src="@drawable/ic_record_pause" />

                <com.kgmedia.fastfilm.widget.progress.RingProgressView
                    android:id="@+id/recordProgress"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    app:f_endColor="@color/color_ff4e4e"
                    app:f_roundWidth="4dp"
                    app:f_startColor="@color/color_ff4e4e"
                    app:f_strokeCap="round"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:progress="@{layout.recordProgress}"
                    tools:f_progress="50" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@{layout.recordTime+`/`+DateUtil.secToTime(layout.maxRecordDuring)}"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toTopOf="@id/recordProgress"
                    app:layout_constraintEnd_toEndOf="@id/recordProgress"
                    app:layout_constraintStart_toStartOf="@id/recordProgress"
                    tools:text="00:00/01:00" />

                <TextView
                    android:id="@+id/btnReRecord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="70dp"
                    android:layout_marginBottom="10dp"
                    android:alpha="@{layout.recordProgress>=0?1f:0.3f}"
                    android:drawableTop="@drawable/ic_reset_black72"
                    android:drawablePadding="2dp"
                    android:enabled="@{layout.recordProgress>=0}"
                    android:text="重录"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@id/recordProgress"
                    app:layout_constraintEnd_toStartOf="@id/recordProgress" />

                <TextView
                    android:id="@+id/btnCommit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="70dp"
                    android:layout_marginBottom="10dp"
                    android:alpha="@{layout.commitEnable?1f:0.3f}"
                    android:drawableTop="@drawable/ic_sel_black72"
                    android:drawablePadding="2dp"
                    android:enabled="@{layout.commitEnable}"
                    android:text="完成"
                    android:textColor="@color/textColorPrimary"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@id/recordProgress"
                    app:layout_constraintStart_toEndOf="@id/recordProgress" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/btnStart"
                style="@style/Button.Menu"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="38dp"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="30dp"
                android:gravity="center"
                android:text="开始录制" />
        </ViewAnimator>
    </LinearLayout>


</layout>