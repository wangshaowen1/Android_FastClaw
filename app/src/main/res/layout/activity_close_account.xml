<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.settings.logoff.LogoffViewModel" />

        <import type="android.view.View" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/toolbar"
            layout="@layout/view_model_toolbar"
            app:toolbar="@{layout.mToolbarVM}" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_06_ffffff_b1_2e2e30_r12"
                android:orientation="vertical"
                android:padding="@dimen/radius_l">

                <TextView
                    style="@style/TextSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="用户注销须知"
                    android:textColor="@color/text_color_2_dark" />

                <TextView
                    style="@style/TextBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/radius_l"
                    android:lineSpacingExtra="@dimen/lineSpacingExtra"
                    android:text="@string/app_log_off"
                    android:textColor="@color/text_color_3_dark" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/ll_agreement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:onClick="@{(v)->layout.checkPolicy()}"
            android:orientation="horizontal"
            android:visibility="@{layout.removeAccountState==0?View.VISIBLE:View.GONE}">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@{layout.checkedPolicy?@drawable/ic_logoff_choose_checked:@drawable/ic_logoff_choose_normal}"
                tools:src="@drawable/ic_logoff_choose_checked" />

            <TextView
                android:id="@+id/tv_purchase_instructions"
                style="@style/TextCaption"
                setSpanText="@{@string/app_purchase_instructions}"
                singleClick="@{layout.clickHandler::onClick}"
                spanColor="@{@color/func_failure_dark}"
                spanText="@{`账号注销说明`}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="4dp"
                android:text="@string/app_purchase_instructions"
                android:textColor="@color/text_color_3_dark" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="@{layout.removeAccountState==0?View.VISIBLE:View.GONE}">

            <TextView
                style="@style/TextSubtitle"
                singleClick="@{(v)->layout.logOff()}"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/btn_common_cancel"
                android:enabled="@{layout.checkedPolicy}"
                android:gravity="center"
                android:text="申请注销"
                android:textColor="@{layout.checkedPolicy?@color/textColorPrimary:@color/color_40_21213b}"
                tools:textColor="@color/text_color_3_dark" />

            <TextView
                style="@style/TextSubtitle"
                singleClick="@{(v)->layout.back()}"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/gradient_left_73b0f8_right_7567f0_r100"
                android:gravity="center"
                android:text="再想想"
                android:textColor="@color/text_color_1_dark" />

        </LinearLayout>

        <TextView
            android:id="@+id/btnCancel"
            style="@style/TextSubtitle"
            singleClick="@{layout.clickHandler::onClick}"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="@dimen/spacing_l"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="30dp"
            android:background="@drawable/gradient_left_73b0f8_right_7567f0_r100"
            android:gravity="center"
            android:text="申请注销中"
            android:textColor="@color/text_color_1_dark"
            android:visibility="@{layout.removeAccountState==1?View.VISIBLE:View.GONE}"
            tools:visibility="visible" />
    </LinearLayout>
</layout>