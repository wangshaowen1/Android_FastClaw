<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="layout"
            type="com.kgmedia.fastfilm.feature.editor.dubbing.DubbingViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ffffff_tr24"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="字幕配音"
            android:textColor="@color/color_1a1a1a"
            android:textSize="16dp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="保存后应用至所有分镜画面"
            android:textColor="@color/color_000000"
            android:textSize="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle" />

        <com.scwang.smart.refresh.layout.SmartRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:overScrollMode="never"
            app:layout_constraintDimensionRatio="375:324"
            app:layout_constraintTop_toBottomOf="@+id/tvSubtitle"
            app:srlAccentColor="@color/color_121212"
            app:srlEnablePreviewInEditMode="true"
            app:srlPrimaryColor="@color/transparent">

            <com.kgmedia.fastfilm.widget.LoadStateViewHolder
                android:id="@+id/loadStateViewHolder"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    bottom="@{92f/375f}"
                    setPaddingByWidth="@{true}"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="16dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                    app:spanCount="4"
                    tools:listitem="@layout/item_dubbing_timbre" />

            </com.kgmedia.fastfilm.widget.LoadStateViewHolder>
        </com.scwang.smart.refresh.layout.SmartRefreshLayout>

        <View
            android:id="@+id/bottom"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/gradient_top_00_ffffff_bottom_ffffff"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="375:92" />

        <TextView
            android:id="@+id/btnUse"
            setEnabled="@{layout.buttonEnabled}"
            singleClick="@{() -> layout.use()}"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/selector_common_button"
            android:gravity="center"
            android:text="@{layout.buttonText}"
            android:textColor="@color/white"
            android:textSize="16dp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/bottom"
            app:layout_constraintDimensionRatio="317:48"
            app:layout_constraintEnd_toEndOf="@+id/bottom"
            app:layout_constraintStart_toStartOf="@+id/bottom"
            app:layout_constraintTop_toTopOf="@+id/bottom"
            app:layout_constraintWidth_percent="0.85"
            tools:enabled="false"
            tools:text="当前使用" />

        <LinearLayout
            setVisible="@{layout.buyPrice>0}"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:background="@drawable/shape_bg_credits_cost"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="5dp"
            app:layout_constraintBottom_toTopOf="@+id/btnUse"
            app:layout_constraintEnd_toEndOf="@+id/btnUse"
            app:layout_constraintTop_toTopOf="@+id/btnUse">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:text="@{``+layout.buyPrice}"
                android:textColor="@color/color_80_a64a00"
                android:textSize="9dp"
                android:textStyle="bold"
                tools:text="125" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_point_36" />

        </LinearLayout>

        <ImageView
            singleClick="@{() -> layout.dismiss()}"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:padding="16dp"
            android:src="@drawable/ic_light_dialog_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>