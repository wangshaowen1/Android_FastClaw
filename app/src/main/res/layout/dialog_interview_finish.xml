<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="332dp"
    android:layout_height="304dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/iv_dialog_bg"
        android:layout_width="296dp"
        android:layout_height="304dp"
        android:scaleType="fitXY"
        android:src="@drawable/img_interview_finish_dialog_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_dialog_title"
        android:layout_width="206dp"
        android:layout_height="27dp"
        android:layout_marginTop="19dp"
        android:scaleType="fitCenter"
        android:src="@drawable/img_interview_finish_dialog_title"
        app:layout_constraintEnd_toEndOf="@id/iv_dialog_bg"
        app:layout_constraintStart_toStartOf="@id/iv_dialog_bg"
        app:layout_constraintTop_toTopOf="@id/iv_dialog_bg" />

    <ImageView
        android:id="@+id/iv_report_preview"
        android:layout_width="254dp"
        android:layout_height="186dp"
        android:layout_marginTop="12dp"
        android:scaleType="fitXY"
        android:src="@drawable/img_interview_finish_report_preview"
        app:layout_constraintEnd_toEndOf="@id/iv_dialog_bg"
        app:layout_constraintStart_toStartOf="@id/iv_dialog_bg"
        app:layout_constraintTop_toBottomOf="@id/iv_dialog_title" />

    <LinearLayout
        android:id="@+id/layout_action"
        android:layout_width="332dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_report_preview">

        <com.shiyuan.fastclaw.widget.super_button.SuperButton
            android:id="@+id/tv_finish"
            android:layout_width="86dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="@string/interview_finish_dialog_finish_now"
            android:textColor="@color/color_ffffff"
            android:textSize="16sp"
            app:sCornersRadius="20dp"
            app:sSolidColor="@color/color_bdbdbd" />

        <com.shiyuan.fastclaw.widget.super_button.SuperButton
            android:id="@+id/sb_continue"
            android:layout_width="159dp"
            android:layout_height="40dp"
            android:layout_marginStart="18dp"
            android:gravity="center"
            android:text="@string/interview_finish_dialog_back"
            android:textColor="@color/color_ffffff"
            android:textSize="16sp"
            app:sCornersRadius="20dp"
            app:sSolidColor="@color/color_2f6bff" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
