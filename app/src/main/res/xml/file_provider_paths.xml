<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 第三方分享 SDK 的应用专属临时目录。 -->
    <external-files-path
        name="opensdk_external"
        path="Images/tmp/" />
    <external-files-path
        name="umeng_cache"
        path="umeng_cache/" />

    <!-- Matisse 拍照：Android 10+ 使用应用专属 Pictures，内部目录作为不可用时的回退。 -->
    <external-files-path
        name="matisse_capture"
        path="Pictures/album/" />
    <files-path
        name="matisse_capture_fallback"
        path="Pictures/album/" />

    <!-- Android 9 及以下 Matisse 会写公共相册；仅开放明确的非敏感拍照目录。 -->
    <external-path
        name="legacy_matisse_capture"
        path="Pictures/album/" />

    <!-- FileManager 使用外部缓存，存储不可用时回退到同名内部缓存目录。 -->
    <cache-path name="internal_common_cache" path="cache-files/" />
    <cache-path name="internal_image_cache" path="cache-images/" />
    <cache-path name="internal_media_cache" path="cache-media/" />
    <cache-path name="internal_apk_cache" path="cache-apks/" />
    <external-cache-path name="external_common_cache" path="cache-files/" />
    <external-cache-path name="external_image_cache" path="cache-images/" />
    <external-cache-path name="external_media_cache" path="cache-media/" />
    <external-cache-path name="external_apk_cache" path="cache-apks/" />
</paths>
